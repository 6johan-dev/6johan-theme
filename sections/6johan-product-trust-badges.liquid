{{ '6johan-custom.css' | asset_url | stylesheet_tag }}

<style>
  .sixj-product-trust {
    padding: 0 !important;
    margin: 0 !important;
  }
  .sixj-product-trust .sixj-trust-badges {
    padding: 4px 0 8px;
    margin: 0;
  }
  .shopify-section--6j-trust {
    padding: 0 !important;
    margin: 0 !important;
  }
  .sixj-trust-badge--instock {
    background: #F2FDF5;
    color: #6B9E6B;
  }
  .sixj-trust-badge--order {
    background: #FDF8F2;
    color: #B5935A;
  }
</style>

<div class="sixj-trust-badges">
  {%- if section.settings.show_delivery -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
    <span class="sixj-trust-badge {% if current_variant.inventory_quantity > 0 %}sixj-trust-badge--instock{% else %}sixj-trust-badge--order{% endif %}">
      {%- if current_variant.inventory_quantity > 0 -%}
        🚚 在庫あり — 7日以内に発送
      {%- elsif product.available -%}
        📋 受注生産 — お届けまで約3ヶ月
      {%- else -%}
        現在取り扱いなし
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if section.settings.show_return -%}
    <span class="sixj-trust-badge">
      ↩️ {{ section.settings.return_days }}日間返品OK
    </span>
  {%- endif -%}

  {%- if section.settings.show_assembly -%}
    {%- assign needs_assembly = product.metafields.custom.needs_assembly -%}
    <span class="sixj-trust-badge">
      {%- if needs_assembly -%}
        🔧 組立あり（{{ product.metafields.custom.assembly_time | default: '約15分' }}）
      {%- else -%}
        ✓ 完成品 — 組立不要
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if section.settings.show_warranty -%}
    <span class="sixj-trust-badge">
      🛡️ {{ section.settings.warranty_period }}
    </span>
  {%- endif -%}
</div>

<script>
  // Update badges when variant changes
  (function() {
    var el = document.querySelector('.sixj-product-trust');
    if (el) {
      var parent = el.closest('.shopify-section');
      if (parent) parent.classList.add('shopify-section--6j-trust');
    }

    // Listen for variant change
    document.addEventListener('change', function(e) {
      if (!e.target.closest('[name="id"]') && !e.target.closest('.product-form__input')) return;

      // Small delay to let Shopify update
      setTimeout(function() {
        var variantId = document.querySelector('[name="id"]');
        if (!variantId) return;

        var selected = variantId.value;
        var productJson = document.querySelector('[data-product-json]');
        if (!productJson) return;

        try {
          var product = JSON.parse(productJson.textContent);
          var variant = product.variants.find(function(v) { return v.id == selected; });
          if (!variant) return;

          var badge = document.querySelector('.sixj-trust-badges .sixj-trust-badge:first-child');
          if (!badge) return;

          if (variant.inventory_quantity > 0) {
            badge.className = 'sixj-trust-badge sixj-trust-badge--instock';
            badge.innerHTML = '🚚 在庫あり — 7日以内に発送';
          } else if (variant.available) {
            badge.className = 'sixj-trust-badge sixj-trust-badge--order';
            badge.innerHTML = '📋 受注生産 — お届けまで約3ヶ月';
          } else {
            badge.className = 'sixj-trust-badge';
            badge.innerHTML = '現在取り扱いなし';
          }
        } catch(err) {}
      }, 100);
    });
  })();
</script>

{% schema %}
{
  "name": "6JOHAN 信頼バッジ",
  "tag": "div",
  "class": "sixj-product-trust",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "配送目安を表示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_return",
      "label": "返品ポリシーを表示",
      "default": true
    },
    {
      "type": "number",
      "id": "return_days",
      "label": "返品可能日数",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_assembly",
      "label": "組立情報を表示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_warranty",
      "label": "品質保証を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "warranty_period",
      "label": "保証期間",
      "default": "1年間品質保証"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN 信頼バッジ"
    }
  ]
}
{% endschema %}
