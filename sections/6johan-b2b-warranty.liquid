{% comment %}
  6JOHAN B2B Warranty Band
  法人・商業施設向け「納品後1年間の製品保証」を固定ページ（法人のお客様へ 等）に差し込むためのセクション。
  個人のお客様の30日返品・交換とは別建てであることを明記する。
{% endcomment %}

{%- style -%}
  .j6bw { background: var(--6j-parchment, #F5F4F0); color: var(--6j-charcoal, #292724); }
  .j6bw * { box-sizing: border-box; }
  .j6bw__wrap { max-width: 1120px; margin: 0 auto; padding: 56px 20px; }
  .j6bw__h2 { margin: 0 0 12px; font-size: 24px; font-weight: 500; line-height: 1.4; text-align: center; letter-spacing: .01em; }
  .j6bw__lead { margin: 0 auto 32px; max-width: 640px; font-size: 15px; line-height: 1.9; color: var(--6j-earth, #6B6B5E); text-align: center; text-wrap: balance; }
  .j6bw__grid { display: grid; gap: 16px; }
  .j6bw__card { background: #fff; border: 1px solid var(--6j-sand, #E8E5DC); border-radius: 4px; padding: 22px 20px; }
  .j6bw__label { margin-bottom: 8px; font-size: 12px; letter-spacing: .08em; color: #6B5B4F; }
  .j6bw__text { font-size: 14px; line-height: 1.8; }
  .j6bw__note { margin: 24px auto 0; max-width: 720px; font-size: 12px; line-height: 1.8; color: var(--6j-stone, #8A8A7A); }
  .j6bw__cta { margin-top: 28px; text-align: center; }
  .j6bw__cta a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 26px; font-size: 14px; color: #292724; text-decoration: none; border: 1px solid #292724; border-radius: 999px; transition: background .2s, color .2s; }
  .j6bw__cta a:hover { background: #292724; color: #fff; }
  @media (min-width: 750px) {
    .j6bw__wrap { padding: 80px 40px; }
    .j6bw__h2 { font-size: 30px; }
    .j6bw__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
{%- endstyle -%}

<section class="j6bw" id="j6bw-{{ section.id }}">
  <div class="j6bw__wrap">
    {%- if section.settings.title != blank -%}
      <h2 class="j6bw__h2">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="j6bw__lead">{{ section.settings.lead | newline_to_br }}</p>
    {%- endif -%}
    <div class="j6bw__grid">
      {%- for i in (1..3) -%}
        {%- assign t_key = 'item' | append: i | append: '_title' -%}
        {%- assign x_key = 'item' | append: i | append: '_text' -%}
        {%- assign item_title = section.settings[t_key] -%}
        {%- assign item_text = section.settings[x_key] -%}
        {%- if item_title != blank or item_text != blank -%}
          <div class="j6bw__card">
            {%- if item_title != blank -%}<div class="j6bw__label">{{ item_title }}</div>{%- endif -%}
            {%- if item_text != blank -%}<div class="j6bw__text">{{ item_text | newline_to_br }}</div>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="j6bw__note">{{ section.settings.note | newline_to_br }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
      <div class="j6bw__cta"><a href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN 法人向け製品保証",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "納品後1年間の製品保証"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文",
      "default": "法人・商業施設様（ホテル・店舗・オフィス等）のご導入には、納品日より1年間の製品保証をお付けしています。"
    },
    {
      "type": "text",
      "id": "item1_title",
      "label": "項目1 見出し",
      "default": "保証期間"
    },
    {
      "type": "textarea",
      "id": "item1_text",
      "label": "項目1 本文",
      "default": "納品日より1年間"
    },
    {
      "type": "text",
      "id": "item2_title",
      "label": "項目2 見出し",
      "default": "保証対象"
    },
    {
      "type": "textarea",
      "id": "item2_text",
      "label": "項目2 本文",
      "default": "通常のご使用における構造上の不具合・破損（フレームや接合部のガタつき・破損など）に対する無償交換または修理"
    },
    {
      "type": "text",
      "id": "item3_title",
      "label": "項目3 見出し",
      "default": "保証対象外"
    },
    {
      "type": "textarea",
      "id": "item3_text",
      "label": "項目3 本文",
      "default": "天然素材（ラタン・無垢材）特有の節・木目・色味の違い、ささくれ、経年変化\n過度な荷重や衝撃、本来の用途以外でのご使用による破損\n屋外や水濡れ等、屋内の通常使用環境以外での劣化・破損"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "注記",
      "default": "※ 個人のお客様は、商品到着後30日以内の返品・交換（理由を問わず／不良品・誤配送は当社送料負担）で対応いたします。法人様の1年保証は、この返品・交換とは別に適用されます。"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "ボタンのテキスト",
      "default": "法人向けのご相談・お見積もりはこちら"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "ボタンのリンク先"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN 法人向け製品保証"
    }
  ]
}
{% endschema %}
