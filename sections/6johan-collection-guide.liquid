{
  "name": "6JOHAN 選び方ガイド",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "コレクションの内容に応じて、選び方・価格帯・比較表・FAQ・記事導線を自動で出力します。本文はテーマ側（sections/6johan-collection-guide.liquid）で管理しています。"
    }
  ],
  "presets": [{ "name": "6JOHAN 選び方ガイド" }]
}
{% endschema %}
