{% comment %}
  6JOHAN COORDINATE｜一緒に合わせたいおすすめ家具
  設計: work/6johan/bundle_and_campaign_plan.md §4-2（商品ページ下部）
  - 商品のカテゴリ（テーブル／ローテーブル／チェア／ソファ／収納／デスク）ごとに
    相性のよい商品を優先順に並べ、在庫ありのものだけを表示
  - 候補が取れない場合は「在庫あり鉄板アイテム」でフォールバック
  - 追加はAjax（/cart/add.js）→ カート通知／ドロワーが開く
  クラス名に sixj- / 6johan を含めないこと（[class*="sixj-"]{background:#fff!important} 回避）
{% endcomment %}

{%- liquid
  assign ptype = product.type | downcase
  assign ptags = product.tags | join: ' ' | downcase
  assign phandle = product.handle | downcase
  assign cat = 'default'

  if ptype contains 'sofa' or ptags contains 'ソファ'
    assign cat = 'sofa'
  elsif ptype contains 'chair' or ptags contains 'チェア'
    assign cat = 'chair'
  elsif ptype contains 'storage' or ptags contains '収納'
    assign cat = 'storage'
  elsif ptype contains 'table'
    if ptags contains 'ローテーブル' or ptags contains 'コーヒーテーブル' or phandle contains 'low-table'
      assign cat = 'lowtable'
    else
      assign cat = 'table'
    endif
  endif
  if ptags contains 'デスク' or ptype contains 'desk'
    assign cat = 'desk'
  endif

  case cat
    when 'table'
      assign cand = 'natural-rattan-chair,armrest-leather-chair,round-mirror,straight-leg-chair,natural-rattan-stool'
    when 'lowtable'
      assign cand = 'natural-modern-circle-side-table,the-low-table-short,block-sofa,round-mirror'
    when 'chair'
      assign cand = 'solid-wood-steel-table,the-low-table-short,iron-modern-shelf,round-mirror'
    when 'sofa'
      assign cand = 'natural-modern-circle-side-table,round-mirror,natural-rattan-bench-chair,iron-modern-shelf'
    when 'storage'
      assign cand = 'round-mirror,natural-rattan-bench-chair,the-low-table-short,iron-modern-shelf'
    when 'desk'
      assign cand = 'armrest-leather-chair,iron-modern-shelf,round-mirror'
    else
      assign cand = 'round-mirror,natural-modern-circle-side-table,iron-modern-shelf'
  endcase

  assign cand = cand | append: ',round-mirror,natural-modern-circle-side-table,iron-modern-shelf,the-low-table-short,straight-leg-chair,natural-rattan-stool'
  assign cand_arr = cand | split: ','
  assign max_show = section.settings.max_products | default: 2
-%}

{%- capture picked_handles -%}
  {%- render '6johan-set-picks', candidates: cand_arr, exclude: product.handle, limit: max_show -%}
{%- endcapture -%}
{%- assign picked_arr = picked_handles | strip | split: ',' -%}

{%- if picked_arr.size > 0 -%}
  <div class="coordset" id="coordset-{{ section.id }}">
    <div class="coordset__inner">
      <p class="coordset__head">
        <span class="coordset__label">{{ section.settings.label }}</span>
        <span class="coordset__pipe" aria-hidden="true">｜</span>
        <span class="coordset__heading">{{ section.settings.heading }}</span>
      </p>

      <div class="coordset__grid">
        {%- for h in picked_arr -%}
          {%- assign hh = h | strip -%}
          {%- if hh == blank -%}{%- continue -%}{%- endif -%}
          {%- assign p = all_products[hh] -%}
          {%- if p != blank -%}
            {%- render '6johan-set-card', product: p, style: 'wide' -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="coordset__note">
        2点以上のご購入で、商品代金の合計から5%OFFを自動で適用します。クーポンコードは不要です。組み合わせは自由です。
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "6JOHAN セットコーディネート",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "COORDINATE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "一緒に合わせたいおすすめ家具"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "表示する商品数",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "6JOHAN セットコーディネート"
    }
  ]
}
{% endschema %}
