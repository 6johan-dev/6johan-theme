{% comment %}
  6JOHAN COORDINATE｜一緒に合わせたいおすすめ家具
  設計: work/6johan/bundle_and_campaign_plan.md §4-2（商品ページ下部）
  - 現在の商品のカテゴリ（テーブル系／チェア系／その他）を商品のコレクション所属で判定し、
    「違うカテゴリ」を優先して在庫ありの商品だけを最大2点表示する
      テーブル系 → チェア・ベンチ・スツール系 → 照明・ミラー・シェルフ等（同カテゴリは出さない）
      チェア系   → テーブル・デスク系 → シェルフ・照明等（同カテゴリは出さない）
      その他     → テーブル系 → チェア系 → 別カテゴリのその他
  - 2026-11-19修正: 従来はhandleの固定リストで、wood-circle-table（タグにコーヒーテーブル）が
    lowtable扱いになりサイドテーブル→サイドテーブルと同じカテゴリが並んでいた。
    コレクション所属（collections-desks-tables / collections-chairs / …）で判定する方式に変更。
  - 追加はAjax（/cart/add.js）→ カート通知／ドロワーが開く
  クラス名に sixj- / 6johan を含めないこと（[class*="sixj-"]{background:#fff!important} 回避）
{% endcomment %}

{%- liquid
  # ---- 現在の商品のカテゴリ判定（コレクション所属 → 型/タグのフォールバック） ----
  # own_cats には「カテゴリコレクション」だけを入れる（即納・セール等の広いコレクションは
  # 同じ商品同士で必ず重なるため、同カテゴリ判定に使うと候補が消える）
  assign cat_list = ',collections-chairs,collections-desks-tables,collections-side-tables-low-tables,ソファ,collections-cabinets-sideboards,collections-shelves-bookshelves,collections-chests,collections-tv-boards,collections-mirrors,collections-lighting,collections-rugs-carpets,collections-interior-goods,'
  assign fam = ''
  assign own_cats = ''
  for c in product.collections
    assign ch = c.handle
    assign ch_test = ',' | append: ch | append: ','
    if cat_list contains ch_test
      if own_cats == blank
        assign own_cats = ch
      else
        assign own_cats = own_cats | append: ',' | append: ch
      endif
      case ch
        when 'collections-chairs'
          assign fam = 'chair'
        when 'collections-desks-tables', 'collections-side-tables-low-tables'
          unless fam == 'chair'
            assign fam = 'table'
          endunless
        when 'ソファ'
          if fam == blank
            assign fam = 'sofa'
          endif
      endcase
    endif
  endfor

  if fam == blank
    assign ptype = product.type | downcase
    assign ptags = product.tags | join: ' ' | downcase
    if ptype contains 'chair' or ptags contains 'チェア' or ptags contains 'スツール'
      assign fam = 'chair'
    elsif ptype contains 'sofa' or ptags contains 'ソファ'
      assign fam = 'sofa'
    elsif ptype contains 'table' or ptags contains 'テーブル'
      assign fam = 'table'
    else
      assign fam = 'other'
    endif
  endif

  case fam
    when 'table'
      assign families = 'chair,other'
    when 'chair'
      assign families = 'table,other'
    when 'sofa'
      assign families = 'lowtable,chair,other'
    else
      assign families = 'table,chair,other'
  endcase

  assign match_tags = product.tags | join: ','
  assign max_show = section.settings.max_products | default: 2
-%}

{%- capture picked_handles -%}
  {%- render '6johan-set-picks', families: families, own_cats: own_cats, match_tags: match_tags, exclude: product.handle, limit: max_show -%}
{%- endcapture -%}
{%- assign picked_arr = picked_handles | strip | split: ',' -%}

{%- if picked_arr.size > 0 -%}
  <div class="coordset" id="coordset-{{ section.id }}">
    <div class="coordset__inner">
      <p class="coordset__head">
        <span class="coordset__label">{{ section.settings.label }}</span>
        <span class="coordset__pipe" aria-hidden="true">｜</span>
        <span class="coordset__heading">{{ section.settings.heading }}</span>
      </p>

      <div class="coordset__grid">
        {%- for h in picked_arr -%}
          {%- assign hh = h | strip -%}
          {%- if hh == blank -%}{%- continue -%}{%- endif -%}
          {%- assign p = all_products[hh] -%}
          {%- if p != blank -%}
            {%- render '6johan-set-card', product: p, style: 'wide' -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="coordset__note">
        2点以上のご購入で、商品代金の合計から5%OFFを自動で適用します。クーポンコードは不要です。組み合わせは自由です。
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "6JOHAN セットコーディネート",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "COORDINATE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "一緒に合わせたいおすすめ家具"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "表示する商品数",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "6JOHAN セットコーディネート"
    }
  ]
}
{% endschema %}
