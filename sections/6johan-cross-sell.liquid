{% comment %}
  6JOHAN Cross-Sell Section
  「このアイテムを購入した人は、一緒にこんな商品も購入しています」
  Shopify Product Recommendations API を使用
  フォールバック: 異なるコレクションの商品を表示
{% endcomment %}

<div id="6johan-cross-sell" style="border-top: 1px solid var(--6j-sand, #E8E5E0); padding: var(--6j-space-lg, 32px) 0; display: none;">
  <div class="sixj-container">
    <p class="sixj-label">{{ section.settings.label }}</p>
    <h3 class="sixj-heading" style="font-size: 18px; margin-bottom: var(--6j-space-md, 16px);">{{ section.settings.heading }}</h3>
    <div id="6johan-cross-sell-grid" class="sixj-coordinate"></div>
  </div>
</div>

<script>
(function() {
  var productId = {{ product.id }};
  var productUrl = '{{ product.url }}';
  var section = document.getElementById('6johan-cross-sell');
  var grid = document.getElementById('6johan-cross-sell-grid');
  var maxItems = {{ section.settings.max_products }};

  if (!section || !grid) return;

  // Shopify Recommendations API
  var url = '{{ routes.product_recommendations_url }}?product_id=' + productId + '&limit=' + maxItems + '&section_id={{ section.id }}';

  fetch(url)
    .then(function(r) { return r.text(); })
    .then(function(html) {
      // APIはHTMLを返すが、JSONも使える
      // 代わりにJSON APIを使用
      return fetch('/recommendations/products.json?product_id=' + productId + '&limit=' + maxItems);
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var products = data.products || [];
      if (products.length === 0) { renderFallback(); return; }

      section.style.display = '';

      var html = '';
      var count = 0;
      for (var i = 0; i < products.length && count < maxItems; i++) {
        var p = products[i];
        if (p.url === productUrl) continue;
        var img = p.featured_image || p.images[0];
        var price = '¥' + Math.floor(p.price / 100).toLocaleString();

        html += '<a href="' + p.url + '" style="text-decoration: none;">' +
          '<div style="aspect-ratio: 1; overflow: hidden; border-radius: 4px; background: #FAF9F7; margin-bottom: 6px;">' +
            '<img src="' + img + '&width=400" alt="' + p.title + '" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">' +
          '</div>' +
          '<div style="font-size: 12px; font-weight: 500; color: #292724; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">' + p.title + '</div>' +
          '<div style="font-size: 12px; font-weight: 500; color: #292724; margin-top: 2px;">' + price + '</div>' +
        '</a>';
        count++;
      }

      if (count > 0) grid.innerHTML = html;
      else section.style.display = 'none';
    })
    .catch(function() {
      renderFallback();
    });

  // フォールバック: Liquid側で用意した別コレクション商品を表示
  function renderFallback() {
    var fallbackGrid = document.getElementById('6johan-cross-sell-fallback');
    if (fallbackGrid && fallbackGrid.children.length > 0) {
      section.style.display = '';
      grid.innerHTML = fallbackGrid.innerHTML;
    }
  }
})();
</script>

<div id="6johan-cross-sell-fallback" style="display:none;">
  {%- assign current_collections = product.collections -%}
  {%- assign current_type = product.type -%}
  {%- assign shown = 0 -%}
  {%- for c in collections -%}
    {%- if c.handle != 'pick-up' and c.handle != 'new-arrival' and c.handle != '即納商品' and c.handle != '5万円以下' and c.all_products_count > 0 -%}
      {%- assign in_current = false -%}
      {%- for pc in current_collections -%}
        {%- if pc.handle == c.handle -%}
          {%- assign in_current = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless in_current -%}
        {%- for p in c.products limit: 2 -%}
          {%- if p.id != product.id and shown < section.settings.max_products -%}
            <a href="{{ p.url }}" style="text-decoration: none;">
              <div style="aspect-ratio: 1; overflow: hidden; border-radius: 4px; background: #FAF9F7; margin-bottom: 6px;">
                <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
              </div>
              <div style="font-size: 12px; font-weight: 500; color: #292724; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ p.title }}</div>
              <div style="font-size: 12px; font-weight: 500; color: #292724; margin-top: 2px;">{{ p.price | money }}</div>
            </a>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endif -%}
    {%- if shown >= section.settings.max_products -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "6JOHAN クロスセル",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "CROSS SELL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "このアイテムを購入した人は、一緒にこんな商品も購入しています"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "表示する商品数",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "6JOHAN クロスセル"
    }
  ]
}
{% endschema %}
