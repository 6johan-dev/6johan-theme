<script>
  (function () {
    function ready(fn) {
      if (document.readyState !== 'loading') fn();
      else document.addEventListener('DOMContentLoaded', fn);
    }
    ready(function () {
      var S = window.SixjShipping;
      var table = document.getElementById('j6g-shipping-table');
      if (!S || !table) return;

      var tbody = table.querySelector('tbody');
      var areas = ['hokkaido', 'tohoku', 'kanto', 'chubu', 'kansai', 'chushikoku', 'kyushu'];
      var sizes = Object.keys(S.TABLE).map(Number).sort(function (a, b) { return a - b; });

      sizes.forEach(function (size) {
        var row = document.createElement('tr');
        var th = document.createElement('th');
        th.scope = 'row';
        th.textContent = size + 'サイズ';
        row.appendChild(th);
        var rowData = S.TABLE[size];
        areas.forEach(function (area) {
          var td = document.createElement('td');
          td.className = 'j6g-table__num';
          td.setAttribute('data-area', area);
          if (rowData.flat != null) {
            td.textContent = S.yen(rowData.flat);
          } else if (rowData[area] != null) {
            td.textContent = S.yen(rowData[area]);
          } else {
            td.textContent = '—';
          }
          row.appendChild(td);
        });
        tbody.appendChild(row);
      });

      // 都道府県セレクト
      var select = document.getElementById('j6g-pref-select');
      var summary = document.getElementById('j6g-pref-summary');
      var prefs = ['東京都'].concat(Object.keys(S.PREF_AREA).filter(function (p) { return p !== '東京都'; }));
      prefs.push('沖縄県');

      prefs.forEach(function (pref) {
        var opt = document.createElement('option');
        opt.value = pref;
        opt.textContent = pref;
        select.appendChild(opt);
      });

      var saved = S.readPref();
      if (saved) select.value = saved;

      function highlight() {
        var pref = select.value;
        var area = S.PREF_AREA[pref];
        table.querySelectorAll('th[data-area], td[data-area]').forEach(function (cell) {
          var on = area && cell.getAttribute('data-area') === area;
          cell.classList.toggle('is-active', !!on);
        });
        if (!area) {
          summary.textContent = pref + 'は個別にご案内します（チャットへ）';
          return;
        }
        var sample = [120, 160, 240].map(function (size) {
          var fee = S.lookupFee(size, pref);
          return size + 'サイズ ' + (fee ? S.yen(fee.fee) : '—');
        });
        summary.textContent = pref + 'なら：' + sample.join(' / ');
      }

      select.addEventListener('change', function () {
        S.writePref(select.value);
        highlight();
      });
      highlight();
    });
  })();
</script>

