{% comment %}
  6JOHAN First Visit Guide Section
  Welcome + Style Navigation + Starter Set + Trust + CTA
{% endcomment %}

{{ '6johan-custom.css' | asset_url | stylesheet_tag }}

{%- comment -%} Hero {%- endcomment -%}
<div class="sixj-section sixj-section--bordered sixj-text-center" style="padding: var(--6j-space-3xl) var(--6j-space-lg);">
  <p class="sixj-label">{{ section.settings.hero_label }}</p>
  <h1 class="sixj-heading" style="font-size: clamp(22px, 4vw, 32px); margin-bottom: var(--6j-space-md);">
    {{ section.settings.hero_heading }}
  </h1>
  <p class="sixj-text-earth" style="font-size: 14px; line-height: 1.8;">
    {{ section.settings.hero_text }}
  </p>
</div>

{%- comment -%} Style Navigation {%- endcomment -%}
<div class="sixj-section sixj-section--bordered">
  <div class="sixj-container" style="max-width: 640px;">
    <p class="sixj-label sixj-mb-lg">{{ section.settings.nav_label }}</p>
    <div style="display: flex; flex-direction: column; gap: var(--6j-space-sm);">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_card' -%}
          <a href="{{ block.settings.url }}" class="sixj-style-card" {{ block.shopify_attributes }}>
            <span class="sixj-style-card__icon">{{ block.settings.icon }}</span>
            <div class="sixj-style-card__content">
              <div class="sixj-style-card__title">{{ block.settings.title }}</div>
              <div class="sixj-style-card__sub">{{ block.settings.subtitle }}</div>
            </div>
            <span class="sixj-style-card__arrow">→</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Starter Set {%- endcomment -%}
{%- if section.settings.show_starter_set -%}
<div class="sixj-section sixj-section--bordered sixj-section--muted">
  <div class="sixj-container" style="max-width: 640px;">
    <p class="sixj-label">{{ section.settings.set_label }}</p>
    <h3 class="sixj-heading sixj-mb-sm" style="font-size: 20px;">{{ section.settings.set_heading }}</h3>
    <p class="sixj-text-earth sixj-mb-md" style="font-size: 13px;">{{ section.settings.set_description }}</p>

    {%- if section.settings.set_image != blank -%}
      <img
        src="{{ section.settings.set_image | img_url: '800x' }}"
        alt="{{ section.settings.set_heading }}"
        style="width: 100%; border-radius: var(--6j-radius-md); margin-bottom: var(--6j-space-md); object-fit: cover; max-height: 240px;"
        loading="lazy"
      >
    {%- endif -%}

    <div class="sixj-price-group sixj-mb-md">
      <span class="sixj-price--current">{{ section.settings.set_price }}</span>
      {%- if section.settings.set_original_price != blank -%}
        <span class="sixj-price--original">{{ section.settings.set_original_price }}</span>
      {%- endif -%}
      {%- if section.settings.set_discount != blank -%}
        <span class="sixj-price--badge">{{ section.settings.set_discount }}</span>
      {%- endif -%}
    </div>

    <a href="{{ section.settings.set_url }}" class="sixj-btn sixj-btn--accent sixj-btn--full">
      {{ section.settings.set_cta }}
    </a>
  </div>
</div>
{%- endif -%}

{%- comment -%} Trust Bar {%- endcomment -%}
<div class="sixj-section sixj-section--bordered">
  <div class="sixj-container">
    <div class="sixj-trust-bar" style="border-top: none; padding-top: 0;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="sixj-trust-bar__item" {{ block.shopify_attributes }}>
            <span class="sixj-trust-bar__icon">{{ block.settings.icon }}</span>
            <span class="sixj-trust-bar__text">{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} CTA {%- endcomment -%}
<div class="sixj-section sixj-text-center">
  <a href="{{ section.settings.cta_url }}" class="sixj-btn sixj-btn--primary">
    {{ section.settings.cta_text }}
  </a>
</div>

{% schema %}
{
  "name": "6JOHAN はじめての方",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "ヒーロー"
    },
    {
      "type": "text",
      "id": "hero_label",
      "label": "ラベル",
      "default": "ABOUT 6JOHAN"
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "見出し",
      "default": "暮らしに馴染む、\n北欧×和の家具。"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "本文",
      "default": "シンプルで上質な家具を、あなたの暮らしに。"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "ナビラベル",
      "default": "商品の探し方"
    },
    {
      "type": "header",
      "content": "スターターセット"
    },
    {
      "type": "checkbox",
      "id": "show_starter_set",
      "label": "スターターセットを表示",
      "default": false
    },
    {
      "type": "text",
      "id": "set_label",
      "label": "セットラベル",
      "default": "RECOMMEND SET"
    },
    {
      "type": "text",
      "id": "set_heading",
      "label": "セット名",
      "default": "リビングダイニングセット"
    },
    {
      "type": "text",
      "id": "set_description",
      "label": "セット説明",
      "default": "テーブル + チェア + 収納の3点セット"
    },
    {
      "type": "image_picker",
      "id": "set_image",
      "label": "セット画像"
    },
    {
      "type": "text",
      "id": "set_price",
      "label": "セット価格",
      "default": "¥72,000"
    },
    {
      "type": "text",
      "id": "set_original_price",
      "label": "元の価格（任意）",
      "default": "¥80,000"
    },
    {
      "type": "text",
      "id": "set_discount",
      "label": "割引バッジ（任意）",
      "default": "10% OFF"
    },
    {
      "type": "url",
      "id": "set_url",
      "label": "セットリンク先"
    },
    {
      "type": "text",
      "id": "set_cta",
      "label": "セットCTAテキスト",
      "default": "セットを見る →"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "ボタンテキスト",
      "default": "すべての商品を見る →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "ボタンリンク先"
    }
  ],
  "blocks": [
    {
      "type": "nav_card",
      "name": "選び方カード",
      "settings": [
        { "type": "text", "id": "icon", "label": "アイコン", "default": "🪑" },
        { "type": "text", "id": "title", "label": "タイトル", "default": "アイテムで探す" },
        { "type": "text", "id": "subtitle", "label": "サブタイトル", "default": "チェア / テーブル / 収納" },
        { "type": "url", "id": "url", "label": "リンク先" }
      ]
    },
    {
      "type": "trust_item",
      "name": "信頼項目",
      "settings": [
        { "type": "text", "id": "icon", "label": "アイコン", "default": "🚚" },
        { "type": "text", "id": "text", "label": "テキスト", "default": "在庫品は7日以内に発送" }
      ]
    }
  ],
  "presets": [
    {
      "name": "6JOHAN はじめての方",
      "blocks": [
        { "type": "nav_card", "settings": { "icon": "🪑", "title": "アイテムで探す", "subtitle": "チェア / テーブル / 収納" } },
        { "type": "nav_card", "settings": { "icon": "💰", "title": "予算で探す", "subtitle": "〜5万 / 〜10万 / 10万円〜" } },
        { "type": "nav_card", "settings": { "icon": "🏠", "title": "用途で探す", "subtitle": "リビング / ワークスペース / ダイニング" } },
        { "type": "trust_item", "settings": { "icon": "🚚", "text": "在庫品は7日以内に発送" } },
        { "type": "trust_item", "settings": { "icon": "↩️", "text": "30日間返品OK" } },
        { "type": "trust_item", "settings": { "icon": "🛡️", "text": "1年間品質保証" } },
        { "type": "trust_item", "settings": { "icon": "💬", "text": "チャットで相談" } }
      ]
    }
  ]
}
{% endschema %}
