{%- comment -%}
  6JOHAN 商品ページ内「選び方・比較ガイド」枠（案Bトーン）
  配置: templates/product.json の 6johan_product_story の直後

  表示条件（どちらかに入っていれば表示・どちらも無ければセクションごと非表示）
   A) 商品メタフィールド custom.guide_articles（記事参照・リスト）  … 明示的に固定したいとき
   B) 記事メタフィールド custom.guide_products（商品参照・リスト）  … 記事側から指定（量産向き）
      → ブログ（既定: 6johan-magazine）の公開記事のうち、この商品を含む記事を新しい順に最大 max_cards 枚

  記事→商品リンクには UTM（utm_source=product / utm_medium=guide / utm_campaign=記事ハンドル / utm_content=商品ハンドル）と
  GA4 用 data-ga-event="product_to_article" を付与。
  任意: 商品メタフィールド custom.guide_note（単一行/複数行テキスト）で注記文を差し替え
{%- endcomment -%}

{%- liquid
  assign blog_handle = section.settings.blog_handle | default: '6johan-magazine'
  assign mag = blogs[blog_handle]
  assign max_cards = section.settings.max_cards | default: 2
  assign pinned = product.metafields.custom.guide_articles.value
  assign note = product.metafields.custom.guide_note.value
  assign all_url = section.settings.all_url | default: '/blogs/6johan-magazine'
  assign shown = ''
  assign count = 0
-%}

{%- capture cards -%}
  {%- if pinned != blank -%}
    {%- for a in pinned -%}
      {%- if count < max_cards and a.handle != blank and a.title != blank -%}
        {%- assign dup = '|' | append: shown | append: '|' -%}
        {%- assign key = '|' | append: a.handle | append: '|' -%}
        {%- unless dup contains key -%}
          {%- if count == 0 -%}
            {%- render '6johan-guide-card', a: a, lead: true -%}
          {%- else -%}
            {%- render '6johan-guide-card', a: a, lead: false -%}
          {%- endif -%}
          {%- assign shown = shown | append: a.handle | append: '|' -%}
          {%- assign count = count | plus: 1 -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if mag != blank and count < max_cards -%}
    {%- for a in mag.articles limit: 50 -%}
      {%- if count < max_cards -%}
        {%- assign dup = '|' | append: shown | append: '|' -%}
        {%- assign key = '|' | append: a.handle | append: '|' -%}
        {%- unless dup contains key -%}
          {%- assign cov = a.metafields.custom.guide_products.value -%}
          {%- assign hit = false -%}
          {%- if cov != blank -%}
            {%- for p in cov -%}
              {%- if p.handle == product.handle -%}
                {%- assign hit = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if hit -%}
            {%- if count == 0 -%}
              {%- render '6johan-guide-card', a: a, lead: true -%}
            {%- else -%}
              {%- render '6johan-guide-card', a: a, lead: false -%}
            {%- endif -%}
            {%- assign shown = shown | append: a.handle | append: '|' -%}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<!--JGUIDE-LIVE-->
{%- if cards contains 'jguide-card__title' -%}
<section class="jguide" id="ProductGuide-{{ section.id }}">
  <div class="jguide__inner">
    <div class="jguide__head">
      <div class="jguide__headl">
        <span class="jguide__label">{{ section.settings.label | default: 'GUIDES & COMPARISON' }}</span>
        <span class="jguide__sep"></span>
        <h2 class="jguide__title">{{ section.settings.heading | default: 'この商品の選び方・比較記事' }}</h2>
      </div>
      <a class="jguide__all" href="{{ all_url }}" data-ga-event="guide_list_click">{{ section.settings.all_text | default: 'ガイド一覧を見る' }}</a>
    </div>

    <ul class="jguide__list">{{ cards }}</ul>

    <p class="jguide__note">{{ note | default: section.settings.note | default: '記事内の在庫・納期は更新時点の情報です。最新の納期は各商品ページでご確認ください。' }}記事は <a href="{{ all_url }}">{{ section.settings.blog_name | default: '6JOHAN MAGAZINE' }}</a> で公開しています。</p>
  </div>
</section>

<style>
  .jguide{
    --jg-ink:#292724; --jg-ink2:#4A4742; --jg-sub:#807C76; --jg-sub2:#9A958E;
    --jg-accent:#6B5B4F; --jg-sand:#C4956A;
    --jg-border:#E8E5E0; --jg-border-d:#D5D0C8; --jg-bgsub:#FAF9F7;
    border-top:1px solid #E8E5E0;
    background:#fff;
    padding:56px 0 60px;
    color:var(--jg-ink);
    -webkit-font-smoothing:antialiased;
  }
  .jguide *,.jguide *::before,.jguide *::after{box-sizing:border-box}
  .jguide__inner{max-width:1080px;margin:0 auto;padding:0 24px}

  .jguide__head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding-bottom:14px;border-bottom:1px solid var(--jg-ink)}
  .jguide__headl{display:flex;align-items:center;gap:12px;flex-wrap:wrap;min-width:0}
  .jguide__label{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--jg-accent);white-space:nowrap}
  .jguide__sep{width:1px;height:12px;background:var(--jg-border-d);display:inline-block}
  .jguide__title{font-size:19px;line-height:1.5;font-weight:700;letter-spacing:.02em;margin:0;color:var(--jg-ink)}
  .jguide__all{font-size:11px;letter-spacing:.06em;color:var(--jg-sub);text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;padding-bottom:2px}
  .jguide__all::after{content:"→";color:var(--jg-accent);font-size:12px}
  .jguide__all:hover{color:var(--jg-ink)}

  .jguide__list{margin:20px 0 0;padding:0;list-style:none;display:grid;gap:12px}
  .jguide-card{display:grid;grid-template-columns:232px 1fr auto;align-items:center;border:1px solid var(--jg-border);background:#fff;text-decoration:none;color:inherit;transition:border-color .18s ease,box-shadow .18s ease}
  .jguide-card:hover{border-color:var(--jg-border-d);box-shadow:0 2px 10px rgba(41,39,36,.05)}
  .jguide-card--lead{border-color:var(--jg-border-d);background:linear-gradient(#fff,#FDFBF7)}

  .jguide-card__thumb{position:relative;display:block;height:164px;overflow:hidden;background:var(--jg-bgsub);border-right:1px solid var(--jg-border)}
  .jguide-card__thumb img{width:100%;height:164px;object-fit:cover;display:block}
  .jguide-card__flag{position:absolute;left:0;top:12px;background:var(--jg-sand);color:#fff;font-size:9px;letter-spacing:.12em;font-weight:600;padding:4px 8px}

  .jguide-card__body{padding:18px 26px;min-width:0;display:block}
  .jguide-card__kicker{display:flex;align-items:center;gap:8px;margin-bottom:8px}
  .jguide-card__kicker span{font-size:9.5px;letter-spacing:.1em;color:var(--jg-sub)}
  .jguide-card__kicker .tag{color:var(--jg-accent);border:1px solid var(--jg-border-d);padding:2px 6px;font-weight:600;letter-spacing:.12em}
  .jguide-card__title{font-size:16px;line-height:1.6;font-weight:700;letter-spacing:.01em;margin:0;color:var(--jg-ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .jguide-card__sum{font-size:12px;line-height:1.75;color:var(--jg-sub);margin:8px 0 0;letter-spacing:.02em;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
  .jguide-card__meta{margin-top:9px;font-size:10px;letter-spacing:.06em;color:var(--jg-sub2);display:flex;gap:10px;align-items:center;font-variant-numeric:tabular-nums}

  .jguide-card__cta{margin-right:24px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:11.5px;font-weight:600;letter-spacing:.06em;white-space:nowrap;padding:11px 18px;background:#fff;color:var(--jg-accent);border:1px solid var(--jg-accent);transition:background .18s ease,color .18s ease}
  .jguide-card__cta i{font-style:normal;font-size:12px;line-height:1}
  .jguide-card--lead .jguide-card__cta{background:var(--jg-accent);border-color:var(--jg-accent);color:#fff}
  .jguide-card:hover .jguide-card__cta{background:var(--jg-accent);border-color:var(--jg-accent);color:#fff}

  .jguide__note{margin:14px 0 0;font-size:10.5px;line-height:1.7;color:var(--jg-sub2);letter-spacing:.03em}
  .jguide__note a{color:var(--jg-sub);text-decoration:underline;text-underline-offset:2px}

  @media screen and (min-width:750px) and (max-width:989px){
    .jguide__inner{padding:0 20px}
    .jguide__title{font-size:17px}
    .jguide-card{grid-template-columns:190px 1fr auto}
    .jguide-card__thumb,.jguide-card__thumb img{height:148px}
    .jguide-card__body{padding:15px 18px}
    .jguide-card__title{font-size:14.5px;line-height:1.55}
    .jguide-card__sum{font-size:11.5px;margin-top:6px}
    .jguide-card__meta{margin-top:7px}
    .jguide-card__cta{margin-right:16px;padding:9px 12px;font-size:10.5px;gap:6px}
  }

  @media screen and (max-width:749px){
    .jguide{padding:36px 0 40px}
    .jguide__inner{padding:0 16px}
    .jguide__head{display:grid;grid-template-columns:1fr;gap:8px;align-items:start;padding-bottom:12px}
    .jguide__headl{display:block}
    .jguide__sep{display:none}
    .jguide__label{display:block;font-size:10px;letter-spacing:.16em;margin-bottom:8px}
    .jguide__title{font-size:16px;line-height:1.5;width:100%}
    .jguide__all{font-size:10.5px;justify-self:start}
    .jguide__list{margin-top:14px;gap:10px}
    .jguide-card{grid-template-columns:1fr;align-items:stretch}
    .jguide-card__thumb,.jguide-card__thumb img{height:168px;min-height:0}
    .jguide-card__thumb{border-right:0;border-bottom:1px solid var(--jg-border)}
    .jguide-card__flag{top:0;font-size:8.5px;padding:3px 7px}
    .jguide-card__body{padding:14px 14px 0}
    .jguide-card__kicker{margin-bottom:6px}
    .jguide-card__title{font-size:14px;line-height:1.55}
    .jguide-card__sum{font-size:11.5px;margin-top:6px}
    .jguide-card__meta{margin-top:8px;font-size:9.5px}
    .jguide-card__cta{margin:14px;padding:12px 14px;width:calc(100% - 28px);font-size:11.5px}
    .jguide__note{margin-top:12px;font-size:10px}
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "選び方ガイド（記事）",
  "settings": [
    { "type": "text", "id": "label", "label": "ラベル", "default": "GUIDES & COMPARISON" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "この商品の選び方・比較記事" },
    { "type": "text", "id": "all_text", "label": "一覧リンクの文言", "default": "ガイド一覧を見る" },
    { "type": "url", "id": "all_url", "label": "一覧リンク先" },
    { "type": "text", "id": "blog_handle", "label": "ブログのハンドル", "default": "6johan-magazine" },
    { "type": "text", "id": "blog_name", "label": "ブログ名（注記内）", "default": "6JOHAN MAGAZINE" },
    { "type": "range", "id": "max_cards", "label": "最大表示数", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "textarea", "id": "note", "label": "注記（空欄で既定文）" }
  ],
  "presets": [{ "name": "選び方ガイド（記事）" }],
  "templates": ["product"]
}
{% endschema %}
