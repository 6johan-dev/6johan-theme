{{ '6johan-custom.css' | asset_url | stylesheet_tag }}

<div class="sixj-trust-bar">
  <div class="sixj-trust-bar__item">
    <span class="sixj-trust-bar__icon">🚚</span>
    <span class="sixj-trust-bar__text">{{ section.settings.item1_text }}</span>
  </div>
  <div class="sixj-trust-bar__item">
    <span class="sixj-trust-bar__icon">↩️</span>
    <span class="sixj-trust-bar__text">{{ section.settings.item2_text }}</span>
  </div>
  <div class="sixj-trust-bar__item">
    <span class="sixj-trust-bar__icon">💬</span>
    <span class="sixj-trust-bar__text">{{ section.settings.item3_text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "6JOHAN 信頼バー",
  "settings": [
    {
      "type": "text",
      "id": "item1_text",
      "label": "項目1テキスト",
      "default": "最短3日配送"
    },
    {
      "type": "text",
      "id": "item2_text",
      "label": "項目2テキスト",
      "default": "30日返品OK"
    },
    {
      "type": "text",
      "id": "item3_text",
      "label": "項目3テキスト",
      "default": "チャット相談"
    }
  ]
}
{% endschema %}
