{% comment %}
  6JOHAN Hero Section
  Full-width lifestyle image with brand copy overlay.
  For the top page.
{% endcomment %}

{{ '6johan-custom.css' | asset_url | stylesheet_tag }}

<style>
  .sixj-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .sixj-hero__image-wrap {
    position: relative;
    width: 100%;
    min-height: 480px;
    max-height: 680px;
  }
  .sixj-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
  .sixj-hero__placeholder {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(135deg, #E8E0D6 0%, #D4CFC6 50%, #C8C0B6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--6j-stone);
    font-size: 14px;
  }
  .sixj-hero__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 24px 40px;
    background: linear-gradient(to top, rgba(44, 44, 36, 0.6) 0%, transparent 100%);
    color: white;
  }
  .sixj-hero__label {
    font-family: var(--6j-font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 8px;
  }
  .sixj-hero__heading {
    font-family: var(--6j-font-heading);
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 400;
    line-height: 1.3;
    margin-bottom: 16px;
    color: white;
  }
  .sixj-hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    border-radius: 999px;
    background: white;
    color: var(--6j-charcoal);
    font-family: var(--6j-font-body);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .sixj-hero__cta:hover {
    opacity: 0.9;
  }
  @media (max-width: 749px) {
    .sixj-hero__image-wrap {
      min-height: 360px;
      max-height: 480px;
    }
    .sixj-hero__overlay {
      padding: 32px 20px;
    }
  }
</style>

<div class="sixj-hero">
  <div class="sixj-hero__image-wrap">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | img_url: '1600x' }}"
        alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="sixj-hero__placeholder">📷 ライフスタイル写真を設定してください</div>
    {%- endif -%}
    <div class="sixj-hero__overlay">
      {%- if section.settings.label != blank -%}
        <div class="sixj-hero__label">{{ section.settings.label }}</div>
      {%- endif -%}
      <h2 class="sixj-hero__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url }}" class="sixj-hero__cta">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "6JOHAN ヒーロー",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "ヒーロー画像",
      "info": "推奨: 1600×800px以上のライフスタイル写真"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "画像の代替テキスト",
      "default": "6JOHANの家具がある暮らし"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル（小さい文字）",
      "default": "New Collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "見出し",
      "default": "六畳半から始まる、自分らしい暮らし。"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "ボタンテキスト",
      "default": "コレクションを見る →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "ボタンリンク先"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN ヒーロー"
    }
  ]
}
{% endschema %}
