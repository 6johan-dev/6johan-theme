{% comment %}
  6JOHAN Hero Section
  PC/SP別画像対応版
  PC: 1920×800px / SP: 750×1000px 推奨
{% endcomment %}

{{ '6johan-custom.css' | asset_url | stylesheet_tag }}

<style>
  .sixj-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  
  .sixj-hero__image-wrap {
    position: relative;
    width: 100%;
  }
  
  /* PC: 2.4:1 アスペクト比 */
  .sixj-hero__image-wrap--pc {
    aspect-ratio: 2.4 / 1;
    min-height: 400px;
    max-height: 800px;
  }
  
  /* SP: 3:4 アスペクト比 */
  .sixj-hero__image-wrap--sp {
    aspect-ratio: 3 / 4;
    min-height: 400px;
    max-height: 600px;
  }
  
  .sixj-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
  
  .sixj-hero__placeholder {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(135deg, #E8E0D6 0%, #D4CFC6 50%, #C8C0B6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--6j-text-sub, #807C76);
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }
  
  .sixj-hero__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 24px 40px;
    background: linear-gradient(to top, rgba(44, 44, 36, 0.7) 0%, rgba(44, 44, 36, 0.3) 50%, transparent 100%);
    color: white;
  }
  
  .sixj-hero__content {
    max-width: 600px;
  }
  
  .sixj-hero__label {
    font-family: var(--6j-font-body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 10px;
  }
  
  .sixj-hero__heading {
    font-family: var(--6j-font-heading, serif);
    font-size: clamp(26px, 5vw, 42px);
    font-weight: 400;
    line-height: 1.35;
    margin-bottom: 20px;
    color: white;
  }
  
  .sixj-hero__subheading {
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: 20px;
  }
  
  .sixj-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 999px;
    background: white;
    color: var(--6j-text, #292724);
    font-family: var(--6j-font-body, sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  
  .sixj-hero__cta:hover {
    background: var(--6j-text, #292724);
    color: white;
    transform: translateY(-2px);
  }
  
  /* PC/SP 切り替え */
  .sixj-hero__pc {
    display: block;
  }
  
  .sixj-hero__sp {
    display: none;
  }
  
  @media (max-width: 749px) {
    .sixj-hero__pc {
      display: none;
    }
    
    .sixj-hero__sp {
      display: block;
    }
    
    .sixj-hero__overlay {
      padding: 32px 20px;
    }
    
    .sixj-hero__label {
      font-size: 10px;
    }
    
    .sixj-hero__subheading {
      font-size: 13px;
    }
    
    .sixj-hero__cta {
      padding: 12px 24px;
      font-size: 13px;
    }
  }
</style>

<div class="sixj-hero">
  {%- comment -%} PC版 {%- endcomment -%}
  <div class="sixj-hero__pc">
    <div class="sixj-hero__image-wrap sixj-hero__image-wrap--pc">
      {%- if section.settings.image_pc != blank -%}
        <img
          src="{{ section.settings.image_pc | image_url: width: 1920 }}"
          srcset="{{ section.settings.image_pc | image_url: width: 1200 }} 1200w,
                  {{ section.settings.image_pc | image_url: width: 1600 }} 1600w,
                  {{ section.settings.image_pc | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image != blank -%}
        {%- comment -%} フォールバック: 旧設定の画像 {%- endcomment -%}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="sixj-hero__placeholder">📷 PC用画像を設定してください<br>(推奨: 1920×800px)</div>
      {%- endif -%}
    </div>
  </div>
  
  {%- comment -%} SP版 {%- endcomment -%}
  <div class="sixj-hero__sp">
    <div class="sixj-hero__image-wrap sixj-hero__image-wrap--sp">
      {%- if section.settings.image_sp != blank -%}
        <img
          src="{{ section.settings.image_sp | image_url: width: 750 }}"
          srcset="{{ section.settings.image_sp | image_url: width: 375 }} 375w,
                  {{ section.settings.image_sp | image_url: width: 750 }} 750w"
          sizes="100vw"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_pc != blank -%}
        {%- comment -%} フォールバック: PC画像を使用 {%- endcomment -%}
        <img
          src="{{ section.settings.image_pc | image_url: width: 750 }}"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 750 }}"
          alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="sixj-hero__placeholder">📷 SP用画像を設定してください<br>(推奨: 750×1000px)</div>
      {%- endif -%}
    </div>
  </div>
  
  {%- comment -%} オーバーレイ（共通） {%- endcomment -%}
  {%- if section.settings.show_overlay -%}
  <div class="sixj-hero__overlay">
    <div class="sixj-hero__content">
      {%- if section.settings.label != blank -%}
        <div class="sixj-hero__label">{{ section.settings.label }}</div>
      {%- endif -%}
      <h2 class="sixj-hero__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="sixj-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url }}" class="sixj-hero__cta">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "6JOHAN ヒーロー",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "PC用画像"
    },
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "PC用ヒーロー画像",
      "info": "推奨: 1920×800px（横長）"
    },
    {
      "type": "header",
      "content": "スマートフォン用画像"
    },
    {
      "type": "image_picker",
      "id": "image_sp",
      "label": "SP用ヒーロー画像",
      "info": "推奨: 750×1000px（縦長）"
    },
    {
      "type": "header",
      "content": "テキスト設定"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "テキストオーバーレイを表示",
      "default": true,
      "info": "オフにすると画像のみ表示されます"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "画像の代替テキスト",
      "default": "6JOHANの家具がある暮らし"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル（小さい文字）",
      "default": "Nordic × Japanese"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "見出し",
      "default": "暮らしに馴染む、上質な家具を。"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "サブ見出し（任意）",
      "info": "見出しの下に小さく表示されます"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "ボタンテキスト",
      "default": "コレクションを見る →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "ボタンリンク先"
    },
    {
      "type": "header",
      "content": "旧設定（後方互換）"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "ヒーロー画像（旧）",
      "info": "PC/SP別画像が未設定の場合に使用されます"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN ヒーロー"
    }
  ]
}
{% endschema %}
