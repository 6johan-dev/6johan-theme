{% comment %}
  6JOHAN Pickup Banners
  ピックアップ特集バナー（LOWYA風2列グリッド）
{% endcomment %}

{%- style -%}
.pickup-banners {
  padding: 48px 0;
  background: #fff;
}
.pickup-banners__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}
.pickup-banners__header {
  margin-bottom: 24px;
}
.pickup-banners__label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #8A7A6A;
  margin-bottom: 6px;
}
.pickup-banners__title {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  font-weight: 500;
  color: #292724;
  margin: 0;
}
.pickup-banners__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.pickup-banners__item {
  text-decoration: none;
  color: inherit;
  display: block;
}
.pickup-banners__image-wrap {
  position: relative;
  aspect-ratio: 4 / 3;
  border-radius: 8px;
  overflow: hidden;
  background: #FAF9F7;
  margin-bottom: 10px;
}
.pickup-banners__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}
.pickup-banners__item:hover .pickup-banners__image {
  transform: scale(1.03);
}
.pickup-banners__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A8A7A;
  font-size: 12px;
}
.pickup-banners__item-title {
  font-size: 13px;
  font-weight: 500;
  color: #292724;
  line-height: 1.5;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pickup-banners__view-all {
  text-align: center;
  margin-top: 28px;
}
.pickup-banners__view-all-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 40px;
  border: 1px solid #292724;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  color: #292724;
  text-decoration: none;
  transition: all 0.2s;
  width: 100%;
  max-width: 400px;
}
.pickup-banners__view-all-link:hover {
  background: #292724;
  color: #fff;
}
@media (min-width: 750px) {
  .pickup-banners__grid { gap: 20px; }
  .pickup-banners__item-title { font-size: 14px; }
}
@media (min-width: 990px) {
  .pickup-banners { padding: 60px 0; }
  .pickup-banners__container { padding: 0 40px; }
  .pickup-banners__grid { gap: 24px; }
}
@media (max-width: 749px) {
  .pickup-banners { padding: 40px 0; }
  .pickup-banners__title { font-size: 20px; }
  .pickup-banners__view-all-link { padding: 12px; font-size: 13px; }
}
{%- endstyle -%}

<section class="pickup-banners">
  <div class="pickup-banners__container">
    {% if section.settings.label != blank or section.settings.heading != blank %}
      <header class="pickup-banners__header">
        {% if section.settings.label != blank %}
          <span class="pickup-banners__label">{{ section.settings.label }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="pickup-banners__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="pickup-banners__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url }}" class="pickup-banners__item" {{ block.shopify_attributes }}>
          <div class="pickup-banners__image-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 749px) 45vw, 30vw"
                alt="{{ block.settings.title | escape }}"
                class="pickup-banners__image"
                loading="lazy"
              >
            {%- else -%}
              <div class="pickup-banners__placeholder">バナー画像を設定</div>
            {%- endif -%}
          </div>
          {% if block.settings.title != blank %}
            <p class="pickup-banners__item-title">{{ block.settings.title }}</p>
          {% endif %}
        </a>
      {%- endfor -%}
    </div>

    {% if section.settings.show_view_all and section.settings.view_all_url != blank %}
      <div class="pickup-banners__view-all">
        <a href="{{ section.settings.view_all_url }}" class="pickup-banners__view-all-link">
          {{ section.settings.view_all_text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN ピックアップ特集",
  "tag": "section",
  "class": "section-pickup-banners",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "ラベル", "default": "FEATURE" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "ピックアップ特集" },
    { "type": "checkbox", "id": "show_view_all", "label": "「もっと見る」ボタンを表示", "default": true },
    { "type": "text", "id": "view_all_text", "label": "ボタンテキスト", "default": "特集をもっと見る" },
    { "type": "url", "id": "view_all_url", "label": "ボタンリンク先" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "特集バナー",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "バナー画像" },
        { "type": "text", "id": "title", "label": "タイトル", "default": "特集ページのタイトル" },
        { "type": "url", "id": "url", "label": "リンク先" }
      ]
    }
  ],
  "presets": [
    {
      "name": "6JOHAN ピックアップ特集",
      "blocks": [
        { "type": "banner", "settings": { "title": "北欧スタイルの作り方" } },
        { "type": "banner", "settings": { "title": "一人暮らし応援セット" } },
        { "type": "banner", "settings": { "title": "新生活ガイド" } },
        { "type": "banner", "settings": { "title": "5万円以下の人気アイテム" } }
      ]
    }
  ]
}
{% endschema %}
