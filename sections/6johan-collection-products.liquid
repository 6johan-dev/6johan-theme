{% comment %}
  6JOHAN Collection Products - For Recommendations & New Arrivals
{% endcomment %}

{%- style -%}
.collection-products {
  padding: 60px 0;
  background: var(--6j-bg, #FFFFFF);
}

.collection-products--alt-bg {
  background: #FAF9F7;
}

.collection-products__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.collection-products__header {
  text-align: center;
  margin-bottom: 32px;
}

.collection-products__label {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #8A7A6A;
  margin-bottom: 8px;
}

.collection-products__title {
  font-family: var(--6j-font-heading);
  font-size: 28px;
  font-weight: 500;
  color: #292724;
  margin: 0;
}

/* Grid */
.collection-products__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

/* Item */
.collection-products__item {
  position: relative;
}

.collection-products__image-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 6px;
  background: #FAF9F7;
  display: block;
  margin-bottom: 12px;
}

.collection-products__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.collection-products__item:hover .collection-products__image {
  transform: scale(1.03);
}

/* Badges */
.collection-products__badges {
  position: absolute;
  top: 8px;
  right: 8px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  z-index: 2;
}

/* Info */
.collection-products__info {
  padding: 0 4px;
}

.collection-products__name {
  font-size: 14px;
  font-weight: 500;
  color: #292724;
  margin: 0 0 6px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.collection-products__name a {
  color: inherit;
  text-decoration: none;
}

.collection-products__price {
  font-size: 15px;
  font-weight: 600;
  color: #292724;
  margin: 0;
}

.collection-products__price--compare {
  font-size: 13px;
  font-weight: 400;
  color: #807C76;
  text-decoration: line-through;
  margin-right: 8px;
}

.collection-products__price--sale {
  color: #C4956A;
}

/* View All */
.collection-products__view-all {
  text-align: center;
  margin-top: 40px;
}

.collection-products__view-all-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 40px;
  border: 1px solid #292724;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  color: #292724;
  text-decoration: none;
  transition: all 0.2s;
}

.collection-products__view-all-link:hover {
  background: #292724;
  color: #fff;
}

/* ========== タブレット ========== */
@media (max-width: 1099px) {
  .collection-products__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
}

/* ========== スマホ ========== */
@media (max-width: 749px) {
  .collection-products {
    padding: 40px 0;
  }
  
  .collection-products__container {
    padding: 0;
  }
  
  .collection-products__header,
  .collection-products__view-all {
    padding: 0 16px;
  }
  
  .collection-products__title {
    font-size: 22px;
  }
  
  /* 横スクロール */
  .collection-products__grid {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px 8px;
  }
  
  .collection-products__grid::-webkit-scrollbar { display: none; }
  
  .collection-products__item {
    flex: 0 0 42vw;
    max-width: 180px;
  }
  
  .collection-products__image-wrap {
    margin-bottom: 8px;
  }
  
  .collection-products__info {
    padding: 0;
  }
  
  .collection-products__name {
    font-size: 12px;
    margin-bottom: 4px;
  }
  
  .collection-products__price {
    font-size: 13px;
  }
  
  .collection-products__view-all-link {
    width: 100%;
    padding: 12px;
    font-size: 13px;
  }
}
{%- endstyle -%}

{% assign collection = collections[section.settings.collection] %}

<section class="collection-products{% if section.settings.alt_background %} collection-products--alt-bg{% endif %}">
  <div class="collection-products__container">
    <header class="collection-products__header">
      {% if section.settings.label != blank %}
        <span class="collection-products__label">{{ section.settings.label }}</span>
      {% endif %}
      <h2 class="collection-products__title">{{ section.settings.heading }}</h2>
    </header>
    
    <div class="collection-products__grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        <article class="collection-products__item">
          <a href="{{ product.url }}" class="collection-products__image-wrap">
            <img 
              src="{{ product.featured_image | image_url: width: 500 }}" 
              alt="{{ product.featured_image.alt | escape }}" 
              class="collection-products__image" 
              loading="lazy"
            >
            <div class="collection-products__badges">
              {% render '6johan-product-badge', product: product %}
            </div>
          </a>
          <div class="collection-products__info">
            <h3 class="collection-products__name">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <p class="collection-products__price">
              {% if product.compare_at_price > product.price %}
                <span class="collection-products__price--compare">{{ product.compare_at_price | money }}</span>
                <span class="collection-products__price--sale">{{ product.price | money }}</span>
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </p>
          </div>
        </article>
      {% endfor %}
    </div>
    
    {% if section.settings.show_view_all and collection %}
      <div class="collection-products__view-all">
        <a href="{{ collection.url }}" class="collection-products__view-all-link">
          {{ section.settings.view_all_text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN コレクション商品",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "RECOMMEND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "おすすめ商品"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "コレクション"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "表示商品数",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "「もっと見る」ボタンを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "ボタンテキスト",
      "default": "すべて見る"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "背景色を変える",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "6JOHAN コレクション商品"
    }
  ]
}
{% endschema %}
