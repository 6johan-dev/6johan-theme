{% comment %}
  6JOHAN Collection Products
  コレクション選択式 商品表示セクション
  レコメンド・新着・特集商品などに使用
{% endcomment %}

{%- style -%}
.sixj-collection-products {
  padding: 48px 0;
  background: var(--6j-bg, #fff);
}

.sixj-collection-products__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

.sixj-collection-products__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.sixj-collection-products__title {
  font-family: 'Playfair Display', 'Noto Serif JP', serif;
  font-size: clamp(20px, 4vw, 28px);
  font-weight: 500;
  color: var(--6j-text, #292724);
  margin: 0;
}

.sixj-collection-products__link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 500;
  color: var(--6j-text-sub, #807C76);
  text-decoration: none;
  transition: color 0.2s;
}

.sixj-collection-products__link:hover {
  color: var(--6j-text, #292724);
}

.sixj-collection-products__link svg {
  width: 16px;
  height: 16px;
}

.sixj-collection-products__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

@media (min-width: 750px) {
  .sixj-collection-products__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
}

/* Product Card */
.sixj-product-card {
  position: relative;
}

.sixj-product-card__link {
  text-decoration: none;
  color: inherit;
}

.sixj-product-card__image-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
  background: var(--6j-bg-sub, #FAF9F7);
  margin-bottom: 12px;
}

.sixj-product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}

.sixj-product-card:hover .sixj-product-card__image {
  transform: scale(1.03);
}

.sixj-product-card__badges {
  position: absolute;
  top: 8px;
  left: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sixj-product-card__badge {
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 600;
  border-radius: 4px;
  text-transform: uppercase;
}

.sixj-product-card__badge--sale {
  background: #D4504A;
  color: #fff;
}

.sixj-product-card__badge--new {
  background: var(--6j-accent, #C4956A);
  color: #fff;
}

.sixj-product-card__badge--soldout {
  background: var(--6j-text-sub, #807C76);
  color: #fff;
}

.sixj-product-card__badge--stock {
  background: #5E7A5E;
  color: #fff;
}

.sixj-product-card__title {
  font-size: 13px;
  font-weight: 500;
  color: var(--6j-text, #292724);
  margin: 0 0 6px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sixj-product-card__price {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--6j-text, #292724);
}

.sixj-product-card__price--compare {
  font-size: 12px;
  font-weight: 400;
  color: var(--6j-text-sub, #807C76);
  text-decoration: line-through;
}

.sixj-product-card__price--sale {
  color: #D4504A;
}

/* Scroll wrapper for mobile */
.sixj-collection-products__scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 8px;
}

.sixj-collection-products__scroll::-webkit-scrollbar {
  display: none;
}

.sixj-collection-products__scroll .sixj-product-card {
  flex: 0 0 42%;
  scroll-snap-align: start;
}

@media (min-width: 750px) {
  .sixj-collection-products__scroll {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    overflow-x: visible;
  }
  
  .sixj-collection-products__scroll .sixj-product-card {
    flex: none;
  }
}
{%- endstyle -%}

{%- assign collection = collections[section.settings.collection] -%}

<section class="sixj-collection-products">
  <div class="sixj-collection-products__container">
    <div class="sixj-collection-products__header">
      <h2 class="sixj-collection-products__title">{{ section.settings.title | default: collection.title | default: 'おすすめ商品' }}</h2>
      {%- if section.settings.show_view_all and collection -%}
        <a href="{{ collection.url }}" class="sixj-collection-products__link">
          VIEW MORE
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      {%- endif -%}
    </div>
    
    <div class="sixj-collection-products__scroll">
      {%- if collection -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="sixj-product-card">
            <a href="{{ product.url }}" class="sixj-product-card__link">
              <div class="sixj-product-card__image-wrap">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 200 }} 200w,
                            {{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 749px) 42vw, 25vw"
                    alt="{{ product.title | escape }}"
                    class="sixj-product-card__image"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'sixj-product-card__image' }}
                {%- endif -%}
                
                <div class="sixj-product-card__badges">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="sixj-product-card__badge sixj-product-card__badge--sale">SALE</span>
                  {%- endif -%}
                  {%- if product.tags contains '新着' or product.tags contains 'new' -%}
                    <span class="sixj-product-card__badge sixj-product-card__badge--new">NEW</span>
                  {%- endif -%}
                  {%- if product.available == false -%}
                    <span class="sixj-product-card__badge sixj-product-card__badge--soldout">SOLD OUT</span>
                  {%- elsif product.tags contains '即納' or product.tags contains 'in-stock' -%}
                    <span class="sixj-product-card__badge sixj-product-card__badge--stock">即納</span>
                  {%- endif -%}
                </div>
              </div>
              
              <h3 class="sixj-product-card__title">{{ product.title }}</h3>
              
              <div class="sixj-product-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="sixj-product-card__price--compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  <span class="sixj-product-card__price--sale">{{ product.price | money_without_trailing_zeros }}</span>
                {%- else -%}
                  {{ product.price | money_without_trailing_zeros }}
                {%- endif -%}
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="sixj-product-card">
            <div class="sixj-product-card__image-wrap">
              {{ 'product-1' | placeholder_svg_tag: 'sixj-product-card__image' }}
            </div>
            <h3 class="sixj-product-card__title">コレクションを選択してください</h3>
            <div class="sixj-product-card__price">¥0</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN 商品コレクション",
  "tag": "section",
  "class": "sixj-collection-products-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "セクションタイトル",
      "default": "おすすめ商品"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "コレクション"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "表示する商品数",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "「VIEW MORE」リンクを表示",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "6JOHAN 商品コレクション",
      "settings": {
        "title": "おすすめ商品"
      }
    }
  ]
}
{% endschema %}
