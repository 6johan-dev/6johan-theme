{% comment %}
  6JOHAN Product Specs Table
  商品スペック表（メタフィールド連動）
  
  メタフィールドキー:
  - custom.measurements (寸法詳細)
  - custom.material (素材)
  - custom._new (梱包サイズ)
  - custom.is_assembly (組み立て有無)
  - custom._shipping_cost (最低送料)
  - custom.memo (備考欄)
{% endcomment %}

{%- liquid
  assign measurements = product.metafields.custom.measurements
  assign material = product.metafields.custom.material
  assign package_size = product.metafields.custom._new
  assign is_assembly = product.metafields.custom.is_assembly
  assign shipping_cost = product.metafields.custom._shipping_cost
  assign memo = product.metafields.custom.memo
  
  assign has_specs = false
  if measurements != blank or material != blank or package_size != blank or is_assembly != blank or shipping_cost != blank
    assign has_specs = true
  endif
-%}

{% if has_specs %}
<div class="product-specs-section">
  <div class="product-specs-container">
    {% if section.settings.show_heading %}
      <h3 class="product-specs-heading">{{ section.settings.heading }}</h3>
    {% endif %}
    
    <table class="product-specs-table">
      <tbody>
        {% if measurements != blank %}
          <tr>
            <th>サイズ</th>
            <td>{{ measurements | newline_to_br }}</td>
          </tr>
        {% endif %}
        
        {% if material != blank %}
          <tr>
            <th>素材</th>
            <td>{{ material }}</td>
          </tr>
        {% endif %}
        
        {% if package_size != blank %}
          <tr>
            <th>梱包サイズ</th>
            <td>{{ package_size }}</td>
          </tr>
        {% endif %}
        
        {% if is_assembly != blank %}
          <tr>
            <th>組み立て</th>
            <td>
              {% if is_assembly == true %}
                組み立てが必要です
              {% else %}
                完成品でお届け
              {% endif %}
            </td>
          </tr>
        {% endif %}
        
        {% if shipping_cost != blank and shipping_cost > 0 %}
          <tr>
            <th>送料目安</th>
            <td>¥{{ shipping_cost | plus: 0 }}〜</td>
          </tr>
        {% endif %}
        
        {% if memo != blank %}
          <tr>
            <th>備考</th>
            <td>{{ memo | newline_to_br }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

<style>
  .product-specs-section {
    margin: 2rem 0;
    padding: 0;
  }
  
  .product-specs-container {
    max-width: 100%;
  }
  
  .product-specs-heading {
    font-family: var(--6j-font-heading, 'Playfair Display', 'Noto Serif JP', serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--6j-charcoal, #2C2C24);
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--6j-sand, #E8E5DC);
  }
  
  .product-specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  
  .product-specs-table tr {
    border-bottom: 1px solid var(--6j-sand, #E8E5DC);
  }
  
  .product-specs-table tr:last-child {
    border-bottom: none;
  }
  
  .product-specs-table th {
    font-family: var(--6j-font-body, 'Noto Sans JP', sans-serif);
    font-weight: 500;
    color: var(--6j-stone, #8A8A7A);
    text-align: left;
    vertical-align: top;
    padding: 0.875rem 1rem 0.875rem 0;
    width: 100px;
    white-space: nowrap;
  }
  
  .product-specs-table td {
    font-family: var(--6j-font-body, 'Noto Sans JP', sans-serif);
    font-weight: 400;
    color: var(--6j-earth, #6B6B5E);
    text-align: left;
    vertical-align: top;
    padding: 0.875rem 0;
  }
  
  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .product-specs-table th {
      width: 80px;
      padding-right: 0.75rem;
      font-size: 0.875rem;
    }
    
    .product-specs-table td {
      font-size: 0.875rem;
    }
  }
</style>
{% endif %}

{% schema %}
{
  "name": "商品スペック表",
  "tag": "section",
  "class": "section-product-specs",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "見出しを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出しテキスト",
      "default": "商品仕様"
    }
  ],
  "presets": [
    {
      "name": "商品スペック表"
    }
  ]
}
{% endschema %}
