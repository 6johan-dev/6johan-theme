{% comment %}
  6JOHAN Ranking Section - LOWYA Style
{% endcomment %}

{%- style -%}
.ranking-section {
  padding: 60px 0;
  background: var(--6j-bg, #FFFFFF);
}

.ranking-section__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.ranking-section__header {
  text-align: center;
  margin-bottom: 32px;
}

.ranking-section__label {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #8A7A6A;
  margin-bottom: 8px;
}

.ranking-section__title {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 500;
  color: #292724;
  margin: 0;
}

/* Tabs */
.ranking-section__tabs {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 32px;
  overflow-x: auto;
  scrollbar-width: none;
  padding: 4px;
}

.ranking-section__tabs::-webkit-scrollbar { display: none; }

.ranking-section__tab {
  flex-shrink: 0;
  padding: 10px 20px;
  background: none;
  border: 1px solid #E8E5E0;
  border-radius: 24px;
  font-size: 13px;
  font-weight: 500;
  color: #807C76;
  cursor: pointer;
  transition: all 0.2s;
}

.ranking-section__tab:hover {
  border-color: #292724;
  color: #292724;
}

.ranking-section__tab.is-active {
  background: #292724;
  border-color: #292724;
  color: #fff;
}

.ranking-section__content {
  display: none;
}

.ranking-section__content.is-active {
  display: block;
}

/* Item Base */
.ranking-section__item {
  position: relative;
}

.ranking-section__image-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 6px;
  background: #FAF9F7;
  display: block;
}

.ranking-section__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.ranking-section__item:hover .ranking-section__image {
  transform: scale(1.03);
}

/* Rank Badge */
.ranking-section__rank {
  position: absolute;
  top: 8px;
  left: 8px;
  width: 28px;
  height: 28px;
  background: #292724;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  z-index: 3;
}

.ranking-section__rank--1 { background: linear-gradient(135deg, #D4A843, #B8932E); }
.ranking-section__rank--2 { background: linear-gradient(135deg, #A8A8A8, #8A8A8A); }
.ranking-section__rank--3 { background: linear-gradient(135deg, #CD7F32, #A66528); }

/* Product Badges */
.ranking-section__badges {
  position: absolute;
  top: 8px;
  right: 8px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  z-index: 2;
}

/* Info */
.ranking-section__info {
  padding: 10px 0 0;
}

.ranking-section__name {
  font-size: 13px;
  font-weight: 500;
  color: #292724;
  margin: 0 0 4px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ranking-section__name a {
  color: inherit;
  text-decoration: none;
}

.ranking-section__price {
  font-size: 14px;
  font-weight: 600;
  color: #292724;
  margin: 0;
}

/* View All */
.ranking-section__view-all {
  text-align: center;
  margin-top: 40px;
}

.ranking-section__view-all-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 40px;
  border: 1px solid #292724;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  color: #292724;
  text-decoration: none;
  transition: all 0.2s;
}

.ranking-section__view-all-link:hover {
  background: #292724;
  color: #fff;
}

/* ========== PC: 6列グリッド ========== */
@media (min-width: 1100px) {
  .ranking-section__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 16px;
  }
  
  .ranking-section__item--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 44px;
    height: 44px;
    font-size: 18px;
  }
  
  .ranking-section__item--1 .ranking-section__name { font-size: 15px; }
  .ranking-section__item--1 .ranking-section__price { font-size: 17px; }
  
  .ranking-section__item--2 { grid-column: 3; grid-row: 1; }
  .ranking-section__item--3 { grid-column: 3; grid-row: 2; }
  .ranking-section__item--4 { grid-column: 4; grid-row: 1; }
  .ranking-section__item--5 { grid-column: 4; grid-row: 2; }
  .ranking-section__item--6 { grid-column: 5; grid-row: 1; }
  .ranking-section__item--7 { grid-column: 5; grid-row: 2; }
  .ranking-section__item--8 { grid-column: 6; grid-row: 1; }
  .ranking-section__item--9 { grid-column: 6; grid-row: 2; }
}

/* ========== タブレット: 4列 ========== */
@media (min-width: 750px) and (max-width: 1099px) {
  .ranking-section__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  
  .ranking-section__item--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 40px;
    height: 40px;
    font-size: 16px;
  }
  
  .ranking-section__item--2 { grid-column: 3; grid-row: 1; }
  .ranking-section__item--3 { grid-column: 4; grid-row: 1; }
  .ranking-section__item--4 { grid-column: 3; grid-row: 2; }
  .ranking-section__item--5 { grid-column: 4; grid-row: 2; }
  .ranking-section__item--6 { grid-column: 1; grid-row: 3; }
  .ranking-section__item--7 { grid-column: 2; grid-row: 3; }
  .ranking-section__item--8 { grid-column: 3; grid-row: 3; }
  .ranking-section__item--9 { grid-column: 4; grid-row: 3; }
}

/* ========== スマホ: 横スクロール2行 ========== */
@media (max-width: 749px) {
  .ranking-section {
    padding: 40px 0;
  }
  
  .ranking-section__container {
    padding: 0;
  }
  
  .ranking-section__header,
  .ranking-section__tabs,
  .ranking-section__view-all {
    padding: 0 16px;
  }
  
  .ranking-section__title {
    font-size: 22px;
  }
  
  .ranking-section__tabs {
    justify-content: flex-start;
  }
  
  .ranking-section__tab {
    padding: 8px 14px;
    font-size: 12px;
  }
  
  /* 横スクロールグリッド */
  .ranking-section__grid {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px 8px;
  }
  
  .ranking-section__grid::-webkit-scrollbar { display: none; }
  
  /* SP: 商品名を非表示、価格のみ表示 */
  .ranking-section__grid--mobile .ranking-section__name {
    display: none;
  }
  
  .ranking-section__grid--mobile .ranking-section__info {
    padding: 4px 0 0;
  }
  
  /* 1位 */
  .ranking-section__item--1 {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
  }
  
  .ranking-section__item--1 .ranking-section__image-wrap {
    width: calc(28vw * 2 + 8px);
    max-width: 240px;
    flex: 1;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 28px;
    height: 28px;
    font-size: 13px;
  }
  
  .ranking-section__item--1 .ranking-section__price {
    font-size: 13px;
  }
  
  /* 2位以降のペア */
  .ranking-section__pair {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 0 0 28vw;
    max-width: 116px;
  }
  
  .ranking-section__pair .ranking-section__item {
    display: flex;
    flex-direction: column;
  }
  
  .ranking-section__pair .ranking-section__image-wrap {
    aspect-ratio: 1;
  }
  
  .ranking-section__pair .ranking-section__rank {
    width: 20px;
    height: 20px;
    font-size: 10px;
    top: 5px;
    left: 5px;
  }
  
  .ranking-section__pair .ranking-section__badges {
    top: 5px;
    right: 5px;
  }
  
  .ranking-section__pair .ranking-section__price {
    font-size: 11px;
  }
  
  .ranking-section__view-all-link {
    width: 100%;
    padding: 12px;
    font-size: 13px;
  }
}
{%- endstyle -%}

<section class="ranking-section">
  <div class="ranking-section__container">
    <header class="ranking-section__header">
      <span class="ranking-section__label">{{ section.settings.label }}</span>
      <h2 class="ranking-section__title">{{ section.settings.heading }}</h2>
    </header>
    
    {% if section.blocks.size > 0 %}
      <div class="ranking-section__tabs" role="tablist">
        {% for block in section.blocks %}
          <button
            class="ranking-section__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            data-tab="{{ block.id }}"
            data-url="{{ collections[block.settings.collection].url }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</button>
        {% endfor %}
      </div>
      
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% assign limit = block.settings.products_to_show | default: 9 %}
        <div class="ranking-section__content{% if forloop.first %} is-active{% endif %}" id="ranking-{{ block.id }}">
          
          {%- comment -%} PC/タブレット用グリッド {%- endcomment -%}
          <div class="ranking-section__grid ranking-section__grid--desktop">
            {% for product in collection.products limit: limit %}
              <article class="ranking-section__item ranking-section__item--{{ forloop.index }}">
                <span class="ranking-section__rank ranking-section__rank--{{ forloop.index }}">{{ forloop.index }}</span>
                <a href="{{ product.url }}" class="ranking-section__image-wrap">
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | escape }}" class="ranking-section__image" loading="lazy">
                  <div class="ranking-section__badges">{% render '6johan-product-badge', product: product %}</div>
                </a>
                <div class="ranking-section__info">
                  <h3 class="ranking-section__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  <p class="ranking-section__price">{{ product.price | money }}</p>
                </div>
              </article>
            {% endfor %}
          </div>
          
          {%- comment -%} SP用横スクロール {%- endcomment -%}
          <div class="ranking-section__grid ranking-section__grid--mobile">
            {% for product in collection.products limit: 1 %}
              <article class="ranking-section__item ranking-section__item--1">
                <span class="ranking-section__rank ranking-section__rank--1">1</span>
                <a href="{{ product.url }}" class="ranking-section__image-wrap">
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | escape }}" class="ranking-section__image" loading="lazy">
                  <div class="ranking-section__badges">{% render '6johan-product-badge', product: product %}</div>
                </a>
                <div class="ranking-section__info">
                  <h3 class="ranking-section__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  <p class="ranking-section__price">{{ product.price | money }}</p>
                </div>
              </article>
            {% endfor %}
            
            {% assign pairs = limit | minus: 1 | divided_by: 2 %}
            {% for i in (1..pairs) %}
              {% assign idx1 = i | times: 2 %}
              {% assign idx2 = idx1 | plus: 1 %}
              <div class="ranking-section__pair">
                {% assign products_array = collection.products %}
                {% if products_array[idx1] %}
                  {% assign product = products_array[idx1] %}
                  {% assign rank = idx1 | plus: 1 %}
                  <article class="ranking-section__item">
                    <span class="ranking-section__rank ranking-section__rank--{{ rank }}">{{ rank }}</span>
                    <a href="{{ product.url }}" class="ranking-section__image-wrap">
                      <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.featured_image.alt | escape }}" class="ranking-section__image" loading="lazy">
                      <div class="ranking-section__badges">{% render '6johan-product-badge', product: product %}</div>
                    </a>
                    <div class="ranking-section__info">
                      <p class="ranking-section__price">{{ product.price | money }}</p>
                    </div>
                  </article>
                {% endif %}
                {% if products_array[idx2] %}
                  {% assign product = products_array[idx2] %}
                  {% assign rank = idx2 | plus: 1 %}
                  <article class="ranking-section__item">
                    <span class="ranking-section__rank ranking-section__rank--{{ rank }}">{{ rank }}</span>
                    <a href="{{ product.url }}" class="ranking-section__image-wrap">
                      <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.featured_image.alt | escape }}" class="ranking-section__image" loading="lazy">
                      <div class="ranking-section__badges">{% render '6johan-product-badge', product: product %}</div>
                    </a>
                    <div class="ranking-section__info">
                      <p class="ranking-section__price">{{ product.price | money }}</p>
                    </div>
                  </article>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          
        </div>
      {% endfor %}
      
      <div class="ranking-section__view-all">
        <a href="{{ collections[section.blocks.first.settings.collection].url }}" class="ranking-section__view-all-link" id="ranking-link">
          {{ section.settings.view_all_text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .ranking-section__grid--mobile { display: none; }
  
  @media (max-width: 749px) {
    .ranking-section__grid--desktop { display: none; }
    .ranking-section__grid--mobile { display: flex; }
  }
</style>

<script>
(function() {
  const tabs = document.querySelectorAll('.ranking-section__tab');
  const panels = document.querySelectorAll('.ranking-section__content');
  const link = document.getElementById('ranking-link');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('is-active'));
      panels.forEach(p => p.classList.remove('is-active'));
      
      tab.classList.add('is-active');
      document.getElementById('ranking-' + tab.dataset.tab).classList.add('is-active');
      if (link) link.href = tab.dataset.url;
    });
  });
})();
</script>

{% schema %}
{
  "name": "6JOHAN ランキング",
  "settings": [
    { "type": "text", "id": "label", "label": "ラベル", "default": "RANKING" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "人気ランキング" },
    { "type": "text", "id": "view_all_text", "label": "ボタンテキスト", "default": "ランキングをもっと見る" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "タブ",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "ラベル", "default": "すべて" },
        { "type": "collection", "id": "collection", "label": "コレクション" },
        { "type": "range", "id": "products_to_show", "label": "商品数", "min": 5, "max": 12, "default": 9 }
      ]
    }
  ],
  "presets": [{ "name": "6JOHAN ランキング", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
