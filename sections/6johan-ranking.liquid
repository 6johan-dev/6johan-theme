{% comment %}
  6JOHAN Ranking Section
  LOWYA風ランキング（1位大+2-9位横スクロール）
{% endcomment %}

{%- style -%}
.ranking-section {
  padding: 60px 0;
  background-color: var(--6j-bg, #FFFFFF);
}

.ranking-section__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.ranking-section__header {
  text-align: center;
  margin-bottom: 32px;
}

.ranking-section__label {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--6j-label, #8A7A6A);
  margin-bottom: 8px;
}

.ranking-section__title {
  font-family: 'Playfair Display', 'Noto Serif JP', serif;
  font-size: 28px;
  font-weight: 500;
  color: var(--6j-text, #292724);
  margin: 0;
}

/* Tabs */
.ranking-section__tabs-wrap {
  position: relative;
  margin-bottom: 32px;
}

.ranking-section__tabs-scroll {
  display: flex;
  justify-content: center;
  gap: 8px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  padding: 4px 40px;
}

.ranking-section__tabs-scroll::-webkit-scrollbar {
  display: none;
}

.ranking-section__tab {
  flex-shrink: 0;
  padding: 10px 20px;
  background: none;
  border: 1px solid var(--6j-border, #E8E5E0);
  border-radius: 24px;
  font-size: 13px;
  font-weight: 500;
  color: var(--6j-text-sub, #807C76);
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}

.ranking-section__tab:hover {
  border-color: var(--6j-text, #292724);
  color: var(--6j-text, #292724);
}

.ranking-section__tab.is-active {
  background-color: var(--6j-text, #292724);
  border-color: var(--6j-text, #292724);
  color: #fff;
}

.ranking-section__tabs-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  height: 32px;
  background: var(--6j-bg, #fff);
  border: 1px solid var(--6j-border, #E8E5E0);
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: all 0.2s;
}

.ranking-section__tabs-arrow:hover {
  border-color: var(--6j-text, #292724);
}

.ranking-section__tabs-arrow--prev { left: 0; }
.ranking-section__tabs-arrow--next { right: 0; }

.ranking-section__tabs-arrow svg {
  width: 16px;
  height: 16px;
  color: var(--6j-text, #292724);
}

.ranking-section__tabs-arrow.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.ranking-section__content {
  display: none;
}

.ranking-section__content.is-active {
  display: block;
}

/* Base item styles */
.ranking-section__item {
  position: relative;
  display: flex;
  flex-direction: column;
}

.ranking-section__rank {
  position: absolute;
  top: 8px;
  left: 8px;
  width: 28px;
  height: 28px;
  background-color: var(--6j-text, #292724);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  z-index: 3;
}

.ranking-section__rank--1 {
  background: linear-gradient(135deg, #D4A843 0%, #B8932E 100%);
}

.ranking-section__rank--2 {
  background: linear-gradient(135deg, #A8A8A8 0%, #8A8A8A 100%);
}

.ranking-section__rank--3 {
  background: linear-gradient(135deg, #CD7F32 0%, #A66528 100%);
}

.ranking-section__image-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8px;
  background-color: var(--6j-bg-sub, #FAF9F7);
  display: block;
}

.ranking-section__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}

.ranking-section__item:hover .ranking-section__image {
  transform: scale(1.03);
}

.ranking-section__badges {
  position: absolute;
  top: 8px;
  right: 8px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  z-index: 2;
}

.ranking-section__info {
  padding: 10px 4px 0;
  display: flex;
  flex-direction: column;
}

.ranking-section__name {
  font-size: 12px;
  font-weight: 500;
  color: var(--6j-text, #292724);
  margin: 0 0 6px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ranking-section__name a {
  color: inherit;
  text-decoration: none;
}

.ranking-section__name a:hover {
  text-decoration: underline;
}

.ranking-section__price {
  font-size: 14px;
  font-weight: 600;
  color: var(--6j-text, #292724);
  margin: 0;
}

.ranking-section__view-all {
  text-align: center;
  margin-top: 40px;
}

.ranking-section__view-all-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 40px;
  border: 1px solid var(--6j-text, #292724);
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  color: var(--6j-text, #292724);
  text-decoration: none;
  transition: all 0.2s;
}

.ranking-section__view-all-link:hover {
  background-color: var(--6j-text, #292724);
  color: #fff;
}

.ranking-section__view-all-link svg {
  transition: transform 0.2s;
}

.ranking-section__view-all-link:hover svg {
  transform: translateX(4px);
}

/* ===== スマホ: 1位左固定 + 2位以降横スクロール ===== */
@media (max-width: 749px) {
  .ranking-section {
    padding: 40px 0;
  }
  
  .ranking-section__container {
    padding: 0 16px;
  }
  
  .ranking-section__title {
    font-size: 22px;
  }
  
  .ranking-section__tabs-scroll {
    justify-content: flex-start;
    padding: 4px 32px;
  }
  
  .ranking-section__tab {
    padding: 8px 14px;
    font-size: 12px;
  }
  
  .ranking-section__tabs-arrow {
    width: 28px;
    height: 28px;
  }
  
  .ranking-section__tabs-arrow svg {
    width: 14px;
    height: 14px;
  }
  
  /* 横スクロールグリッド: 2行×自動列 */
  .ranking-section__grid {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 140px;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
    margin: 0 -16px;
    padding-left: 16px;
    padding-right: 16px;
  }
  
  .ranking-section__grid::-webkit-scrollbar {
    display: none;
  }
  
  /* 1位: 2行分の高さ */
  .ranking-section__item--1 {
    grid-row: 1 / 3;
    width: 52vw;
    max-width: 220px;
  }
  
  .ranking-section__item--1 .ranking-section__image-wrap {
    aspect-ratio: auto;
    flex: 1;
    min-height: 0;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 36px;
    height: 36px;
    font-size: 16px;
  }
  
  .ranking-section__item--1 .ranking-section__name {
    font-size: 13px;
  }
  
  .ranking-section__item--1 .ranking-section__price {
    font-size: 15px;
  }
  
  .ranking-section__item:not(.ranking-section__item--1) {
    scroll-snap-align: start;
  }
  
  .ranking-section__rank {
    width: 24px;
    height: 24px;
    font-size: 11px;
    top: 6px;
    left: 6px;
  }
  
  .ranking-section__badges {
    top: 6px;
    right: 6px;
  }
  
  .ranking-section__info {
    padding: 8px 2px 0;
  }
  
  .ranking-section__name {
    font-size: 11px;
    margin-bottom: 4px;
    -webkit-line-clamp: 1;
  }
  
  .ranking-section__price {
    font-size: 13px;
  }
  
  .ranking-section__view-all-link {
    padding: 12px 24px;
    font-size: 13px;
  }
}

/* ===== タブレット: 4列 ===== */
@media (min-width: 750px) and (max-width: 1099px) {
  .ranking-section__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  
  .ranking-section__item--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
  }
  
  .ranking-section__item--1 .ranking-section__image-wrap {
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 44px;
    height: 44px;
    font-size: 18px;
  }
  
  .ranking-section__item--1 .ranking-section__info {
    padding: 14px 4px 0;
    flex-shrink: 0;
  }
  
  .ranking-section__item--1 .ranking-section__name {
    font-size: 15px;
    margin-bottom: 8px;
  }
  
  .ranking-section__item--1 .ranking-section__price {
    font-size: 17px;
  }
  
  .ranking-section__item--2 { grid-column: 3; grid-row: 1; }
  .ranking-section__item--3 { grid-column: 4; grid-row: 1; }
  .ranking-section__item--4 { grid-column: 3; grid-row: 2; }
  .ranking-section__item--5 { grid-column: 4; grid-row: 2; }
  .ranking-section__item--6 { grid-column: 1; grid-row: 3; }
  .ranking-section__item--7 { grid-column: 2; grid-row: 3; }
  .ranking-section__item--8 { grid-column: 3; grid-row: 3; }
  .ranking-section__item--9 { grid-column: 4; grid-row: 3; }
}

/* ===== PC: 6列グリッド ===== */
@media (min-width: 1100px) {
  .ranking-section__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  
  .ranking-section__item--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
  }
  
  .ranking-section__item--1 .ranking-section__image-wrap {
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }
  
  .ranking-section__item--1 .ranking-section__rank {
    width: 44px;
    height: 44px;
    font-size: 18px;
  }
  
  .ranking-section__item--1 .ranking-section__info {
    padding: 14px 4px 0;
    flex-shrink: 0;
  }
  
  .ranking-section__item--1 .ranking-section__name {
    font-size: 15px;
    margin-bottom: 8px;
  }
  
  .ranking-section__item--1 .ranking-section__price {
    font-size: 17px;
  }
  
  .ranking-section__item--2 { grid-column: 3; grid-row: 1; }
  .ranking-section__item--3 { grid-column: 3; grid-row: 2; }
  .ranking-section__item--4 { grid-column: 4; grid-row: 1; }
  .ranking-section__item--5 { grid-column: 4; grid-row: 2; }
  .ranking-section__item--6 { grid-column: 5; grid-row: 1; }
  .ranking-section__item--7 { grid-column: 5; grid-row: 2; }
  .ranking-section__item--8 { grid-column: 6; grid-row: 1; }
  .ranking-section__item--9 { grid-column: 6; grid-row: 2; }
}
{%- endstyle -%}

<section class="ranking-section">
  <div class="ranking-section__container">
    <header class="ranking-section__header">
      <span class="ranking-section__label">{{ section.settings.label }}</span>
      <h2 class="ranking-section__title">{{ section.settings.heading }}</h2>
    </header>
    
    {% if section.blocks.size > 0 %}
      <div class="ranking-section__tabs-wrap">
        <button class="ranking-section__tabs-arrow ranking-section__tabs-arrow--prev is-hidden" aria-label="前へ">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        
        <div class="ranking-section__tabs-scroll" role="tablist">
          {% for block in section.blocks %}
            <button
              class="ranking-section__tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="ranking-panel-{{ block.id }}"
              data-tab="{{ block.id }}"
              data-collection-url="{{ collections[block.settings.collection].url }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_label }}
            </button>
          {% endfor %}
        </div>
        
        <button class="ranking-section__tabs-arrow ranking-section__tabs-arrow--next" aria-label="次へ">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>
      
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        <div
          class="ranking-section__content{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          id="ranking-panel-{{ block.id }}"
          data-collection-url="{{ collection.url }}"
        >
          <div class="ranking-section__grid">
            {% assign products_to_show = block.settings.products_to_show | default: 9 %}
            {% for product in collection.products limit: products_to_show %}
              <article class="ranking-section__item ranking-section__item--{{ forloop.index }}">
                <span class="ranking-section__rank ranking-section__rank--{{ forloop.index }}">
                  {{ forloop.index }}
                </span>
                
                <a href="{{ product.url }}" class="ranking-section__image-wrap">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ranking-section__image"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'ranking-section__image' }}
                  {% endif %}
                  
                  <div class="ranking-section__badges">
                    {% render '6johan-product-badge', product: product %}
                  </div>
                </a>
                
                <div class="ranking-section__info">
                  <h3 class="ranking-section__name">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  <p class="ranking-section__price">
                    {{ product.price | money }}
                  </p>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
      
      {% assign first_collection = collections[section.blocks.first.settings.collection] %}
      <div class="ranking-section__view-all">
        <a href="{{ first_collection.url }}" class="ranking-section__view-all-link" id="ranking-view-all">
          {{ section.settings.view_all_text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.ranking-section__tab');
  const panels = document.querySelectorAll('.ranking-section__content');
  const viewAllLink = document.getElementById('ranking-view-all');
  
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      const targetId = this.getAttribute('data-tab');
      const collectionUrl = this.getAttribute('data-collection-url');
      
      tabs.forEach(function(t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      this.classList.add('is-active');
      this.setAttribute('aria-selected', 'true');
      
      panels.forEach(function(panel) {
        panel.classList.remove('is-active');
        if (panel.id === 'ranking-panel-' + targetId) {
          panel.classList.add('is-active');
        }
      });
      
      if (viewAllLink && collectionUrl) {
        viewAllLink.href = collectionUrl;
      }
    });
  });
  
  const tabsWrap = document.querySelector('.ranking-section__tabs-wrap');
  if (tabsWrap) {
    const scrollContainer = tabsWrap.querySelector('.ranking-section__tabs-scroll');
    const prevBtn = tabsWrap.querySelector('.ranking-section__tabs-arrow--prev');
    const nextBtn = tabsWrap.querySelector('.ranking-section__tabs-arrow--next');
    
    const updateArrows = () => {
      if (!scrollContainer) return;
      const { scrollLeft, scrollWidth, clientWidth } = scrollContainer;
      
      if (prevBtn) {
        prevBtn.classList.toggle('is-hidden', scrollLeft <= 0);
      }
      if (nextBtn) {
        nextBtn.classList.toggle('is-hidden', scrollLeft + clientWidth >= scrollWidth - 1);
      }
    };
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -150, behavior: 'smooth' });
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: 150, behavior: 'smooth' });
      });
    }
    
    if (scrollContainer) {
      scrollContainer.addEventListener('scroll', updateArrows);
      window.addEventListener('resize', updateArrows);
      updateArrows();
    }
  }
});
</script>

{% schema %}
{
  "name": "6JOHAN ランキング",
  "tag": "section",
  "class": "section-ranking",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "RANKING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "人気ランキング"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "「すべて見る」テキスト",
      "default": "ランキングをもっと見る"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "タブ",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "タブラベル",
          "default": "すべて"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "コレクション"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "表示する商品数",
          "min": 5,
          "max": 12,
          "step": 1,
          "default": 9
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "6JOHAN ランキング",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_label": "すべて"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "チェア"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "テーブル"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "収納"
          }
        }
      ]
    }
  ]
}
{% endschema %}
