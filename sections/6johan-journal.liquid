<div style="padding: 48px 0; border-top: 1px solid #E8E5DC;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    <p style="font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8A7A; margin-bottom: 6px;">{{ section.settings.label }}</p>
    <h2 style="font-family: var(--6j-font-heading); font-size: 22px; margin-bottom: 24px;">{{ section.settings.heading }}</h2>
    <div style="padding: 32px; background: #F5F4F0; border-radius: 0; text-align: center;">
      <p style="font-size: 13px; color: #8A8A7A;">ブログを作成して記事を投稿すると、ここに最新記事が表示されます。</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "6JOHAN Journal",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "暮らしのヒント"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN Journal"
    }
  ]
}
{% endschema %}
