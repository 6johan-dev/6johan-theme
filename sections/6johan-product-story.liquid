{% comment %}
  6JOHAN Product Story Section
  メタフィールドから商品ストーリー（タイトル+説明文+画像 × 4ブロック）を読み込んで表示。

  使用メタフィールド:
  - custom.descriptiontitle1〜4 (単一行テキスト)
  - custom.description1〜4 (複数行テキスト)
  - custom.descriptionimage1〜4 (ファイル)
  - custom.desctiptionimage3 (ファイル) … 3枚目だけ店側の定義キーが綴り誤り（rがt）。
    120商品のデータはこのキーに入っているため、両方を見て表示する。

  Phase 2 (2026-11-21):
   - スマホで3,000〜4,000px（ページの47〜58%）あったストーリーを、冒頭1ブロック＋画像1枚の
     要約＋「商品ストーリーを詳しく見る」の折りたたみに変更（全文は<details>内に残す）。
   - 見出し・余白を詰め、ヘッダーのタイトルは商品名の繰り返しをやめた。
{% endcomment %}

{%- liquid
  assign story_count = 0
  assign story_imgs = 0
  for i in (1..4)
    assign dkey = 'description' | append: i
    assign ikey = 'descriptionimage' | append: i
    assign dval_check = product.metafields.custom[dkey]
    assign ival_check = product.metafields.custom[ikey]
    if i == 3 and ival_check == blank
      assign ival_check = product.metafields.custom.desctiptionimage3
    endif
    if dval_check != blank
      assign story_count = story_count | plus: 1
      if ival_check != blank
        assign story_imgs = story_imgs | plus: 1
      endif
    endif
  endfor

  assign has_story = false
  if story_count > 0
    assign has_story = true
  endif

  assign story_heading = section.settings.title | default: 'この商品について'
  assign lead_cut = false
-%}

{%- if has_story -%}
<div class="product-story" id="ProductStory-{{ section.id }}">
  <div class="product-story__container">

    <div class="product-story__header">
      <span class="product-story__label">{{ section.settings.label | default: 'ABOUT THIS PRODUCT' }}</span>
      <h2 class="product-story__title">{{ story_heading }}</h2>
    </div>

    {%- comment -%} 冒頭ブロック：最初の段落だけを出し、続きは折りたたみへ {%- endcomment -%}
    {%- assign lead_done = false -%}
    {%- for i in (1..4) -%}
      {%- assign dkey = 'description' | append: i -%}
      {%- assign tkey = 'descriptiontitle' | append: i -%}
      {%- assign ikey = 'descriptionimage' | append: i -%}
      {%- assign dval = product.metafields.custom[dkey] -%}
      {%- assign tval = product.metafields.custom[tkey] -%}
      {%- assign ival = product.metafields.custom[ikey] -%}
      {%- if i == 3 and ival == blank -%}
        {%- assign ival = product.metafields.custom.desctiptionimage3 -%}
      {%- endif -%}

      {%- if dval != blank and lead_done == false -%}
        {%- assign paras = dval | newline_to_br | split: '<br />' -%}
        {%- assign lead_para = paras | first | strip -%}
        {%- assign lead_text = lead_para | truncate: 150, '…' -%}
        {%- if lead_text != lead_para -%}{%- assign lead_cut = true -%}{%- endif -%}

        <div class="product-story__lead">
          <div class="product-story__text">
            {%- if tval != blank -%}<h3 class="product-story__heading">{{ tval }}</h3>{%- endif -%}
            <div class="product-story__body">{{ lead_text }}</div>
          </div>
          {%- if ival != blank -%}
            <div class="product-story__image">
              <img src="{{ ival | image_url: width: 1200 }}" alt="{{ tval | default: product.title | escape }}" loading="lazy" width="1200" height="800">
            </div>
          {%- endif -%}
        </div>
        {%- assign lead_done = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if story_count > 1 or lead_cut -%}
      <details class="product-story__more">
        <summary>
          <span class="product-story__more-label">商品ストーリーを詳しく見る</span>
          <span class="product-story__more-meta">{% if story_count > 1 %}全{{ story_count }}章{% endif %}{% if story_imgs > 0 %}・写真{{ story_imgs }}枚{% endif %}</span>
          <svg class="product-story__more-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="product-story__more-body">

          {%- assign more_done = false -%}
          {%- for i in (1..4) -%}
            {%- assign dkey = 'description' | append: i -%}
            {%- assign tkey = 'descriptiontitle' | append: i -%}
            {%- assign ikey = 'descriptionimage' | append: i -%}
            {%- assign dval = product.metafields.custom[dkey] -%}
            {%- assign tval = product.metafields.custom[tkey] -%}
            {%- assign ival = product.metafields.custom[ikey] -%}
            {%- if i == 3 and ival == blank -%}
              {%- assign ival = product.metafields.custom.desctiptionimage3 -%}
            {%- endif -%}

            {%- if dval != blank -%}
              {%- if more_done == false -%}
                {%- assign more_done = true -%}
                {%- if lead_cut -%}
                  {%- comment -%} 冒頭が途中で切れている場合は全文をここに出す（取りこぼし防止） {%- endcomment -%}
                  <div class="product-story__block">
                    {%- if tval != blank -%}<h3 class="product-story__heading">{{ tval }}</h3>{%- endif -%}
                    <div class="product-story__body">{{ dval | newline_to_br }}</div>
                  </div>
                {%- else -%}
                  {%- assign paras = dval | newline_to_br | split: '<br />' -%}
                  {%- for p in paras offset: 1 -%}
                    {%- assign p_str = p | strip -%}
                    {%- if p_str != '' -%}
                      <div class="product-story__block product-story__block--cont">
                        <div class="product-story__body">{{ p_str | newline_to_br }}</div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- else -%}
                <div class="product-story__block">
                  <div class="product-story__text">
                    {%- if tval != blank -%}<h3 class="product-story__heading">{{ tval }}</h3>{%- endif -%}
                    <div class="product-story__body">{{ dval | newline_to_br }}</div>
                  </div>
                  {%- if ival != blank -%}
                    <div class="product-story__image">
                      <img src="{{ ival | image_url: width: 1200 }}" alt="{{ tval | default: product.title | escape }}" loading="lazy" width="1200" height="800">
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

        </div>
      </details>
    {%- endif -%}

  </div>
</div>

<style>
.product-story {
  padding: 28px 0 20px;
  border-top: 1px solid #F2F2F0;
}

.product-story__container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}

.product-story__header {
  text-align: center;
  margin-bottom: 18px;
}

.product-story__label {
  display: block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.15em;
  color: #999;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.product-story__title {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  color: #292724;
}

.product-story__heading {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.55;
  margin: 0 0 8px;
  color: #292724;
}

.product-story__body {
  font-size: 13.5px;
  line-height: 1.9;
  color: #555;
  letter-spacing: 0.02em;
}

.product-story__image {
  margin-top: 14px;
}

.product-story__image img {
  width: 100%;
  height: auto;
  display: block;
}

.product-story__block {
  margin-bottom: 28px;
}

.product-story__block--cont {
  margin-bottom: 10px;
}

.product-story__block:last-child {
  margin-bottom: 0;
}

.product-story__more {
  margin-top: 18px;
  border-top: 1px solid #EFEDE7;
}

.product-story__more summary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 15px 0;
  cursor: pointer;
  list-style: none;
  color: #292724;
}

.product-story__more summary::-webkit-details-marker {
  display: none;
}

.product-story__more-label {
  flex: 1;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.product-story__more-meta {
  font-size: 11px;
  color: #999;
  white-space: nowrap;
}

.product-story__more-icon {
  flex-shrink: 0;
  transition: transform 0.2s ease;
  color: #8A7A7A;
}

.product-story__more[open] .product-story__more-icon {
  transform: rotate(180deg);
}

.product-story__more-body {
  padding: 6px 0 4px;
}

@media screen and (min-width: 750px) {
  .product-story {
    padding: 56px 0 40px;
  }

  .product-story__container {
    max-width: 900px;
  }

  .product-story__header {
    margin-bottom: 28px;
  }

  .product-story__title {
    font-size: 22px;
  }

  .product-story__lead .product-story__text {
    max-width: 700px;
    margin: 0 auto;
  }

  .product-story__heading {
    font-size: 17px;
    margin-bottom: 10px;
  }

  .product-story__body {
    font-size: 14.5px;
    line-height: 2;
  }

  .product-story__image {
    margin-top: 20px;
  }

  .product-story__block {
    margin-bottom: 48px;
  }

  .product-story__block--cont {
    margin-bottom: 12px;
  }

  .product-story__more summary {
    padding: 18px 0;
  }

  .product-story__more-label {
    font-size: 14px;
  }
}
</style>
{%- endif -%}

{% schema %}
{
  "name": "商品ストーリー",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "ABOUT THIS PRODUCT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "タイトル（空欄で「この商品について」）"
    }
  ],
  "presets": [
    {
      "name": "商品ストーリー"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
