{% comment %}
  6JOHAN News Section
  ニュース・お知らせセクション
{% endcomment %}

{%- style -%}
.news-section {
  padding: 60px 0;
  background-color: #fff;
}

.news-section__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.news-section__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32px;
  flex-wrap: wrap;
  gap: 16px;
}

.news-section__title-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.news-section__label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--6j-amber, #C4956A);
}

.news-section__title {
  font-family: 'Playfair Display', 'Noto Serif JP', serif;
  font-size: 24px;
  font-weight: 500;
  color: var(--6j-charcoal, #2C2C24);
  margin: 0;
}

.news-section__view-all {
  font-size: 13px;
  color: var(--6j-earth, #6B6B5E);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
}

.news-section__view-all:hover {
  color: var(--6j-charcoal, #2C2C24);
}

.news-section__list {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--6j-sand, #E8E5DC);
}

.news-section__item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px 0;
  border-bottom: 1px solid var(--6j-sand, #E8E5DC);
  text-decoration: none;
  transition: background-color 0.2s;
}

.news-section__item:hover {
  background-color: var(--6j-parchment, #F5F4F0);
  margin: 0 -20px;
  padding-left: 20px;
  padding-right: 20px;
}

.news-section__date {
  flex-shrink: 0;
  font-size: 13px;
  color: var(--6j-stone, #8A8A7A);
  min-width: 90px;
}

.news-section__category {
  flex-shrink: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 3px;
  text-transform: uppercase;
}

.news-section__category--info {
  background-color: var(--6j-parchment, #F5F4F0);
  color: var(--6j-earth, #6B6B5E);
}

.news-section__category--important {
  background-color: #C75050;
  color: #fff;
}

.news-section__category--campaign {
  background-color: var(--6j-amber, #C4956A);
  color: #fff;
}

.news-section__category--new {
  background-color: var(--6j-charcoal, #2C2C24);
  color: #fff;
}

.news-section__text {
  flex: 1;
  font-size: 14px;
  color: var(--6j-charcoal, #2C2C24);
  line-height: 1.6;
}

.news-section__arrow {
  flex-shrink: 0;
  color: var(--6j-stone, #8A8A7A);
  transition: transform 0.2s, color 0.2s;
}

.news-section__item:hover .news-section__arrow {
  transform: translateX(4px);
  color: var(--6j-charcoal, #2C2C24);
}

@media (max-width: 749px) {
  .news-section {
    padding: 40px 0;
  }
  
  .news-section__item {
    flex-wrap: wrap;
    gap: 8px;
  }
  
  .news-section__date {
    min-width: auto;
  }
  
  .news-section__text {
    width: 100%;
    order: 3;
  }
  
  .news-section__arrow {
    display: none;
  }
}
{%- endstyle -%}

<section class="news-section">
  <div class="news-section__container">
    <header class="news-section__header">
      <div class="news-section__title-group">
        <span class="news-section__label">{{ section.settings.label }}</span>
        <h2 class="news-section__title">{{ section.settings.heading }}</h2>
      </div>
      
      {% if section.settings.show_view_all and section.settings.view_all_url != blank %}
        <a href="{{ section.settings.view_all_url }}" class="news-section__view-all">
          {{ section.settings.view_all_text }}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </header>
    
    <div class="news-section__list">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url | default: '#' }}" class="news-section__item" {{ block.shopify_attributes }}>
          <span class="news-section__date">{{ block.settings.date }}</span>
          
          {% case block.settings.category %}
            {% when 'important' %}
              <span class="news-section__category news-section__category--important">重要</span>
            {% when 'campaign' %}
              <span class="news-section__category news-section__category--campaign">キャンペーン</span>
            {% when 'new' %}
              <span class="news-section__category news-section__category--new">新着</span>
            {% else %}
              <span class="news-section__category news-section__category--info">お知らせ</span>
          {% endcase %}
          
          <span class="news-section__text">{{ block.settings.text }}</span>
          
          <svg class="news-section__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN ニュース",
  "tag": "section",
  "class": "section-news",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "NEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "お知らせ"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "「すべて見る」リンクを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "「すべて見る」テキスト",
      "default": "すべてのお知らせを見る"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "「すべて見る」リンク先"
    }
  ],
  "blocks": [
    {
      "type": "news_item",
      "name": "お知らせ",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "日付",
          "default": "2026.03.20"
        },
        {
          "type": "select",
          "id": "category",
          "label": "カテゴリ",
          "options": [
            { "value": "info", "label": "お知らせ" },
            { "value": "important", "label": "重要" },
            { "value": "campaign", "label": "キャンペーン" },
            { "value": "new", "label": "新着" }
          ],
          "default": "info"
        },
        {
          "type": "text",
          "id": "text",
          "label": "テキスト",
          "default": "お知らせの内容をここに入力してください"
        },
        {
          "type": "url",
          "id": "url",
          "label": "リンクURL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "6JOHAN ニュース",
      "blocks": [
        {
          "type": "news_item",
          "settings": {
            "date": "2026.03.20",
            "category": "new",
            "text": "春の新作コレクションが入荷しました"
          }
        },
        {
          "type": "news_item",
          "settings": {
            "date": "2026.03.15",
            "category": "important",
            "text": "配送料改定のお知らせ（4月1日より適用）"
          }
        },
        {
          "type": "news_item",
          "settings": {
            "date": "2026.03.10",
            "category": "campaign",
            "text": "春のまとめ買いキャンペーン開催中"
          }
        }
      ]
    }
  ]
}
{% endschema %}
