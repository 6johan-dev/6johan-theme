{% comment %}
  6JOHAN Search Bar
  ヘッダー下に常時表示する検索窓（USAGI風）
{% endcomment %}

<style>
.sixj-search-bar {
  background: var(--6j-bg, #fff);
  padding: 12px 16px;
  border-bottom: 1px solid var(--6j-border, #E8E5E0);
}

.sixj-search-bar__container {
  max-width: 600px;
  margin: 0 auto;
}

.sixj-search-bar__form {
  display: flex;
  align-items: center;
  background: #F2F2F0;
  border: none;
  border-radius: 8px;
  padding: 10px 16px;
  gap: 10px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.sixj-search-bar__form:focus-within {
  border-color: var(--6j-text, #292724);
  box-shadow: 0 0 0 1px var(--6j-text, #292724);
}

.sixj-search-bar__icon {
  width: 20px;
  height: 20px;
  color: var(--6j-text-sub, #807C76);
  flex-shrink: 0;
}

.sixj-search-bar__icon svg {
  width: 100%;
  height: 100%;
}

.sixj-search-bar__input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 14px;
  color: var(--6j-text, #292724);
  outline: none;
}

.sixj-search-bar__input::placeholder {
  color: var(--6j-text-sub, #807C76);
}

.sixj-search-bar__input::-webkit-search-cancel-button {
  -webkit-appearance: none;
}

@media (min-width: 990px) {
  .sixj-search-bar {
    padding: 16px 24px;
  }
  
  .sixj-search-bar__form {
    padding: 12px 20px;
  }
  
  .sixj-search-bar__input {
    font-size: 15px;
  }
}
</style>

<div class="sixj-search-bar">
  <div class="sixj-search-bar__container">
    <form action="{{ routes.search_url }}" method="get" role="search" class="sixj-search-bar__form">
      <span class="sixj-search-bar__icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </span>
      <input
        type="search"
        name="q"
        class="sixj-search-bar__input"
        placeholder="{{ section.settings.placeholder | default: '何かお探しですか？' }}"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      >
      <input type="hidden" name="type" value="product">
    </form>
  </div>
</div>

{% schema %}
{
  "name": "6JOHAN 検索バー",
  "tag": "section",
  "class": "sixj-search-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "プレースホルダーテキスト",
      "default": "何かお探しですか？"
    }
  ],
  "presets": [
    {
      "name": "6JOHAN 検索バー"
    }
  ]
}
{% endschema %}
