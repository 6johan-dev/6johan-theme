{% comment %}
  6JOHAN Magazine Page Section
  マガジン/コラムページ用セクション
{% endcomment %}

{%- style -%}
  .magazine-page {
    padding: 60px 0;
    background: var(--6j-bg);
  }
  .magazine-page__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .magazine-page__header {
    text-align: center;
    margin-bottom: 48px;
  }
  .magazine-page__label {
    font-size: var(--6j-font-size-xs);
    letter-spacing: var(--6j-letter-spacing-label);
    color: var(--6j-label);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .magazine-page__title {
    font-size: var(--6j-font-size-2xl);
    font-weight: var(--6j-font-weight-medium);
    color: var(--6j-text);
    margin-bottom: 12px;
  }
  .magazine-page__desc {
    font-size: var(--6j-font-size-base);
    color: var(--6j-text-sub);
    max-width: 600px;
    margin: 0 auto;
  }
  
  /* Category Tabs */
  .magazine-page__categories {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .magazine-page__category {
    padding: 10px 20px;
    border: 1px solid var(--6j-border);
    border-radius: var(--6j-radius-full);
    background: var(--6j-bg);
    color: var(--6j-text);
    font-size: var(--6j-font-size-sm);
    cursor: pointer;
    transition: all var(--6j-transition-base);
  }
  .magazine-page__category:hover,
  .magazine-page__category.active {
    background: var(--6j-accent);
    color: #fff;
    border-color: var(--6j-accent);
  }
  
  /* Featured Article */
  .magazine-featured {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }
  @media (max-width: 768px) {
    .magazine-featured {
      grid-template-columns: 1fr;
    }
  }
  .magazine-featured__main {
    position: relative;
    border-radius: var(--6j-radius-xl);
    overflow: hidden;
  }
  .magazine-featured__main-image {
    aspect-ratio: 16/9;
    background: var(--6j-bg-sub);
  }
  .magazine-featured__main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .magazine-featured__main-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: #fff;
  }
  .magazine-featured__main-category {
    display: inline-block;
    padding: 4px 12px;
    background: var(--6j-accent);
    border-radius: var(--6j-radius-sm);
    font-size: var(--6j-font-size-xs);
    margin-bottom: 12px;
  }
  .magazine-featured__main-title {
    font-size: var(--6j-font-size-xl);
    font-weight: var(--6j-font-weight-medium);
    margin-bottom: 8px;
    line-height: var(--6j-line-height-tight);
  }
  .magazine-featured__main-date {
    font-size: var(--6j-font-size-sm);
    opacity: 0.8;
  }
  
  .magazine-featured__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .magazine-featured__side-item {
    display: flex;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: opacity var(--6j-transition-base);
  }
  .magazine-featured__side-item:hover {
    opacity: 0.8;
  }
  .magazine-featured__side-image {
    flex-shrink: 0;
    width: 120px;
    aspect-ratio: 4/3;
    background: var(--6j-bg-sub);
    border-radius: var(--6j-radius-lg);
    overflow: hidden;
  }
  .magazine-featured__side-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .magazine-featured__side-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .magazine-featured__side-category {
    font-size: var(--6j-font-size-xs);
    color: var(--6j-accent);
    margin-bottom: 4px;
  }
  .magazine-featured__side-title {
    font-size: var(--6j-font-size-sm);
    font-weight: var(--6j-font-weight-medium);
    color: var(--6j-text);
    line-height: var(--6j-line-height-base);
    margin-bottom: 4px;
  }
  .magazine-featured__side-date {
    font-size: var(--6j-font-size-xs);
    color: var(--6j-text-sub);
  }
  
  /* Article Grid */
  .magazine-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .magazine-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .magazine-grid {
      grid-template-columns: 1fr;
    }
  }
  
  /* Article Card */
  .magazine-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--6j-transition-base);
  }
  .magazine-card:hover {
    transform: translateY(-4px);
  }
  .magazine-card__image {
    aspect-ratio: 3/2;
    background: var(--6j-bg-sub);
    border-radius: var(--6j-radius-xl);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .magazine-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .magazine-card__category {
    font-size: var(--6j-font-size-xs);
    color: var(--6j-accent);
    margin-bottom: 8px;
  }
  .magazine-card__title {
    font-size: var(--6j-font-size-md);
    font-weight: var(--6j-font-weight-medium);
    color: var(--6j-text);
    line-height: var(--6j-line-height-base);
    margin-bottom: 8px;
  }
  .magazine-card__excerpt {
    font-size: var(--6j-font-size-sm);
    color: var(--6j-text-sub);
    line-height: var(--6j-line-height-relaxed);
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .magazine-card__date {
    font-size: var(--6j-font-size-xs);
    color: var(--6j-text-sub);
  }
  
  /* Pagination */
  .magazine-page__pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 48px;
  }
  .magazine-page__pagination a,
  .magazine-page__pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--6j-border);
    border-radius: var(--6j-radius-base);
    font-size: var(--6j-font-size-sm);
    color: var(--6j-text);
    text-decoration: none;
    transition: all var(--6j-transition-base);
  }
  .magazine-page__pagination a:hover {
    background: var(--6j-bg-sub);
  }
  .magazine-page__pagination .active {
    background: var(--6j-accent);
    color: #fff;
    border-color: var(--6j-accent);
  }
{%- endstyle -%}

<section class="magazine-page">
  <div class="magazine-page__container">
    <header class="magazine-page__header">
      <p class="magazine-page__label">{{ section.settings.label }}</p>
      <h1 class="magazine-page__title">{{ section.settings.title }}</h1>
      <p class="magazine-page__desc">{{ section.settings.description }}</p>
    </header>
    
    {% if section.settings.show_categories %}
    <div class="magazine-page__categories">
      <button class="magazine-page__category active">すべて</button>
      <button class="magazine-page__category">インテリア</button>
      <button class="magazine-page__category">暮らし方</button>
      <button class="magazine-page__category">お手入れ</button>
      <button class="magazine-page__category">スタッフ日記</button>
    </div>
    {% endif %}
    
    {% if section.settings.show_featured %}
    <div class="magazine-featured">
      <a href="{{ section.settings.featured_link }}" class="magazine-featured__main">
        <div class="magazine-featured__main-image">
          {% if section.settings.featured_image != blank %}
            <img src="{{ section.settings.featured_image | image_url: width: 1200 }}" 
                 alt="{{ section.settings.featured_title }}"
                 loading="eager">
          {% endif %}
        </div>
        <div class="magazine-featured__main-content">
          <span class="magazine-featured__main-category">{{ section.settings.featured_category }}</span>
          <h2 class="magazine-featured__main-title">{{ section.settings.featured_title }}</h2>
          <span class="magazine-featured__main-date">{{ section.settings.featured_date }}</span>
        </div>
      </a>
      <div class="magazine-featured__side">
        {% for block in section.blocks %}
          {% if block.type == 'featured_sub' %}
            <a href="{{ block.settings.link }}" class="magazine-featured__side-item" {{ block.shopify_attributes }}>
              <div class="magazine-featured__side-image">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 300 }}" 
                       alt="{{ block.settings.title }}"
                       loading="lazy">
                {% endif %}
              </div>
              <div class="magazine-featured__side-content">
                <span class="magazine-featured__side-category">{{ block.settings.category }}</span>
                <h3 class="magazine-featured__side-title">{{ block.settings.title }}</h3>
                <span class="magazine-featured__side-date">{{ block.settings.date }}</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
    
    <div class="magazine-grid">
      {% for block in section.blocks %}
        {% if block.type == 'article' %}
          <a href="{{ block.settings.link }}" class="magazine-card" {{ block.shopify_attributes }}>
            <div class="magazine-card__image">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" 
                     alt="{{ block.settings.title }}"
                     loading="lazy">
              {% endif %}
            </div>
            <span class="magazine-card__category">{{ block.settings.category }}</span>
            <h3 class="magazine-card__title">{{ block.settings.title }}</h3>
            <p class="magazine-card__excerpt">{{ block.settings.excerpt }}</p>
            <span class="magazine-card__date">{{ block.settings.date }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    
    {% if section.settings.show_pagination %}
    <nav class="magazine-page__pagination">
      <a href="#">←</a>
      <span class="active">1</span>
      <a href="#">2</a>
      <a href="#">3</a>
      <a href="#">→</a>
    </nav>
    {% endif %}
  </div>
</section>

