{% comment %}
  6JOHAN Feature Banners
  特集バナースライダー
{% endcomment %}

{%- style -%}
.feature-banners {
  padding: 0;
  background-color: var(--6j-linen, #FAFAF7);
}

.feature-banners__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 20px;
}

.feature-banners__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.feature-banners__grid--2 {
  grid-template-columns: repeat(2, 1fr);
}

.feature-banners__grid--1 {
  grid-template-columns: 1fr;
  max-width: 800px;
  margin: 0 auto;
}

.feature-banners__item {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  aspect-ratio: 16/9;
  background-color: var(--6j-parchment, #F5F4F0);
}

.feature-banners__item--large {
  grid-column: span 2;
  aspect-ratio: 2/1;
}

.feature-banners__link {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-banners__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.feature-banners__item:hover .feature-banners__image {
  transform: scale(1.03);
}

.feature-banners__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.5) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px;
}

.feature-banners__overlay--light {
  background: linear-gradient(180deg, transparent 40%, rgba(255,255,255,0.9) 100%);
}

.feature-banners__label {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--6j-amber, #C4956A);
  margin-bottom: 8px;
}

.feature-banners__title {
  font-family: 'Playfair Display', 'Noto Serif JP', serif;
  font-size: 22px;
  font-weight: 500;
  color: #fff;
  margin: 0 0 8px;
  line-height: 1.3;
}

.feature-banners__overlay--light .feature-banners__title {
  color: var(--6j-charcoal, #2C2C24);
}

.feature-banners__subtitle {
  font-size: 13px;
  color: rgba(255,255,255,0.9);
  margin: 0;
}

.feature-banners__overlay--light .feature-banners__subtitle {
  color: var(--6j-earth, #6B6B5E);
}

.feature-banners__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  font-size: 13px;
  font-weight: 500;
  color: #fff;
  transition: gap 0.2s;
}

.feature-banners__overlay--light .feature-banners__cta {
  color: var(--6j-charcoal, #2C2C24);
}

.feature-banners__item:hover .feature-banners__cta {
  gap: 10px;
}

@media (max-width: 899px) {
  .feature-banners__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .feature-banners__item--large {
    grid-column: span 2;
  }
}

@media (max-width: 599px) {
  .feature-banners__container {
    padding: 24px 16px;
  }
  
  .feature-banners__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  
  .feature-banners__item--large {
    grid-column: span 1;
  }
  
  .feature-banners__item {
    aspect-ratio: 16/10;
  }
  
  .feature-banners__title {
    font-size: 18px;
  }
  
  .feature-banners__overlay {
    padding: 16px;
  }
}
{%- endstyle -%}

<section class="feature-banners">
  <div class="feature-banners__container">
    {% assign block_count = section.blocks.size %}
    <div class="feature-banners__grid{% if block_count == 2 %} feature-banners__grid--2{% elsif block_count == 1 %} feature-banners__grid--1{% endif %}">
      {% for block in section.blocks %}
        <article class="feature-banners__item{% if block.settings.is_large %} feature-banners__item--large{% endif %}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.url | default: '#' }}" class="feature-banners__link">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 800 }} 800w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 599px) 100vw, (max-width: 899px) 50vw, 33vw"
                alt="{{ block.settings.title | escape }}"
                class="feature-banners__image"
                loading="lazy"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-banners__image' }}
            {% endif %}
            
            <div class="feature-banners__overlay{% if block.settings.overlay_light %} feature-banners__overlay--light{% endif %}">
              {% if block.settings.label != blank %}
                <span class="feature-banners__label">{{ block.settings.label }}</span>
              {% endif %}
              
              {% if block.settings.title != blank %}
                <h3 class="feature-banners__title">{{ block.settings.title }}</h3>
              {% endif %}
              
              {% if block.settings.subtitle != blank %}
                <p class="feature-banners__subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}
              
              {% if block.settings.cta_text != blank %}
                <span class="feature-banners__cta">
                  {{ block.settings.cta_text }}
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "6JOHAN 特集バナー",
  "tag": "section",
  "class": "section-feature-banners",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "バナー",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "label",
          "label": "ラベル",
          "placeholder": "FEATURE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "タイトル",
          "default": "特集タイトル"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "サブタイトル"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTAテキスト",
          "default": "詳しく見る"
        },
        {
          "type": "url",
          "id": "url",
          "label": "リンク先"
        },
        {
          "type": "checkbox",
          "id": "is_large",
          "label": "大きく表示（2カラム分）",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "overlay_light",
          "label": "明るいオーバーレイ",
          "default": false,
          "info": "明るい画像の場合はチェック"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "6JOHAN 特集バナー",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "label": "SPRING COLLECTION",
            "title": "春の新作コレクション",
            "subtitle": "暮らしに彩りを添える新作家具",
            "cta_text": "詳しく見る",
            "is_large": true
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "STYLE GUIDE",
            "title": "北欧スタイルの作り方",
            "cta_text": "読む"
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "5万円以下",
            "title": "お手頃価格の人気アイテム",
            "cta_text": "見る"
          }
        }
      ]
    }
  ]
}
{% endschema %}
