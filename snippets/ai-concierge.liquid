{%- comment -%}
  6JOHAN AI CONCIERGE — 商品ページ即答チップ ＋ LINE風チャットシート（MVP / 2026-11-21）

  使い方: main-product の block「ai_concierge」から render される
    {% render 'ai-concierge', product: product, block: block %}

  構成
    ① ページ内（インライン）は「AI CONCIERGE／1秒で即答」＋チップ3つ＋1行入力のみ。
       ここには回答を展開しない（カートボタンを押し下げない）。
    ② チップ or 送信で、下からLINE風のチャットシート（オーバーレイ）が立ち上がる。
       AI＝左の吹き出し、自分＝右の吹き出し。チップを押すと右→左がポンポンと並ぶ。
    ③ 価格・カートに追加・担当者に相談はシート下部の固定バーに【1つだけ】常駐（回答ごとに出さない）。
    ④ 背景タップ / × / Esc で閉じ、再度チップ or 入力で続きから開ける。

  事実（寸法・在庫/納期・送料・返品）はLiquidで商品データから確定させ、
  JS（assets/ai-concierge.js）はそれを文章にするだけ。数値を作らせない。

  参照データ
    - 寸法      : product.metafields.custom.measurements（複数行・1行目を使用）
    - 素材      : product.metafields.custom.material
    - 組み立て  : product.metafields.custom.is_assembly（boolean）
    - 梱包サイズ: product.metafields.custom._new（配送サイズ区分の数値。送料表のキー）
    - 在庫/納期 : snippets/6johan-delivery-state（商品ページ共通の唯一の判定ソース）
    - 送料      : snippets/6johan-shipping-estimate の SHIPPING_TABLE と同じ料金（関東）
    - 返品      : /policies/refund-policy（30日以内・理由を問わず）

  クラス名は j6ac- 接頭辞。テーマ共通CSSの [class*="sixj-"] / [class*="6johan"]
  { background:#fff !important } を避けるため（のし帖の教訓と同じ）。
{%- endcomment -%}

{%- liquid
  assign ac_enabled = block.settings.enabled
  if ac_enabled == nil
    assign ac_enabled = true
  endif

  assign measurements_raw = product.metafields.custom.measurements.value | default: product.metafields.custom.measurements
  assign size_line = ''
  if measurements_raw != blank
    assign size_line = measurements_raw | strip | newline_to_br | split: '<br />' | first | strip
    assign first_char = size_line | slice: 0
    if first_char == '・' or first_char == '·' or first_char == '、' or first_char == '-' or first_char == '*'
      assign size_line = size_line | slice: 1, 200 | strip
    endif
  endif

  assign ac_material = product.metafields.custom.material.value | default: product.metafields.custom.material
  assign ac_assembly = product.metafields.custom.is_assembly.value
  if ac_assembly == blank
    assign ac_assembly = product.metafields.custom.is_assembly
  endif

  assign ac_size_num = product.metafields.custom['_new'] | strip | replace: 'サイズ', '' | replace: ' ', '' | plus: 0

  assign ac_variant = product.selected_or_first_available_variant
  capture _ac_ds
    render '6johan-delivery-state', variant: ac_variant, product: product
  endcapture
  assign _ac_ds = _ac_ds | split: '|'
  assign ac_state = _ac_ds[0] | strip
  assign ac_lead = _ac_ds[1] | strip

  # 送料（関東）: snippets/6johan-shipping-estimate の SHIPPING_TABLE と同じ値
  assign ac_ship = 0
  if ac_size_num > 0
    if ac_size_num <= 120
      assign ac_ship = 2250
    elsif ac_size_num <= 140
      assign ac_ship = 2500
    elsif ac_size_num <= 160
      assign ac_ship = 2750
    elsif ac_size_num <= 180
      assign ac_ship = 3130
    elsif ac_size_num <= 200
      assign ac_ship = 3630
    elsif ac_size_num <= 220
      assign ac_ship = 4380
    elsif ac_size_num <= 240
      assign ac_ship = 5500
    elsif ac_size_num <= 260
      assign ac_ship = 6750
    endif
  endif

  assign ac_price = ac_variant.price | divided_by: 100
  assign ac_accent = block.settings.accent | default: '#6B5B4F'
  assign ac_sheet_id = 'j6ac-sheet-' | append: block.id
  assign ac_human_base = block.settings.human_url | default: 'https://line.me/R/oaMessage/@505xknxn/'
-%}

{%- if ac_enabled and product != blank -%}
  <div
    class="j6ac"
    id="j6ac-{{ block.id }}"
    style="--j6ac-accent: {{ ac_accent }};"
    data-j6ac
    data-j6ac-product="{{ product.id }}"
    data-j6ac-handle="{{ product.handle | escape }}"
  >
    <div class="j6ac__bar">
      <div class="j6ac__label">
        <b>{{ block.settings.label | default: 'AI CONCIERGE' }}</b>
        <i aria-hidden="true"></i>
        <em>{{ block.settings.badge | default: '1秒で即答' }}</em>
      </div>

      <div class="j6ac__chips" role="group" aria-label="よくある質問">
        <button type="button" class="j6ac__chip" data-j6ac-chip="delivery" aria-controls="{{ ac_sheet_id }}" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.6 12 3l9 4.6v8.8L12 21l-9-4.6z"/><path d="M3 7.6 12 12.2l9-4.6"/><path d="M12 12.2V21"/></svg>
          <span>{{ block.settings.chip_delivery | default: 'いつ届く？' }}</span>
        </button>
        <button type="button" class="j6ac__chip" data-j6ac-chip="size" aria-controls="{{ ac_sheet_id }}" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 15.5 15.5 4.5l4 4L8.5 19.5z"/><path d="M8 12l1.8 1.8M11 9l1.8 1.8M14 6l1.8 1.8"/></svg>
          <span>{{ block.settings.chip_size | default: 'サイズ感' }}</span>
        </button>
        <button type="button" class="j6ac__chip" data-j6ac-chip="return" aria-controls="{{ ac_sheet_id }}" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h9.5a6 6 0 0 1 0 12H10"/></svg>
          <span>{{ block.settings.chip_return | default: '返品' }}</span>
        </button>
      </div>

      <form class="j6ac__ask" data-j6ac-form="inline">
        <label class="j6ac__sr" for="j6ac-input-{{ block.id }}">この商品について質問する</label>
        <input
          type="text"
          id="j6ac-input-{{ block.id }}"
          class="j6ac__input"
          data-j6ac-input="inline"
          placeholder="{{ block.settings.placeholder | default: '搬入・納期・素材…ひとことどうぞ' }}"
          autocomplete="off"
          enterkeyhint="send"
        >
        <button type="submit" class="j6ac__send" aria-label="質問を送って会話を開く">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>

    {%- comment -%} ===== オーバーレイ（LINE風チャットシート） ===== {%- endcomment -%}
    <div class="j6ac-sheet" id="{{ ac_sheet_id }}" data-j6ac-sheet hidden aria-hidden="true">
      <div class="j6ac-sheet__scrim" data-j6ac-close aria-hidden="true"><i></i></div>

      <div
        class="j6ac-sheet__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="{{ ac_sheet_id }}-title"
        tabindex="-1"
        data-j6ac-panel
      >
        <header class="j6ac-sheet__head">
          <span class="j6ac-sheet__avatar" aria-hidden="true"><b>AI</b></span>
          <div class="j6ac-sheet__ident">
            <span class="j6ac-sheet__name">
              <b>{{ block.settings.label | default: 'AI CONCIERGE' }}</b>
              <em>{{ block.settings.badge | default: '1秒で即答' }}</em>
            </span>
            <span class="j6ac-sheet__title" id="{{ ac_sheet_id }}-title">{{ product.title }}</span>
            <span class="j6ac-sheet__meta">
              {%- if product.variants.size > 1 -%}
                <span class="j6ac-sheet__variant" data-j6ac-variant>{{ ac_variant.title }}</span>
              {%- endif -%}
              <span class="j6ac-sheet__stock" data-j6ac-stock></span>
            </span>
          </div>
          <button type="button" class="j6ac-sheet__close" data-j6ac-close aria-label="閉じる">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </header>

        <div class="j6ac-sheet__thread" data-j6ac-thread aria-live="polite" aria-relevant="additions"></div>

        <div class="j6ac-sheet__foot">
          {%- comment -%} ===== 固定CTA（価格・カート・相談はここ1か所だけ） ===== {%- endcomment -%}
          <div class="j6ac-cta" data-j6ac-cta>
            <div class="j6ac-cta__row">
              <span class="j6ac-cta__price">
                <i>価格</i>
                <b data-j6ac-price>{{ ac_variant.price | money }}</b>
                <em>税込</em>
              </span>
              <button type="button" class="j6ac-cta__buy" data-j6ac-add>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                <span data-j6ac-add-label>カートに追加する</span>
              </button>
            </div>
            <a
              class="j6ac-cta__human"
              href="{{ ac_human_base }}"
              target="_blank"
              rel="noopener"
              data-j6ac-human="fixed"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5.2 20c.6-3.4 3.4-5.6 6.8-5.6s6.2 2.2 6.8 5.6"/></svg>
              <span>{{ block.settings.human_label | default: '担当者に相談' }}</span>
              <i aria-hidden="true">›</i>
            </a>
          </div>

          <div class="j6ac-sheet__quick" role="group" aria-label="追加の質問">
            <button type="button" class="j6ac__chip j6ac__chip--mini" data-j6ac-chip="delivery"><span>{{ block.settings.chip_delivery | default: 'いつ届く？' }}</span></button>
            <button type="button" class="j6ac__chip j6ac__chip--mini" data-j6ac-chip="size"><span>{{ block.settings.chip_size | default: 'サイズ感' }}</span></button>
            <button type="button" class="j6ac__chip j6ac__chip--mini" data-j6ac-chip="return"><span>{{ block.settings.chip_return | default: '返品' }}</span></button>
          </div>

          <form class="j6ac__ask j6ac__ask--sheet" data-j6ac-form="sheet">
            <label class="j6ac__sr" for="j6ac-input-sheet-{{ block.id }}">追加の質問を入力</label>
            <input
              type="text"
              id="j6ac-input-sheet-{{ block.id }}"
              class="j6ac__input"
              data-j6ac-input="sheet"
              placeholder="{{ block.settings.sheet_placeholder | default: 'ほかに気になることは？' }}"
              autocomplete="off"
              enterkeyhint="send"
            >
            <button type="submit" class="j6ac__send" aria-label="送信">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </form>

          <p class="j6ac__disclaimer">AIによる自動回答です。確実なことは担当者にご確認ください。</p>
        </div>
      </div>
    </div>

    <script type="application/json" data-j6ac-data>
      {
        "productId": {{ product.id | json }},
        "title": {{ product.title | json }},
        "handle": {{ product.handle | json }},
        "url": {{ product.url | json }},
        "size": {{ size_line | json }},
        "material": {{ ac_material | default: '' | json }},
        "assembly": {% if ac_assembly == true %}true{% elsif ac_assembly == false %}false{% else %}null{% endif %},
        "state": {{ ac_state | json }},
        "lead": {{ ac_lead | json }},
        "shipKanto": {{ ac_ship | json }},
        "price": {{ ac_price | json }},
        "variantId": {{ ac_variant.id | json }},
        "variantTitle": {{ ac_variant.title | json }},
        "variants": [
          {%- for v in product.variants -%}
            {"id": {{ v.id | json }}, "price": {{ v.price | divided_by: 100 | json }}, "available": {{ v.available | json }}, "title": {{ v.title | json }}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "humanLabel": {{ block.settings.human_label | default: '担当者に相談' | json }},
        "humanUrl": {{ block.settings.human_url | default: '' | json }},
        "lineUrl": "https://line.me/R/oaMessage/@505xknxn/",
        "greeting": {{ block.settings.greeting | default: 'こんにちは。6JOHANのAIコンシェルジュです。この商品の寸法・在庫・送料を確認して、その場でお答えします。' | json }},
        "greetingSub": {{ block.settings.greeting_sub | default: '気になることは下のチップから1タップでも、そのまま入力しても聞けます。' | json }}
      }
    </script>
  </div>

  {{ 'ai-concierge.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ai-concierge.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
