{% comment %}
  6JOHAN Rich Menu Drawer
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">

          <div class="drawer-search">
            <form action="{{ routes.search_url }}" method="get" class="drawer-search__form" role="search">
              <svg class="drawer-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
              <input type="search" name="q" class="drawer-search__input" placeholder="何をお探しですか？" autocomplete="off">
              <input type="hidden" name="type" value="product">
            </form>
          </div>

          <!-- 閲覧履歴 -->
          <div id="drawer-recently-viewed" style="display:none; padding: 0 0 8px; border-bottom: 1px solid #E8E5E0;">
            <div class="drawer-section">
              <div class="drawer-section__label">閲覧履歴アイテム</div>
            </div>
            <div id="drawer-recently-viewed-grid" style="display: flex; gap: 10px; overflow-x: auto; padding: 0 20px 12px; scrollbar-width: none; -webkit-overflow-scrolling: touch;"></div>
          </div>

          <div class="drawer-section">
            <div class="drawer-section__label">FIND ITEMS</div>
          </div>
          <ul class="drawer-nav">
            <li class="drawer-nav__item">
              <details class="drawer-nav__details">
                <summary class="drawer-nav__submenu-toggle">
                  カテゴリから探す
                  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <ul class="drawer-nav__submenu">
                  <li><a href="/collections/チェア・椅子" class="drawer-nav__link drawer-nav__link--sub">チェア・椅子</a></li>
                  <li><a href="/collections/デスク・テーブル" class="drawer-nav__link drawer-nav__link--sub">デスク・テーブル</a></li>
                  <li><a href="/collections/サイドテーブル・ローテーブル" class="drawer-nav__link drawer-nav__link--sub">サイドテーブル・ローテーブル</a></li>
                  <li><a href="/collections/ソファ" class="drawer-nav__link drawer-nav__link--sub">ソファ</a></li>
                  <li><a href="/collections/キャビネット・サイドボード" class="drawer-nav__link drawer-nav__link--sub">キャビネット・サイドボード</a></li>
                  <li><a href="/collections/シェルフ・本棚" class="drawer-nav__link drawer-nav__link--sub">シェルフ・本棚</a></li>
                  <li><a href="/collections/チェスト" class="drawer-nav__link drawer-nav__link--sub">チェスト</a></li>
                  <li><a href="/collections/テレビボード・テレビ台" class="drawer-nav__link drawer-nav__link--sub">テレビボード・テレビ台</a></li>
                  <li><a href="/collections/ミラー・鏡" class="drawer-nav__link drawer-nav__link--sub">ミラー・鏡</a></li>
                  <li><a href="/collections/雑貨・その他インテリア家具" class="drawer-nav__link drawer-nav__link--sub">雑貨・その他インテリア</a></li>
                  <li>
                    <a href="/collections" class="drawer-nav__link drawer-nav__link--sub">
                      すべてのカテゴリ
                      <svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                  </li>
                </ul>
              </details>
            </li>
            <li class="drawer-nav__item">
              <a href="/collections/new-arrival" class="drawer-nav__link">新着商品から探す<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/collections/pick-up" class="drawer-nav__link">ランキングから探す<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/collections/即納商品" class="drawer-nav__link">すぐ届く商品<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/collections/5万円以下" class="drawer-nav__link">5万円以下<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
          </ul>

          <div class="drawer-section">
            <div class="drawer-section__label">GUIDE</div>
          </div>
          <ul class="drawer-nav">
            <li class="drawer-nav__item">
              <a href="/pages/guide" class="drawer-nav__link">はじめての方へ<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/pages/shopping-guide" class="drawer-nav__link">ショッピングガイド<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/pages/trust" class="drawer-nav__link">安心してお買い物<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/pages/contact" class="drawer-nav__link">お問い合わせ<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
          </ul>

          <div class="drawer-section">
            <div class="drawer-section__label">ABOUT</div>
          </div>
          <ul class="drawer-nav">
            <li class="drawer-nav__item">
              <a href="/pages/about" class="drawer-nav__link">6JOHANについて<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
            <li class="drawer-nav__item">
              <a href="/blogs/news" class="drawer-nav__link">お知らせ<svg class="drawer-nav__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></a>
            </li>
          </ul>

          {%- if settings.social_instagram_link != blank or settings.social_twitter_link != blank -%}
            <div class="drawer-section" style="padding-bottom: 100px;">
              <div class="drawer-section__label">FOLLOW US</div>
              <div style="display: flex; gap: 20px; padding: 8px 0;">
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" style="color: var(--6j-charcoal, #2C2C24); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 13px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
                    Instagram
                  </a>
                {%- endif -%}
                {%- if settings.social_twitter_link != blank -%}
                  <a href="{{ settings.social_twitter_link }}" style="color: var(--6j-charcoal, #2C2C24); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 13px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    X
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>

        {%- if shop.customer_accounts_enabled -%}
          <div class="drawer-account">
            {%- if customer -%}
              <a href="{{ routes.account_url }}" class="drawer-account__btn drawer-account__btn--primary">
                <svg class="drawer-account__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                マイページ
              </a>
            {%- else -%}
              <a href="{{ routes.account_login_url }}" class="drawer-account__btn drawer-account__btn--primary">
                <svg class="drawer-account__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
                ログイン
              </a>
              <a href="{{ routes.account_register_url }}" class="drawer-account__btn drawer-account__btn--secondary">
                <svg class="drawer-account__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                新規登録
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </details>

<script>
(function() {
  var STORAGE_KEY = '6johan_recently_viewed';
  var MAX_DRAWER_ITEMS = 10;
  var rendered = false;

  function renderDrawerRecentlyViewed() {
    if (rendered) return;
    var section = document.getElementById('drawer-recently-viewed');
    var grid = document.getElementById('drawer-recently-viewed-grid');
    if (!section || !grid) return;

    var items = [];
    try {
      items = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
    } catch (e) {
      return;
    }

    if (items.length === 0) return;

    var display = items.slice(0, MAX_DRAWER_ITEMS);
    section.style.display = '';
    rendered = true;

    var html = '';
    for (var i = 0; i < display.length; i++) {
      var item = display[i];
      html += '<a href="' + item.url + '" style="flex: 0 0 70px; text-decoration: none;">' +
        '<img src="' + item.image + '" alt="' + item.title + '" style="width: 70px; height: 70px; object-fit: cover; border-radius: 4px; background: #FAF9F7; display: block;" loading="lazy">' +
        '<div style="font-size: 10px; font-weight: 500; color: #292724; margin-top: 4px; text-align: center;">' + item.price + '</div>' +
      '</a>';
    }
    grid.innerHTML = html;
  }

  // ハンバーガーメニューのクリックで描画
  document.addEventListener('click', function(e) {
    var menuBtn = e.target.closest('.header__icon--menu');
    if (menuBtn) {
      setTimeout(renderDrawerRecentlyViewed, 50);
    }
  });

  // フォールバック
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderDrawerRecentlyViewed);
  } else {
    renderDrawerRecentlyViewed();
  }
})();
</script>
</header-drawer>
