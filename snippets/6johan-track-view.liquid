{% comment %}
  6JOHAN Track Product View - Save to recently viewed
  使用方法: 商品ページのテンプレートに {% render '6johan-track-view', product: product %} を追加
{% endcomment %}

{%- liquid
  # 納期区分（商品詳細の配送BOX／6johan-delivery-badge.liquid と同一ロジック）
  assign _cv = product.selected_or_first_available_variant
  assign _sixj_state = 'unavailable'
  if _cv.available
    if _cv.inventory_management == 'shopify'
      if _cv.inventory_quantity > 0
        assign _sixj_state = 'instock'
      else
        assign _sixj_state = 'backorder'
      endif
    else
      assign _sixj_state = 'instock'
    endif
  endif
  assign _sixj_label = ''
  if _sixj_state == 'instock'
    assign _sixj_label = '最短7日で発送'
  elsif _sixj_state == 'backorder'
    assign _sixj_label = '約2〜3ヶ月'
    if product.id == 7212370067654 or product.id == 10986623435063 or product.id == 7089798054086
      assign _sixj_label = '約4ヶ月'
    endif
  endif
-%}
<script>
(function() {
  const STORAGE_KEY = '6johan_recently_viewed';
  const MAX_ITEMS = 20;
  
  // Product data from Liquid
  const product = {
    handle: '{{ product.handle }}',
    title: '{{ product.title | escape }}',
    url: '{{ product.url }}',
    image: '{{ product.featured_image | image_url: width: 400 }}',
    price: '{{ product.price | money }}',
    delivery: { type: '{{ _sixj_state }}', label: '{{ _sixj_label }}' },
    viewedAt: Date.now()
  };
  
  // Get existing items
  function getRecentlyViewed() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
    } catch (e) {
      return [];
    }
  }
  
  // Save to localStorage
  function saveRecentlyViewed(items) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
  }
  
  // Add current product to recently viewed
  function trackView() {
    let items = getRecentlyViewed();
    
    // Remove if already exists (to move to front)
    items = items.filter(item => item.handle !== product.handle);
    
    // Add to beginning
    items.unshift(product);
    
    // Limit to max items
    if (items.length > MAX_ITEMS) {
      items = items.slice(0, MAX_ITEMS);
    }
    
    saveRecentlyViewed(items);
  }
  
  // Track this view
  trackView();
})();
</script>
