{% comment %}
  6JOHAN Delivery Info
  カートボタン直後に表示するお届け目安＋補足情報
{% endcomment %}

<style>
.delivery-info {
  margin-top: 16px;
}

.delivery-estimate {
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: var(--6j-bg-sub, #FAF9F7);
  padding: 14px 16px;
  border-radius: 8px;
  margin-bottom: 12px;
}

.delivery-estimate__icon {
  width: 24px;
  height: 24px;
  color: var(--6j-accent, #6B5B4F);
  flex-shrink: 0;
}

.delivery-estimate__icon svg {
  width: 100%;
  height: 100%;
}

.delivery-estimate__content {
  flex: 1;
}

.delivery-estimate__title {
  font-size: 13px;
  font-weight: 500;
  color: var(--6j-text, #292724);
  margin-bottom: 2px;
}

.delivery-estimate__subtitle {
  font-size: 11px;
  color: var(--6j-text-sub, #807C76);
}

.supplement-info {
  font-size: 12px;
  color: var(--6j-text-sub, #807C76);
  line-height: 2;
}

.supplement-info__item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.supplement-info__icon {
  width: 14px;
  height: 14px;
  color: var(--6j-stock, #5E7A5E);
  flex-shrink: 0;
}

.supplement-info__icon svg {
  width: 100%;
  height: 100%;
}

@media (max-width: 749px) {
  .delivery-estimate {
    padding: 12px 14px;
    gap: 10px;
  }
  
  .delivery-estimate__icon {
    width: 20px;
    height: 20px;
  }
  
  .delivery-estimate__title {
    font-size: 12px;
  }
  
  .delivery-estimate__subtitle {
    font-size: 10px;
  }
  
  .supplement-info {
    font-size: 11px;
  }
}
</style>

{%- liquid
  assign is_in_stock = false
  assign delivery_days = '3〜5日'
  assign shipping_text = '受注生産 — お届けまで約3ヶ月'
  
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower == '即納' or tag_lower == 'in-stock' or tag_lower == 'in_stock'
      assign is_in_stock = true
    endif
  endfor
  
  for collection in product.collections
    if collection.handle == '即納商品' or collection.handle == 'in-stock'
      assign is_in_stock = true
    endif
  endfor
  
  if is_in_stock == false
    if product.available
      assign total_inventory = 0
      for variant in product.variants
        assign total_inventory = total_inventory | plus: variant.inventory_quantity
      endfor
      if total_inventory > 0
        assign is_in_stock = true
      endif
    endif
  endif
  
  if is_in_stock
    assign today = 'now' | date: '%s'
    assign delivery_start = today | plus: 259200 | date: '%m月%d日'
    assign delivery_end = today | plus: 432000 | date: '%m月%d日'
    assign shipping_text = '在庫あり — 7日以内に発送'
  endif
  
  # 組み立て判定
  assign needs_assembly = true
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower == '完成品' or tag_lower == 'assembled' or tag_lower == 'no-assembly'
      assign needs_assembly = false
    endif
  endfor
  
  if product.metafields.custom.is_assembly != blank
    if product.metafields.custom.is_assembly == false
      assign needs_assembly = false
    endif
  endif
-%}

<div class="delivery-info">
  <div class="delivery-estimate">
    <div class="delivery-estimate__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
    </div>
    <div class="delivery-estimate__content">
      {% if is_in_stock %}
        <div class="delivery-estimate__title">お届け目安: {{ delivery_start }}〜{{ delivery_end }}</div>
      {% else %}
        <div class="delivery-estimate__title">お届け目安: ご注文から約3ヶ月</div>
      {% endif %}
      <div class="delivery-estimate__subtitle">{{ shipping_text }}</div>
    </div>
  </div>
  
  <div class="supplement-info">
    <div class="supplement-info__item">
      <span class="supplement-info__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span>全国送料 ¥2,200〜（税込）</span>
    </div>
    <div class="supplement-info__item">
      <span class="supplement-info__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      {% if needs_assembly %}
        <span>組み立て式（工具付属・約15分）</span>
      {% else %}
        <span>完成品でお届け（組み立て不要）</span>
      {% endif %}
    </div>
    <div class="supplement-info__item">
      <span class="supplement-info__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span>返品・交換 到着後30日間OK</span>
    </div>
  </div>
</div>
