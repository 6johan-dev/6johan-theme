{%- comment -%}
  6JOHAN LINE 友だち追加バンド（フッター設置用）
  URL: https://line.me/R/ti/p/@505xknxn
  注意: テーマの 6johan-custom.css に [class*="sixj-"] / [class*="6johan"] { background:#fff !important } が
        あるため、クラス名にその接頭辞を使わない（j6line- を使用）。
{%- endcomment -%}
<style>
  .j6line-band {
    background: #faf8f5;
    border-top: 1px solid #e2dcd3;
    padding: 44px 20px 46px;
    text-align: center;
  }
  .j6line-band__inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .j6line-band__eyebrow {
    margin: 0 0 14px;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: #a08460;
    text-transform: uppercase;
  }
  .j6line-band__title {
    margin: 0 0 10px;
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif JP", serif;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #292724;
    line-height: 1.5;
  }
  .j6line-band__title em {
    font-style: normal;
  }
  .j6line-band__text {
    margin: 0 0 22px;
    font-size: 12px;
    line-height: 1.9;
    color: #786e6a;
    letter-spacing: 0.02em;
  }
  .j6line-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 30px;
    background: #292724;
    color: #faf8f5;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s ease, opacity 0.2s ease;
  }
  .j6line-band__btn:hover {
    background: #6b5b4f;
    color: #faf8f5;
  }
  .j6line-band__btn svg {
    display: block;
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }
  .j6line-band__note {
    margin: 14px 0 0;
    font-size: 10px;
    color: #9a938c;
    letter-spacing: 0.04em;
  }
  @media screen and (max-width: 749px) {
    .j6line-band {
      padding: 34px 18px 36px;
    }
    .j6line-band__title {
      font-size: 18px;
    }
    .j6line-band__text {
      font-size: 11.5px;
      margin-bottom: 18px;
    }
    .j6line-band__btn {
      width: 100%;
      max-width: 330px;
      padding: 15px 20px;
    }
  }
</style>

<div class="j6line-band">
  <div class="j6line-band__inner">
    <p class="j6line-band__eyebrow">LINE Official</p>
    <p class="j6line-band__title">LINE登録で<em>2,000円OFF</em>クーポン</p>
    <p class="j6line-band__text">
      ¥30,000以上のご購入で使えるクーポンと、再入荷のお知らせをお届けします。<br>
      サイズ・納期のご相談もLINEで承ります。
    </p>
    <a
      class="j6line-band__btn"
      href="https://line.me/R/ti/p/@505xknxn"
      target="_blank"
      rel="noopener"
      aria-label="6JOHAN公式LINEを友だち追加（LINE登録で2,000円OFFクーポン）"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M12 2C6.5 2 2 5.7 2 10.3c0 4.1 3.6 7.5 8.5 8.2.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c-.1.3-.3 1.2 1 .6 1.3-.5 7-4.1 9.5-7 1.7-1.9 1.7-3.7 1.7-4.2C23.5 5.7 17.5 2 12 2zm-4.6 11.2H5.6c-.3 0-.5-.2-.5-.5V8.6c0-.3.2-.5.5-.5s.5.2.5.5v3.6h1.3c.3 0 .5.2.5.5s-.2.5-.5.5zm2-1.1c0 .3-.2.5-.5.5s-.5-.2-.5-.5V8.6c0-.3.2-.5.5-.5s.5.2.5.5v3.5zm4.5 0c0 .2-.1.4-.3.5h-.2c-.1 0-.3-.1-.4-.2l-1.8-2.4v2.1c0 .3-.2.5-.5.5s-.5-.2-.5-.5V8.6c0-.2.1-.4.3-.5.2-.1.4 0 .6.2l1.8 2.4V8.6c0-.3.2-.5.5-.5s.5.2.5.5v3.5zm3.2-2.2c.3 0 .5.2.5.5s-.2.5-.5.5h-1.3v.5h1.3c.3 0 .5.2.5.5s-.2.5-.5.5h-1.8c-.3 0-.5-.2-.5-.5V8.6c0-.3.2-.5.5-.5h1.8c.3 0 .5.2.5.5s-.2.5-.5.5h-1.3v.5h1.3z"/>
      </svg>
      LINEで友だち追加
    </a>
    <p class="j6line-band__note">クーポンコードは追加後のトークに届きます（お一人さま1回）</p>
  </div>
</div>
