{% comment %}
  6JOHAN Trust Grid
  価格直下に表示する4列グリッド信頼バッジ（ワイヤーフレーム準拠）
{% endcomment %}

<style>
.trust-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  background-color: var(--6j-bg-sub, #FAF9F7);
  padding: 16px;
  border-radius: 0;
  margin: 16px 0;
}

.trust-grid__item {
  text-align: center;
}

.trust-grid__icon {
  width: 24px;
  height: 24px;
  margin: 0 auto 6px;
  color: var(--6j-accent, #6B5B4F);
}

.trust-grid__icon svg {
  width: 100%;
  height: 100%;
}

.trust-grid__text {
  font-size: 10px;
  color: var(--6j-text-sub, #807C76);
  line-height: 1.3;
}

@media (max-width: 749px) {
  .trust-grid {
    padding: 12px;
    gap: 6px;
  }
  
  .trust-grid__icon {
    width: 20px;
    height: 20px;
    margin-bottom: 4px;
  }
  
  .trust-grid__text {
    font-size: 9px;
  }
}
</style>

{%- comment -%}
  納期区分は配送BOX・カートの properties[配送区分] と共通の判定ソース（6johan-delivery-state）を使う。
  以前は「全バリエーションの在庫合計 > 0 なら即納」で判定していたため、既定バリエーションが
  受注生産の商品（ウッドサークルテーブル等）でも「最短7日発送」と表示され、カートの
  「受注生産品（お届けまで約4ヶ月）」と食い違っていた。
{%- endcomment -%}
{%- capture _ds -%}{%- render '6johan-delivery-state', product: product -%}{%- endcapture -%}
{%- assign _ds = _ds | split: '|' -%}
{%- assign _sixj_state = _ds[0] -%}
{%- assign _sixj_lead = _ds[1] -%}

{%- assign delivery_text = '最短7日発送' -%}
{%- if _sixj_state == 'backorder' -%}
  {%- assign delivery_text = 'お届けまで' | append: _sixj_lead -%}
{%- elsif _sixj_state == 'unavailable' -%}
  {%- assign delivery_text = '在庫切れ' -%}
{%- endif -%}

<div class="trust-grid">
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"/>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
        <circle cx="5.5" cy="18.5" r="2.5"/>
        <circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </div>
    <div class="trust-grid__text" data-sixj-delivery-text>{{ delivery_text }}</div>
  </div>
  
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
      </svg>
    </div>
    <div class="trust-grid__text">30日返品OK</div>
  </div>
  
  
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </div>
    <div class="trust-grid__text">相談OK</div>
  </div>
</div>

<script>
  /* 配送BOXのバリアント変更に合わせて、価格直下の納期表示も切り替える */
  (function () {
    var LABELS = {
      instock: '最短7日発送',
      backorder: 'お届けまで{{ _sixj_lead }}',
      unavailable: '在庫切れ'
    };
    window.sixjSetDeliveryState = function (state) {
      var el = document.querySelector('[data-sixj-delivery-text]');
      if (!el || !LABELS[state]) return;
      el.textContent = LABELS[state];
    };
  })();
</script>
