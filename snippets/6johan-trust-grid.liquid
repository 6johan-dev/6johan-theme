{% comment %}
  6JOHAN Trust Grid
  価格直下に表示する4列グリッド信頼バッジ（ワイヤーフレーム準拠）
{% endcomment %}

<style>
.trust-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  background-color: var(--6j-bg-sub, #FAF9F7);
  padding: 16px;
  border-radius: 8px;
  margin: 16px 0;
}

.trust-grid__item {
  text-align: center;
}

.trust-grid__icon {
  width: 24px;
  height: 24px;
  margin: 0 auto 6px;
  color: var(--6j-accent, #6B5B4F);
}

.trust-grid__icon svg {
  width: 100%;
  height: 100%;
}

.trust-grid__text {
  font-size: 10px;
  color: var(--6j-text-sub, #807C76);
  line-height: 1.3;
}

@media (max-width: 749px) {
  .trust-grid {
    padding: 12px;
    gap: 6px;
  }
  
  .trust-grid__icon {
    width: 20px;
    height: 20px;
    margin-bottom: 4px;
  }
  
  .trust-grid__text {
    font-size: 9px;
  }
}
</style>

{%- liquid
  assign is_in_stock = false
  assign delivery_text = '7日以内発送'
  
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower == '即納' or tag_lower == 'in-stock' or tag_lower == 'in_stock'
      assign is_in_stock = true
    endif
  endfor
  
  for collection in product.collections
    if collection.handle == '即納商品' or collection.handle == 'in-stock'
      assign is_in_stock = true
    endif
  endfor
  
  if is_in_stock == false
    if product.available
      assign total_inventory = 0
      for variant in product.variants
        assign total_inventory = total_inventory | plus: variant.inventory_quantity
      endfor
      if total_inventory > 0
        assign delivery_text = "即納"
        assign is_in_stock = true
      else
        assign delivery_text = '約3ヶ月'
      endif
    endif
  endif
-%}

<div class="trust-grid">
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"/>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
        <circle cx="5.5" cy="18.5" r="2.5"/>
        <circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </div>
    <div class="trust-grid__text">{{ delivery_text }}</div>
  </div>
  
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
      </svg>
    </div>
    <div class="trust-grid__text">30日返品OK</div>
  </div>
  
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <div class="trust-grid__text">1年保証</div>
  </div>
  
  <div class="trust-grid__item">
    <div class="trust-grid__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </div>
    <div class="trust-grid__text">相談OK</div>
  </div>
</div>
