{% comment %}
  6JOHAN Sticky Cart Bar
  固定カートバー — スクロール時に画面下部に表示

  Phase 1 (2026-11-20):
   - 価格の下に安心材料を1行追加（在庫あり=最短7日発送／受注生産=受注生産、いずれも30日返品OK。
     納期の月数は直上の配送BOXが持つため、バーでは矛盾しない短い表現にする）
   - 押下を GA4 `sticky_cart_click` として送信（gtag / dataLayer / Shopify analytics の順で利用可能なもの）

  Phase 2 (2026-11-21):
   - 追従バー表示中に Channel Talk のチャットバブル（右下・約60px）が右端のお気に入り♡ボタンへ
     重なる問題を解消。CTのランチャーは読み込み経路により通常DOM／シャドウDOM／iframe内と
     まちまちで、外から bottom を動かしても再適用されるため、バー右側に84pxの余白を確保して
     物理的に重ならないようにした（♡ボタンはページ内のお気に入りと重複するためバーから外す）。
{% endcomment %}

{%- style -%}
.sticky-cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #fff;
  border-top: 1px solid var(--6j-sand, #E8E5DC);
  box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.sticky-cart-bar--visible {
  transform: translateY(0);
}
.sticky-cart-bar__price {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sticky-cart-bar__trust {
  margin-top: 2px;
  font-size: 10px;
  line-height: 1.3;
  color: var(--6j-stone, #8A7A7A);
  white-space: nowrap;
}
.sticky-cart-bar__price-current {
  font-size: 18px;
  font-weight: 700;
  color: var(--6j-charcoal, #2C2C24);
  line-height: 1.2;
  white-space: nowrap;
}
.sticky-cart-bar__price-compare {
  font-size: 12px;
  color: var(--6j-stone, #8A8A7A);
  text-decoration: line-through;
  line-height: 1;
}
.sticky-cart-bar__cart-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  background: var(--6j-accent, #6B5B4F);
  color: #fff;
  border: none;
  border-radius: 0;
  font-size: 15px;
  font-weight: 600;
  font-family: var(--6j-font-body);
  cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}
.sticky-cart-bar__cart-btn:hover {
  background: var(--6j-charcoal, #2C2C24);
}
.sticky-cart-bar__cart-btn:disabled {
  background: var(--6j-sand, #E8E5DC);
  color: var(--6j-stone, #8A8A7A);
  cursor: not-allowed;
}
.sticky-cart-bar__cart-icon {
  width: 18px;
  height: 18px;
}
.sticky-cart-bar__fav-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border: 1px solid var(--6j-sand, #E8E5DC);
  border-radius: 0;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.2s;
}
.sticky-cart-bar__fav-btn:hover {
  border-color: var(--6j-charcoal, #2C2C24);
}
.sticky-cart-bar__fav-icon {
  width: 20px;
  height: 20px;
  color: var(--6j-stone, #8A8A7A);
  transition: all 0.2s;
}
.sticky-cart-bar__fav-btn.is-favorited .sticky-cart-bar__fav-icon {
  color: #E05A5A;
  fill: #E05A5A;
}
body.sticky-cart-active {
  padding-bottom: 72px;
}

/*
  Channel Talk のチャットバブル（画面右下・約60px）と追従バーの右端が重ならないよう、
  バーの右側にバブル分の余白を確保する。バブルはCT側の実装（iframe内／シャドウDOM内）で
  位置を外から動かせないことがあるため、レイアウト側で空ける。
  併せて、ページ内の「お気に入りに追加」と重複する♡ボタンはバーから外す（確保した余白を
  ボタンに使うとカートボタンが細くなりすぎるため）。
*/
@media screen and (max-width: 989px) {
  .sticky-cart-bar {
    padding-right: 84px;
  }
  .sticky-cart-bar__fav-btn {
    display: none;
  }
  /* 空けた余白のぶんカートボタンが細くなるため、ラベルを短くして収める */
  .sticky-cart-bar__cart-btn {
    font-size: 14px;
    padding: 14px 12px;
    min-width: 0;
  }
}

@media (min-width: 990px) {
  .sticky-cart-bar { display: none; }
  body.sticky-cart-active { padding-bottom: 0; }
}
{%- endstyle -%}

<div class="sticky-cart-bar" id="stickyCartBar" aria-hidden="true">
  <div class="sticky-cart-bar__price">
    {%- if product.compare_at_price > product.price -%}
      <div class="sticky-cart-bar__price-compare">{{ product.compare_at_price | money }}</div>
    {%- endif -%}
    <div class="sticky-cart-bar__price-current" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</div>
    <div class="sticky-cart-bar__trust" data-sticky-trust></div>
  </div>

  <button type="button" class="sticky-cart-bar__cart-btn" id="stickyCartBtn"
    {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
    <svg class="sticky-cart-bar__cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
    </svg>
    {%- if product.selected_or_first_available_variant.available -%}
      カートに追加
    {%- else -%}
      売り切れ
    {%- endif -%}
  </button>

  <button type="button" class="sticky-cart-bar__fav-btn" id="stickyFavBtn" aria-label="お気に入りに追加">
    <svg class="sticky-cart-bar__fav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </button>
</div>

<script>
(function() {
  var stickyBar = document.getElementById('stickyCartBar');
  var stickyBtn = document.getElementById('stickyCartBtn');
  var stickyFavBtn = document.getElementById('stickyFavBtn');
  if (!stickyBar) return;

  var productHandle = {{ product.handle | json }};
  var trustEl = stickyBar.querySelector('[data-sticky-trust]');

  /* 納期区分（配送BOXの表示状態を正とする。納期は在庫/受注生産で矛盾しない表現にする） */
  function currentDeliveryState() {
    var box = document.getElementById('sixj-delivery-box');
    if (box) {
      var back = box.querySelector('.sixj-dbox--backorder');
      var inst = box.querySelector('.sixj-dbox--instock');
      if (back && back.style.display !== 'none') return 'backorder';
      if (inst && inst.style.display !== 'none') return 'instock';
      return 'unavailable';
    }
    return 'instock';
  }

  function trustText(state) {
    if (state === 'backorder') return '受注生産・30日返品OK';
    if (state === 'unavailable') return '30日返品OK';
    return '最短7日発送・30日返品OK';
  }

  function syncTrust() {
    if (trustEl) trustEl.textContent = trustText(currentDeliveryState());
  }

  /* GA4 計測: sticky_cart_click
     このテーマには gtag.js を直接埋めていない（GA4はGoogle & YouTubeアプリのWebピクセル側）ため、
     利用可能な送信先に順に送る。送れない場合も押下体験は止めない。 */
  function sixjTrack(name, params) {
    try {
      if (typeof window.gtag === 'function') {
        window.gtag('event', name, params);
      } else if (window.dataLayer && typeof window.dataLayer.push === 'function') {
        var payload = { event: name };
        for (var k in params) { if (Object.prototype.hasOwnProperty.call(params, k)) payload[k] = params[k]; }
        window.dataLayer.push(payload);
      }
    } catch (e) {}
    try {
      if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
        window.Shopify.analytics.publish(name, params);
      }
    } catch (e) {}
    try {
      document.dispatchEvent(new CustomEvent('sixj:' + name, { detail: params }));
    } catch (e) {}
  }

  function priceYen() {
    var el = stickyBar.querySelector('[data-sticky-price]');
    if (!el) return 0;
    var digits = (el.textContent || '').replace(/[^0-9]/g, '');
    return digits ? parseInt(digits, 10) : 0;
  }

  syncTrust();
  document.addEventListener('change', function (e) {
    if (e.target && e.target.closest && e.target.closest('variant-radios, variant-selects, product-info')) {
      setTimeout(syncTrust, 250);
    }
  });

  function findMainCartBtn() {
    var forms = document.querySelectorAll('product-form form, form[action*="/cart/add"]');
    for (var i = 0; i < forms.length; i++) {
      var btn = forms[i].querySelector('[type="submit"], button[name="add"]');
      if (btn && !stickyBar.contains(btn)) return btn;
    }
    return null;
  }

  function initObserver() {
    var mainCartBtn = findMainCartBtn();
    if (!mainCartBtn) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          stickyBar.classList.add('sticky-cart-bar--visible');
          stickyBar.setAttribute('aria-hidden', 'false');
          document.body.classList.add('sticky-cart-active');
        } else {
          stickyBar.classList.remove('sticky-cart-bar--visible');
          stickyBar.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('sticky-cart-active');
        }
      }, { passive: true });
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          stickyBar.classList.remove('sticky-cart-bar--visible');
          stickyBar.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('sticky-cart-active');
        } else {
          stickyBar.classList.add('sticky-cart-bar--visible');
          stickyBar.setAttribute('aria-hidden', 'false');
          document.body.classList.add('sticky-cart-active');
        }
      });
    }, { threshold: 0 });

    observer.observe(mainCartBtn);
  }

  stickyBtn.addEventListener('click', function() {
    if (stickyBtn.disabled) return;
    var state = currentDeliveryState();
    sixjTrack('sticky_cart_click', {
      method: 'sticky_bar',
      product_handle: productHandle,
      delivery_state: state,
      price: priceYen(),
      currency: 'JPY',
      quantity: 1
    });
    var realBtn = findMainCartBtn();
    if (realBtn) realBtn.click();
  });

  if (stickyFavBtn) {
    var handle = productHandle;
    var STORAGE_KEY = '6johan_favorites';

    function isFav() {
      try {
        var favs = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        return favs.some(function(f) { return f.handle === handle; });
      } catch(e) { return false; }
    }

    function updateUI() {
      stickyFavBtn.classList.toggle('is-favorited', isFav());
    }

    stickyFavBtn.addEventListener('click', function() {
      var mainFavBtn = document.querySelector('.favorite-btn');
      if (mainFavBtn) {
        mainFavBtn.click();
        setTimeout(updateUI, 100);
      }
    });

    updateUI();
    window.addEventListener('storage', updateUI);
  }

  document.addEventListener('change', function(e) {
    if (e.target.closest('.product-form__input')) {
      setTimeout(function() {
        var priceEl = document.querySelector('.price-item--regular, .price-item--sale');
        var stickyPrice = stickyBar.querySelector('[data-sticky-price]');
        if (priceEl && stickyPrice) stickyPrice.textContent = priceEl.textContent.trim();
      }, 200);
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initObserver);
  } else {
    initObserver();
  }
})();
</script>
