{% comment %}
  6JOHAN Inventory Alert
  数量セレクター上部に表示する在庫状況 + 在庫超過アラート
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign inventory_qty = current_variant.inventory_quantity
  assign is_in_stock = false
  
  if inventory_qty > 0
    assign is_in_stock = true
  endif
-%}

<style>
.inventory-alert {
  margin-bottom: 12px;
}

.inventory-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: 0;
  font-size: 13px;
  font-weight: 500;
}

.inventory-status--in-stock {
  background-color: rgba(94, 122, 94, 0.1);
  color: #5E7A5E;
}

.inventory-status--backorder {
  background-color: rgba(90, 122, 154, 0.1);
  color: #5A7A9A;
}

.inventory-status--low {
  background-color: rgba(212, 128, 74, 0.1);
  color: #D4804A;
}

.inventory-status__icon {
  width: 16px;
  height: 16px;
}

.inventory-status__icon svg {
  width: 100%;
  height: 100%;
}

.backorder-notice {
  display: none;
  margin-top: 10px;
  padding: 12px 14px;
  background-color: rgba(90, 122, 154, 0.1);
  border: 1px solid rgba(90, 122, 154, 0.3);
  border-radius: 0;
  font-size: 12px;
  color: #5A7A9A;
  line-height: 1.5;
}

.backorder-notice.is-visible {
  display: block;
}

.backorder-notice__title {
  font-weight: 600;
  margin-bottom: 4px;
}

@media (max-width: 749px) {
  .inventory-status {
    font-size: 12px;
    padding: 6px 10px;
  }
  
  .backorder-notice {
    font-size: 11px;
    padding: 10px 12px;
  }
}
</style>

<div class="inventory-alert" data-inventory-alert data-max-inventory="{{ inventory_qty }}">
  {% if is_in_stock %}
    {% if inventory_qty <= 3 %}
      <div class="inventory-status inventory-status--low">
        <span class="inventory-status__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </span>
        <span>残りわずか（在庫 <strong>{{ inventory_qty }}点</strong>）</span>
      </div>
    {% else %}
      <div class="inventory-status inventory-status--in-stock">
        <span class="inventory-status__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span>在庫あり（<strong>{{ inventory_qty }}点</strong>）— 7日以内に発送</span>
      </div>
    {% endif %}
  {% else %}
    <div class="inventory-status inventory-status--backorder">
      <span class="inventory-status__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </span>
      <span>受注生産 — お届けまで約3ヶ月</span>
    </div>
  {% endif %}
  
  <div class="backorder-notice" data-backorder-notice>
    <div class="backorder-notice__title">📦 一部受注生産になります</div>
    <div>在庫数（<span data-stock-count>{{ inventory_qty }}</span>点）を超えた分は受注生産となり、お届けまで約3ヶ月かかります。</div>
  </div>
</div>

<script>
(function() {
  const initInventoryAlert = () => {
    const alertContainer = document.querySelector('[data-inventory-alert]');
    if (!alertContainer) return;
    
    const maxInventory = parseInt(alertContainer.dataset.maxInventory) || 0;
    const notice = alertContainer.querySelector('[data-backorder-notice]');
    if (!notice || maxInventory <= 0) return;
    
    // 数量入力を監視
    const quantityInput = document.querySelector('input[name="quantity"], input.quantity__input');
    if (!quantityInput) return;
    
    const checkQuantity = () => {
      const qty = parseInt(quantityInput.value) || 1;
      if (qty > maxInventory) {
        notice.classList.add('is-visible');
      } else {
        notice.classList.remove('is-visible');
      }
    };
    
    quantityInput.addEventListener('change', checkQuantity);
    quantityInput.addEventListener('input', checkQuantity);
    
    // +/- ボタンのクリックも監視
    const quantityButtons = document.querySelectorAll('.quantity__button');
    quantityButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        setTimeout(checkQuantity, 50);
      });
    });
    
    // バリアント変更時に在庫数を更新
    document.addEventListener('variant:changed', (e) => {
      if (e.detail && e.detail.variant) {
        const newInventory = e.detail.variant.inventory_quantity || 0;
        alertContainer.dataset.maxInventory = newInventory;
        const stockCount = notice.querySelector('[data-stock-count]');
        if (stockCount) stockCount.textContent = newInventory;
        checkQuantity();
      }
    });
  };
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInventoryAlert);
  } else {
    initInventoryAlert();
  }
})();
</script>
