{%- comment -%}
  6JOHAN LINE 導線（商品ページ・購入検討エリア下部の小さな1行リンク）
  注意: テーマの 6johan-custom.css に [class*="sixj-"] / [class*="6johan"] { background:#fff !important } が
        あるため、クラス名にその接頭辞を使わない（j6line- を使用）。
{%- endcomment -%}
<style>
  .j6line-inline {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 20px 0 0;
    padding: 12px 14px;
    background: #faf8f5;
    border: 1px solid #e2dcd3;
    border-radius: 2px;
    color: #4a4642;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .j6line-inline:hover {
    background: #f6f2ec;
    border-color: #cfc5b8;
    color: #292724;
  }
  .j6line-inline__tag {
    flex: 0 0 auto;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: #a08460;
    border: 1px solid #d9cbb6;
    border-radius: 2px;
    padding: 3px 6px 2px;
    line-height: 1;
  }
  .j6line-inline__body {
    flex: 1 1 auto;
    min-width: 0;
  }
  .j6line-inline__lead {
    display: block;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: #9a938c;
    line-height: 1.5;
  }
  .j6line-inline__text {
    display: block;
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.01em;
  }
  .j6line-inline__price {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #a08460;
    white-space: nowrap;
  }
  .j6line-inline__arrow {
    flex: 0 0 auto;
    font-size: 12px;
    color: #a08460;
  }
  @media screen and (max-width: 749px) {
    .j6line-inline {
      margin: 16px 0 0;
      padding: 11px 10px;
      gap: 8px;
    }
    .j6line-inline__text {
      font-size: 11px;
    }
    .j6line-inline__price {
      font-size: 10px;
    }
    .j6line-inline__tag {
      font-size: 8.5px;
      padding: 2px 5px;
    }
  }
</style>

<a
  class="j6line-inline"
  href="https://line.me/R/ti/p/@505xknxn"
  target="_blank"
  rel="noopener"
  aria-label="6JOHAN公式LINEへ（再入荷の通知と2,000円OFFクーポン）"
>
  <span class="j6line-inline__tag">LINE</span>
  <span class="j6line-inline__body">
    <span class="j6line-inline__lead">じっくり検討中の方へ</span>
    <span class="j6line-inline__text">再入荷・限定クーポンはLINE公式へ</span>
  </span>
  <span class="j6line-inline__price">¥2,000 OFF</span>
  <span class="j6line-inline__arrow" aria-hidden="true">→</span>
</a>
