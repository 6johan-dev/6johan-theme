{% comment %}
  6JOHAN PDP Badges
  商品ページ価格直下のステータスバッジ

  使用方法: {% render '6johan-pdp-badges', product: product %}

  判定ロジックは sections/6johan-product-status.liquid と同等。
  snippet 化することで main-product.liquid から価格直下に埋め込み可能。
{% endcomment %}

<style>
.pdp-badges {
  margin: 4px 0 16px;
}

.pdp-badges__list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.pdp-badges__badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 4px;
  white-space: nowrap;
  font-family: var(--6j-font-body);
}

.pdp-badges__icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

.pdp-badges__icon svg {
  width: 100%;
  height: 100%;
}

.pdp-badges__badge--in-stock {
  background-color: rgba(94, 122, 94, 0.12);
  color: #5E7A5E;
}

.pdp-badges__badge--backorder {
  background-color: rgba(90, 122, 154, 0.12);
  color: #5A7A9A;
}

.pdp-badges__badge--popular {
  background-color: rgba(196, 149, 106, 0.15);
  color: #C4956A;
}

.pdp-badges__badge--new {
  background-color: rgba(41, 39, 36, 0.1);
  color: #292724;
}

.pdp-badges__badge--low-stock {
  background-color: rgba(212, 128, 74, 0.12);
  color: #D4804A;
}

.pdp-badges__badge--sold-out {
  background-color: rgba(107, 91, 79, 0.12);
  color: #807C76;
}

@media (max-width: 749px) {
  .pdp-badges__badge {
    padding: 4px 8px;
    font-size: 10px;
  }

  .pdp-badges__icon {
    width: 11px;
    height: 11px;
  }
}
</style>

{%- liquid
  assign is_in_stock = false
  assign is_made_to_order = false
  assign is_popular = false
  assign is_new = false
  assign is_low_stock = false

  assign now_ts = 'now' | date: '%s'
  assign product_ts = product.created_at | date: '%s'
  assign diff_seconds = now_ts | minus: product_ts
  assign thirty_days = 2592000
  if diff_seconds < thirty_days
    assign is_new = true
  endif

  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower == '即納' or tag_lower == 'in-stock' or tag_lower == 'in_stock'
      assign is_in_stock = true
    endif
    if tag_lower == '受注生産' or tag_lower == 'made-to-order' or tag_lower == 'made_to_order'
      assign is_made_to_order = true
    endif
    if tag_lower == '人気' or tag_lower == 'popular' or tag_lower == 'bestseller'
      assign is_popular = true
    endif
    if tag_lower == '残りわずか' or tag_lower == 'low-stock' or tag_lower == 'limited'
      assign is_low_stock = true
    endif
  endfor

  for collection in product.collections
    if collection.handle == '即納商品' or collection.handle == 'in-stock'
      assign is_in_stock = true
    endif
    if collection.handle == 'pick-up' or collection.handle == 'bestsellers'
      assign is_popular = true
    endif
  endfor

  if is_in_stock == false and is_made_to_order == false
    if product.available
      assign total_inventory = 0
      for variant in product.variants
        if variant.inventory_quantity > 0
          assign total_inventory = total_inventory | plus: variant.inventory_quantity
        endif
      endfor
      if total_inventory > 0
        assign is_in_stock = true
        if total_inventory <= 3
          assign is_low_stock = true
        endif
      else
        assign is_made_to_order = true
      endif
    endif
  endif

  assign show_badges = false
  if is_popular or is_new or is_low_stock or is_in_stock or is_made_to_order or product.available == false
    assign show_badges = true
  endif
-%}

{% if show_badges %}
<div class="pdp-badges">
  <div class="pdp-badges__list">

    {% if product.available == false %}
      <span class="pdp-badges__badge pdp-badges__badge--sold-out">
        <span class="pdp-badges__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
          </svg>
        </span>
        SOLD OUT
      </span>
    {% else %}

      {% if is_popular %}
        <span class="pdp-badges__badge pdp-badges__badge--popular">
          <span class="pdp-badges__icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </span>
          人気
        </span>
      {% endif %}

      {% if is_new and is_popular == false %}
        <span class="pdp-badges__badge pdp-badges__badge--new">NEW</span>
      {% endif %}

      {% if is_low_stock %}
        <span class="pdp-badges__badge pdp-badges__badge--low-stock">
          <span class="pdp-badges__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </span>
          残りわずか
        </span>
      {% elsif is_in_stock %}
        <span class="pdp-badges__badge pdp-badges__badge--in-stock">
          <span class="pdp-badges__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
          即納
        </span>
      {% elsif is_made_to_order %}
        <span class="pdp-badges__badge pdp-badges__badge--backorder">
          <span class="pdp-badges__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </span>
          受注生産
        </span>
      {% endif %}

    {% endif %}
  </div>
</div>
{% endif %}
