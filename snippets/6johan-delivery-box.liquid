{%- comment -%}
  6JOHAN Delivery Box — 統合配送・在庫表示 v2
  配置: バリアントセレクター直下、カートボタン直上
{%- endcomment -%}

{%- assign cv = product.selected_or_first_available_variant -%}

{%- comment -%} Liquid側で全バリアントの在庫状態を事前計算 {%- endcomment -%}
<script type="application/json" id="sixj-variant-states-{{ product.id }}">
{
  {%- for v in product.variants -%}
    "{{ v.id }}": {
      "state": "{%- if v.available -%}{%- if v.inventory_management == 'shopify' -%}{%- if v.inventory_quantity > 0 -%}instock{%- else -%}backorder{%- endif -%}{%- else -%}instock{%- endif -%}{%- else -%}unavailable{%- endif -%}",
      "qty": {{ v.inventory_quantity | default: 0 }},
      "options": {{ v.options | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
}
</script>

{%- comment -%} 初期表示の状態を判定 {%- endcomment -%}
{%- assign stock_state = 'unavailable' -%}
{%- if cv.available -%}
  {%- if cv.inventory_management == 'shopify' -%}
    {%- if cv.inventory_quantity > 0 -%}
      {%- assign stock_state = 'instock' -%}
    {%- else -%}
      {%- assign stock_state = 'backorder' -%}
    {%- endif -%}
  {%- else -%}
    {%- assign stock_state = 'instock' -%}
  {%- endif -%}
{%- endif -%}

<div id="sixj-delivery-box" class="sixj-dbox" data-product-id="{{ product.id }}">
  {%- comment -%} 在庫あり {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--instock" {% if stock_state != 'instock' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3A6A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--instock">在庫あり — <span class="sixj-dbox__date"></span>までに発送</div>
      <div class="sixj-dbox__sub sixj-dbox__sub--instock">30日間返品OK</div>
    </div>
  </div>

  {%- comment -%} 受注生産 {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--backorder" {% if stock_state != 'backorder' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B5B4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="12" cy="15" r="2"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--backorder">受注生産 — お届けまで約4ヶ月</div>
      <div class="sixj-dbox__sub sixj-dbox__sub--backorder">ご注文後にお作りいたします</div>
    </div>
  </div>

  {%- comment -%} 在庫切れ {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--unavailable" {% if stock_state != 'unavailable' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8A7A6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--unavailable">現在お取り扱いしておりません</div>
    </div>
  </div>
</div>

<script>
(function() {
  var productId = '{{ product.id }}';
  var deliveryBox = document.getElementById('sixj-delivery-box');
  if (!deliveryBox) return;

  var statesEl = document.getElementById('sixj-variant-states-' + productId);
  if (!statesEl) return;
  var variantStates = JSON.parse(statesEl.textContent);

  /* --- 日付計算 --- */
  function getDeliveryDate() {
    var d = new Date();
    d.setDate(d.getDate() + 7);
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return m + '月' + day + '日';
  }
  document.querySelectorAll('.sixj-dbox__date').forEach(function(el) {
    el.textContent = getDeliveryDate();
  });

  /* --- 配送ボックス切替 --- */
  function updateDeliveryBox(state) {
    deliveryBox.querySelector('.sixj-dbox--instock').style.display = 'none';
    deliveryBox.querySelector('.sixj-dbox--backorder').style.display = 'none';
    deliveryBox.querySelector('.sixj-dbox--unavailable').style.display = 'none';
    var target = deliveryBox.querySelector('.sixj-dbox--' + state);
    if (target) target.style.display = 'flex';
    updateBackorderNote(state);
  }

  /* --- 配送区分の自動付与 v4 --- */
  function updateBackorderNote(state) {
    var prop = document.getElementById('sixj-delivery-prop');
    if (prop == null) return;
    if (state === 'backorder') {
      prop.value = '受注生産品（お届けまで約4ヶ月）';
    } else if (state === 'instock') {
      prop.value = '在庫品（最短7日発送）';
    }
  }

  /* --- バリアント変更検知 --- */
  function onVariantChange() {
    var params = new URLSearchParams(window.location.search);
    var vid = params.get('variant');
    if (vid && variantStates[vid]) {
      updateDeliveryBox(variantStates[vid].state);
    }
  }

  var origPush = history.pushState;
  history.pushState = function() {
    origPush.apply(history, arguments);
    setTimeout(onVariantChange, 50);
  };
  var origReplace = history.replaceState;
  history.replaceState = function() {
    origReplace.apply(history, arguments);
    setTimeout(onVariantChange, 50);
  };
  window.addEventListener('popstate', function() {
    setTimeout(onVariantChange, 50);
  });
  document.querySelectorAll('variant-radios, variant-selects').forEach(function(el) {
    el.addEventListener('change', function() { setTimeout(onVariantChange, 100); });
  });

  /* --- 在庫ドット付与 --- */
  function addStockDots() {
    var fieldsets = document.querySelectorAll('variant-radios fieldset, variant-selects fieldset');
    if (!fieldsets.length) return;
    var allStates = Object.values(variantStates);

    fieldsets.forEach(function(fieldset, optionIndex) {
      var inputs = fieldset.querySelectorAll('input[type="radio"]');
      inputs.forEach(function(input) {
        var label = fieldset.querySelector('label[for="' + input.id + '"]');
        if (!label || label.querySelector('.sixj-stock-dot')) return;
        var optionValue = input.value;

        var hasStock = allStates.some(function(v) {
          return v.options[optionIndex] === optionValue && v.state === 'instock';
        });

        var dot = document.createElement('span');
        dot.className = 'sixj-stock-dot ' + (hasStock ? 'sixj-stock-dot--in' : 'sixj-stock-dot--out');
        dot.setAttribute('aria-hidden', 'true');
        label.appendChild(dot);
      });
    });
  }

  addStockDots();
  updateBackorderNote('{{ stock_state }}');
})();
</script>
