{%- comment -%}
  6JOHAN Delivery Box — 統合配送・在庫表示
  配置: バリアントセレクター直下、カートボタン直上
  置き換え: 6johan-product-status.liquid + 6johan-delivery-info.liquid
{%- endcomment -%}

{%- assign cv = product.selected_or_first_available_variant -%}
{%- assign has_tracking = false -%}
{%- if cv.inventory_management == 'shopify' -%}
  {%- assign has_tracking = true -%}
{%- endif -%}

{%- assign stock_state = 'unavailable' -%}
{%- if cv.available -%}
  {%- if has_tracking and cv.inventory_quantity > 0 -%}
    {%- assign stock_state = 'in_stock' -%}
  {%- elsif has_tracking == false -%}
    {%- assign stock_state = 'in_stock' -%}
  {%- elsif cv.available and has_tracking and cv.inventory_quantity <= 0 -%}
    {%- assign stock_state = 'backorder' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} 組立有無 {%- endcomment -%}
{%- assign is_assembly = product.metafields.custom.is_assembly | default: false -%}

<div
  id="sixj-delivery-box"
  class="sixj-dbox"
  data-product-id="{{ product.id }}"
  data-state="{{ stock_state }}"
>
  {%- comment -%} 在庫あり表示 {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--instock" {% if stock_state != 'in_stock' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3A6A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="1"/>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
        <circle cx="5.5" cy="18.5" r="2.5"/>
        <circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--instock">
        在庫あり — <span class="sixj-dbox__date"></span>までに発送
      </div>
      <div class="sixj-dbox__sub sixj-dbox__sub--instock">30日間返品OK・1年保証</div>
    </div>
  </div>

  {%- comment -%} 受注生産表示 {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--backorder" {% if stock_state != 'backorder' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B5B4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
        <circle cx="12" cy="15" r="2"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--backorder">受注生産 — お届けまで約3ヶ月</div>
      <div class="sixj-dbox__sub sixj-dbox__sub--backorder">ご注文後にお作りいたします</div>
    </div>
  </div>

  {%- comment -%} 在庫切れ表示 {%- endcomment -%}
  <div class="sixj-dbox__inner sixj-dbox--unavailable" {% if stock_state != 'unavailable' %}style="display:none"{% endif %}>
    <div class="sixj-dbox__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8A7A6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="15" y1="9" x2="9" y2="15"/>
        <line x1="9" y1="9" x2="15" y2="15"/>
      </svg>
    </div>
    <div class="sixj-dbox__text">
      <div class="sixj-dbox__main sixj-dbox__main--unavailable">現在お取り扱いしておりません</div>
    </div>
  </div>
</div>

<script>
(function() {
  const productData = {{ product | json }};
  const variants = productData.variants;
  const deliveryBox = document.getElementById('sixj-delivery-box');
  if (!deliveryBox) return;

  /* --- 日付計算 --- */
  function getDeliveryDate() {
    const d = new Date();
    d.setDate(d.getDate() + 7);
    return String(d.getMonth() + 1).padStart(2, '0') + '月' + String(d.getDate()).padStart(2, '0') + '日';
  }

  document.querySelectorAll('.sixj-dbox__date').forEach(function(el) {
    el.textContent = getDeliveryDate();
  });

  /* --- バリアント在庫状態の判定 --- */
  function getVariantState(variant) {
    if (!variant || !variant.available) return 'unavailable';
    if (variant.inventory_management === 'shopify' && variant.inventory_quantity > 0) return 'in_stock';
    if (variant.inventory_management === null || variant.inventory_management === '') return 'in_stock';
    if (variant.available && variant.inventory_management === 'shopify' && variant.inventory_quantity <= 0) return 'backorder';
    return 'unavailable';
  }

  /* --- 配送ボックス切替 --- */
  function updateDeliveryBox(state) {
    deliveryBox.dataset.state = state;
    var boxes = deliveryBox.querySelectorAll('.sixj-dbox__inner');
    boxes.forEach(function(b) { b.style.display = 'none'; });

    if (state === 'in_stock') {
      deliveryBox.querySelector('.sixj-dbox--instock').style.display = 'flex';
    } else if (state === 'backorder') {
      deliveryBox.querySelector('.sixj-dbox--backorder').style.display = 'flex';
    } else {
      deliveryBox.querySelector('.sixj-dbox--unavailable').style.display = 'flex';
    }
  }

  /* --- 在庫ドット付与 --- */
  function addStockDots() {
    var fieldsets = document.querySelectorAll('variant-radios fieldset, variant-selects fieldset');
    if (!fieldsets.length) return;

    fieldsets.forEach(function(fieldset, optionIndex) {
      var labels = fieldset.querySelectorAll('label:not(.sixj-dotted)');
      labels.forEach(function(label) {
        var input = document.getElementById(label.getAttribute('for'));
        if (!input) return;
        var optionValue = input.value;

        var hasStock = variants.some(function(v) {
          if (v.options[optionIndex] !== optionValue) return false;
          if (!v.available) return false;
          if (v.inventory_management === 'shopify' && v.inventory_quantity > 0) return true;
          if (v.inventory_management === null || v.inventory_management === '') return true;
          return false;
        });

        var dot = document.createElement('span');
        dot.className = 'sixj-stock-dot ' + (hasStock ? 'sixj-stock-dot--in' : 'sixj-stock-dot--out');
        label.appendChild(dot);
        label.classList.add('sixj-dotted');
      });
    });
  }

  /* --- バリアント変更リスナー --- */
  function onVariantChange() {
    var urlParams = new URLSearchParams(window.location.search);
    var variantId = urlParams.get('variant');
    if (!variantId) return;

    var variant = variants.find(function(v) { return String(v.id) === String(variantId); });
    if (variant) {
      updateDeliveryBox(getVariantState(variant));
    }
  }

  /* URL変更でバリアント検知（Dawn標準の挙動） */
  var pushState = history.pushState;
  history.pushState = function() {
    pushState.apply(history, arguments);
    setTimeout(onVariantChange, 50);
  };
  var replaceState = history.replaceState;
  history.replaceState = function() {
    replaceState.apply(history, arguments);
    setTimeout(onVariantChange, 50);
  };
  window.addEventListener('popstate', function() {
    setTimeout(onVariantChange, 50);
  });

  /* variant-radios のchangeイベント */
  document.querySelectorAll('variant-radios, variant-selects').forEach(function(el) {
    el.addEventListener('change', function() {
      setTimeout(onVariantChange, 100);
    });
  });

  /* 初期化 */
  addStockDots();
})();
</script>
