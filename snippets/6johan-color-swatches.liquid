{% comment %}
  6JOHAN Color Swatches
  商品カード用カラースウォッチ
  
  Usage:
  {% render '6johan-color-swatches', product: product %}
  {% render '6johan-color-swatches', product: product, max_swatches: 4 %}
{% endcomment %}

{%- style -%}
.color-swatches {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
}

.color-swatches__item {
  position: relative;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid var(--6j-sand, #E8E5DC);
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s;
  overflow: hidden;
}

.color-swatches__item:hover {
  transform: scale(1.15);
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.color-swatches__item.is-active {
  border-color: var(--6j-charcoal, #2C2C24);
  box-shadow: 0 0 0 2px var(--6j-linen, #FAFAF7), 0 0 0 3px var(--6j-charcoal, #2C2C24);
}

.color-swatches__swatch {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.color-swatches__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.color-swatches__more {
  font-size: 11px;
  color: var(--6j-stone, #8A8A7A);
  margin-left: 2px;
}

/* Tooltip */
.color-swatches__item::after {
  content: attr(data-color-name);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 8px;
  background-color: var(--6j-charcoal, #2C2C24);
  color: #fff;
  font-size: 10px;
  white-space: nowrap;
  border-radius: 3px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.15s, visibility 0.15s;
  pointer-events: none;
  z-index: 10;
}

.color-swatches__item:hover::after {
  opacity: 1;
  visibility: visible;
}

/* Color mappings */
.color-swatches__swatch--natural,
.color-swatches__swatch--ナチュラル {
  background-color: #D4C4A8;
}

.color-swatches__swatch--walnut,
.color-swatches__swatch--ウォールナット {
  background-color: #5C4033;
}

.color-swatches__swatch--oak,
.color-swatches__swatch--オーク {
  background-color: #C8A869;
}

.color-swatches__swatch--black,
.color-swatches__swatch--ブラック {
  background-color: #2C2C24;
}

.color-swatches__swatch--white,
.color-swatches__swatch--ホワイト {
  background-color: #FAFAF7;
}

.color-swatches__swatch--gray,
.color-swatches__swatch--grey,
.color-swatches__swatch--グレー {
  background-color: #8A8A7A;
}

.color-swatches__swatch--brown,
.color-swatches__swatch--ブラウン {
  background-color: #8B5A2B;
}

.color-swatches__swatch--beige,
.color-swatches__swatch--ベージュ {
  background-color: #E8DCC4;
}

.color-swatches__swatch--charcoal,
.color-swatches__swatch--チャコール {
  background-color: #3A3A32;
}

.color-swatches__swatch--vintage,
.color-swatches__swatch--ヴィンテージ {
  background: linear-gradient(135deg, #8B7355 0%, #6B5344 100%);
}

.color-swatches__swatch--navy,
.color-swatches__swatch--ネイビー {
  background-color: #2C3E50;
}

.color-swatches__swatch--green,
.color-swatches__swatch--グリーン {
  background-color: #6B8E6B;
}

.color-swatches__swatch--ash,
.color-swatches__swatch--アッシュ {
  background-color: #B2BEB5;
}
{%- endstyle -%}

{% assign max_swatches = max_swatches | default: 4 %}
{% assign color_option_index = nil %}

{% comment %} Find the color option {% endcomment %}
{% for option in product.options_with_values %}
  {% assign option_name_lower = option.name | downcase %}
  {% if option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'カラー' or option_name_lower == '色' %}
    {% assign color_option_index = forloop.index0 %}
    {% assign color_option = option %}
    {% break %}
  {% endif %}
{% endfor %}

{% if color_option_index != nil and color_option.values.size > 1 %}
  <div class="color-swatches">
    {% for value in color_option.values limit: max_swatches %}
      {% assign color_slug = value | handleize %}
      {% assign variant_for_color = nil %}
      
      {% comment %} Find variant with this color to get its image {% endcomment %}
      {% for variant in product.variants %}
        {% assign variant_color = variant.options[color_option_index] %}
        {% if variant_color == value %}
          {% assign variant_for_color = variant %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      <a
        href="{{ product.url }}?variant={{ variant_for_color.id }}"
        class="color-swatches__item{% if forloop.first %} is-active{% endif %}"
        data-color-name="{{ value }}"
        title="{{ value }}"
        aria-label="{{ value }}"
      >
        {% if variant_for_color.featured_image %}
          <img
            src="{{ variant_for_color.featured_image | image_url: width: 50 }}"
            alt="{{ value }}"
            class="color-swatches__image"
            loading="lazy"
            width="18"
            height="18"
          >
        {% else %}
          <span class="color-swatches__swatch color-swatches__swatch--{{ color_slug }}"></span>
        {% endif %}
      </a>
    {% endfor %}
    
    {% assign remaining = color_option.values.size | minus: max_swatches %}
    {% if remaining > 0 %}
      <span class="color-swatches__more">+{{ remaining }}</span>
    {% endif %}
  </div>
{% endif %}
