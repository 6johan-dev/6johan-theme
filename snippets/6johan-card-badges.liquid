{% comment %}
  6JOHAN Card Badges
  商品カード用バッジ（一覧ページ用）
  
  使用方法: {% render '6johan-card-badges', product: card_product %}
{% endcomment %}

<style>
.card-badges {
  position: absolute;
  top: 8px;
  left: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  z-index: 2;
}

.card-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 600;
  border-radius: 0;
  white-space: nowrap;
}

.card-badge--in-stock {
  background-color: #5E7A5E;
  color: #fff;
}

.card-badge--backorder {
  background-color: #8A8A7A;
  color: #fff;
}

.card-badge--popular {
  background-color: #C4956A;
  color: #fff;
}

.card-badge--new {
  background-color: #292724;
  color: #fff;
}

.card-badge--low-stock {
  background-color: #D4804A;
  color: #fff;
}

.card-badge--sold-out {
  background-color: #6B6B5E;
  color: #fff;
}

.card-badge__icon {
  width: 10px;
  height: 10px;
}

.card-badge__icon svg {
  width: 100%;
  height: 100%;
}
</style>

{%- if template.name == 'collection' -%}
  {%- comment -%}コレクションページではランキングバッジのみ表示{%- endcomment -%}
{%- else -%}
{%- liquid
  assign is_in_stock = false
  assign is_made_to_order = false
  assign is_popular = false
  assign is_new = false
  assign is_low_stock = false
  
  # 新着判定（30日以内）
  assign now = 'now' | date: '%s'
  assign product_date = product.created_at | date: '%s'
  assign diff_seconds = now | minus: product_date
  assign thirty_days = 2592000
  if diff_seconds < thirty_days
    assign is_new = true
  endif
  
  # タグから判定
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower == '即納' or tag_lower == 'in-stock' or tag_lower == 'in_stock'
      assign is_in_stock = true
    endif
    if tag_lower == '受注生産' or tag_lower == 'made-to-order' or tag_lower == 'made_to_order'
      assign is_made_to_order = true
    endif
    if tag_lower == '人気' or tag_lower == 'popular' or tag_lower == 'bestseller'
      assign is_popular = true
    endif
    if tag_lower == '残りわずか' or tag_lower == 'low-stock' or tag_lower == 'limited'
      assign is_low_stock = true
    endif
  endfor
  
  # コレクションから判定
  for collection in product.collections
    if collection.handle == '即納商品' or collection.handle == 'in-stock'
      assign is_in_stock = true
    endif
    if collection.handle == 'pick-up' or collection.handle == 'bestsellers'
      assign is_popular = true
    endif
  endfor
  
  # 在庫数から判定（タグがない場合）
  if is_in_stock == false and is_made_to_order == false
    if product.available
      assign total_inventory = 0
      for variant in product.variants
        if variant.inventory_quantity > 0
          assign total_inventory = total_inventory | plus: variant.inventory_quantity
        endif
      endfor
      if total_inventory > 0
        assign is_in_stock = true
        if total_inventory <= 3
          assign is_low_stock = true
        endif
      else
        assign is_made_to_order = true
      endif
    endif
  endif
  
  # バッジ表示数をカウント（最大2つまで）
  assign badge_count = 0
-%}

{%- endif -%}
{% if product.available == false %}
  <div class="card-badges">
    <span class="card-badge card-badge--sold-out">SOLD OUT</span>
  </div>
{% else %}
  <div class="card-badges">
    
    {%- comment -%} セールバッジ {%- endcomment -%}
    {% if product.compare_at_price > product.price and badge_count < 2 %}
      <span class="card-badge card-badge--sale">セール</span>
      {% assign badge_count = badge_count | plus: 1 %}
    {% endif %}

    {%- comment -%} 人気バッジ（優先） {%- endcomment -%}
    {% if is_popular and badge_count < 2 %}
      <span class="card-badge card-badge--popular">
        <span class="card-badge__icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </span>
        人気
      </span>
      {% assign badge_count = badge_count | plus: 1 %}
    {% endif %}
    
    {%- comment -%} NEWバッジ {%- endcomment -%}
    {% if is_new and is_popular == false and badge_count < 2 %}
      <span class="card-badge card-badge--new">NEW</span>
      {% assign badge_count = badge_count | plus: 1 %}
    {% endif %}
    
    {%- comment -%} 在庫ステータス {%- endcomment -%}
    {% if badge_count < 2 %}
      {% if is_low_stock %}
        <span class="card-badge card-badge--low-stock">残りわずか</span>
      {% elsif is_in_stock %}
        <span class="card-badge card-badge--in-stock">
          <span class="card-badge__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
          即納
        </span>
      {% comment %}受注生産は非表示{% endcomment %}{% elsif is_made_to_order and false %}
        <span class="card-badge card-badge--backorder">受注生産</span>
      {% endif %}
    {% endif %}
    
  </div>
{% endif %}
